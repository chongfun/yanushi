<%= form_with(model: [@property, tax_profile], url: (tax_profile.persisted? ? property_tax_profile_path(@property, tax_profile) : property_tax_profiles_path(@property)), data: { controller: "tax-profile-form" }, class: "space-y-4") do |f| %>
  <% if tax_profile.errors.any? %>
    <div class="yn-alert yn-alert-danger" role="alert">
      <div>
        <h3 class="font-bold text-sm">Please correct the following errors:</h3>
        <ul class="list-disc list-inside text-sm mt-1">
          <% tax_profile.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <% if tax_profile.persisted? %>
    <div>
      <span class="yn-label">Tax year</span>
      <div class="text-sm font-medium tabular-nums px-3 py-1.5 bg-stone-100 rounded border border-stone-200 text-stone-900 inline-block">
        <%= tax_profile.tax_year %>
      </div>
      <p class="yn-hint">Tax year is immutable once configured.</p>
    </div>
  <% else %>
    <div>
      <%= f.label :tax_year, "Tax year", class: "yn-label" %>
      <%= f.number_field :tax_year, class: "yn-input tabular-nums", min: TaxReporting::TaxYear::MIN_YEAR, max: TaxReporting::TaxYear::MAX_YEAR, required: true %>
      <p class="yn-hint">Tax classifications are configured independently per calendar year.</p>
    </div>
  <% end %>

  <div>
    <%= f.label :schedule_e_property_type, "IRS Schedule E property type (Box 1b)", class: "yn-label" %>
    <%= f.select :schedule_e_property_type,
                 [
                   ["1 — Single-Family Residence", "single_family_residence"],
                   ["2 — Multi-Family Residence", "multi_family_residence"],
                   ["3 — Vacation / Short-Term Rental", "vacation_short_term_rental"],
                   ["4 — Commercial", "commercial"],
                   ["5 — Land", "land"],
                   ["7 — Self-Rental", "self_rental"],
                   ["8 — Other", "other"]
                 ],
                 { include_blank: "Choose Schedule E property type..." },
                 class: "yn-select",
                 required: true,
                 data: { tax_profile_form_target: "typeSelect", action: "change->tax-profile-form#typeChanged" } %>
  </div>

  <div class="<%= 'hidden' unless tax_profile.other? %>" data-tax-profile-form-target="otherContainer">
    <%= f.label :other_description, "Description for other type", class: "yn-label" %>
    <%= f.text_field :other_description,
                     placeholder: "e.g. Storage units, Boat slip, Parking garage",
                     class: "yn-input",
                     data: { tax_profile_form_target: "otherInput" } %>
    <p class="yn-hint">Required when '8 — Other' is selected.</p>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit (tax_profile.persisted? ? "Save tax profile" : "Create tax profile"), class: "yn-btn yn-btn-primary" %>
    <%= link_to "Cancel", schedule_e_property_path(@property, year: tax_profile.tax_year), class: "yn-btn yn-btn-secondary" %>
  </div>
<% end %>
