<div class="max-w-2xl mx-auto py-6">
  <div class="mb-6">
    <%= link_to "← Back to Schedule E", schedule_e_property_path(@property, year: @tax_profile.tax_year), class: "yn-btn yn-btn-ghost yn-btn-sm mb-2" %>
    <h1 class="text-2xl font-bold tracking-tight text-stone-900">Configure Tax Profile (<%= @tax_profile.tax_year %>)</h1>
    <p class="text-sm text-stone-500"><%= @property.address %></p>
  </div>

  <div class="bg-white border border-stone-200 rounded-lg p-6">
    <%= render "form", tax_profile: @tax_profile %>
  </div>
</div>
