<% content_for :title, "Tenancies" %>

<div class="max-w-5xl">
  <%= render "portfolio/header", current_tab: :tenancies %>

  <% if @tenancies.any? %>
    <div class="overflow-x-auto">
      <table class="yn-table">
        <thead>
          <tr>
            <th scope="col">Property / Unit</th>
            <th scope="col">Agreement</th>
            <th scope="col">Period</th>
            <th scope="col">Tenants</th>
            <th scope="col" class="text-right tabular-nums">Current rent</th>
            <th scope="col" class="text-right tabular-nums">Balance</th>
          </tr>
        </thead>
        <tbody id="tenancies">
          <% @tenancies.each do |tenancy| %>
            <%
              tenant_names = tenancy.all_tenant_parties.map(&:display_name).presence ||
                             tenancy.tenancy_parties.filter_map { |tp| tp.party&.display_name }.presence
              rent_term = tenancy.primary_rent_term
              balance_cents = @balances[tenancy.id] || 0
            %>
            <tr id="<%= dom_id tenancy %>">
              <td>
                <%= link_to tenancy_path(tenancy), class: "yn-row-link" do %>
                  <%= tenancy.rentable_unit.property.address %>
                <% end %>
                <span class="block text-[13px] text-stone-500"><%= tenancy.rentable_unit.display_name %></span>
              </td>
              <td><%= tenancy.agreement_type.humanize %></td>
              <td class="text-stone-500 whitespace-nowrap text-sm">
                <%= tenancy.commencement_date.strftime("%b %d, %Y") %>
                <% if tenancy.termination_date %>
                  – <%= tenancy.termination_date.strftime("%b %d, %Y") %>
                <% else %>
                  (Month-to-Month)
                <% end %>
              </td>
              <td><%= tenant_names ? tenant_names.to_sentence : "—" %></td>
              <td class="text-right tabular-nums whitespace-nowrap">
                <%= rent_term ? "#{format_money_cents(rent_term.amount_cents)}/mo" : "—" %>
              </td>
              <td class="text-right tabular-nums whitespace-nowrap <%= balance_cents.positive? ? 'text-stone-900 font-medium' : 'text-stone-500' %>">
                <% if balance_cents.zero? %>
                  <span class="text-stone-400" aria-hidden="true">—</span><span class="sr-only">Settled</span>
                <% else %>
                  <%= balance_phrase_cents(balance_cents) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "shared/pagination",
          page: @page, per_page: @per_page, total_count: @total_count, total_pages: @total_pages,
          page_url: ->(p) { tenancies_path(page: p) } %>
  <% else %>
    <%= render "shared/empty_state",
          title: "No tenancies yet",
          body: "A tenancy records who occupies a unit, what rent is due, and what they owe. Start one from a vacant unit on a property, or create one here.",
          action: link_to("Create a tenancy", new_tenancy_path, class: "yn-btn yn-btn-primary yn-btn-sm") %>
  <% end %>
</div>
