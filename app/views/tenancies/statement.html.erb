<%
  view_mode = @view_mode
  tab_items = [
    { label: "Tenant account", path: statement_tenancy_path(@tenancy, from: params[:from], through: params[:through], year: params[:year]), current: view_mode == "receivable" },
    { label: "All financial activity", path: statement_tenancy_path(@tenancy, view: "all", from: params[:from], through: params[:through], year: params[:year]), current: view_mode == "all" }
  ]
%>
<% content_for :title, "Tenant account statement" %>

<div class="max-w-5xl">
  <%= render "tenancies/page_header",
        tenancy: @tenancy,
        title: "Tenant account statement",
        actions: link_to("Record receipt", new_tenancy_receipt_path(@tenancy), class: "yn-btn yn-btn-primary") %>

  <%= render "shared/tabs", items: tab_items, aria_label: "Statement views" %>

  <!-- GET filters -->
  <%= form_with url: statement_tenancy_path(@tenancy), method: :get, data: { controller: "date-range-filter" }, class: "flex flex-wrap items-end gap-3 mt-6 mb-6" do |f| %>
    <%= f.hidden_field :view, value: view_mode if view_mode == "all" %>
    <div>
      <%= f.label :year, "Year", class: "yn-label", for: "stmt-year" %>
      <%= f.select :year,
            options_for_select(Accounting::ActiveYearsQuery.call(property: @tenancy.property, additional_years: [@date_range.year].compact), @date_range.year),
            { include_blank: "Custom Range" },
            class: "yn-select w-32", id: "stmt-year",
            data: { date_range_filter_target: "yearSelect", action: "change->date-range-filter#yearChanged" } %>
    </div>
    <div>
      <%= f.label :from, "From", class: "yn-label", for: "stmt-from" %>
      <%= f.date_field :from, value: (@date_range.year ? nil : @date_range.from), class: "yn-input w-40", id: "stmt-from",
            data: { date_range_filter_target: "fromInput", action: "input->date-range-filter#dateChanged" } %>
    </div>
    <div>
      <%= f.label :through, "Through", class: "yn-label", for: "stmt-through" %>
      <%= f.date_field :through, value: (@date_range.year ? nil : @date_range.through), class: "yn-input w-40", id: "stmt-through",
            data: { date_range_filter_target: "throughInput", action: "input->date-range-filter#dateChanged" } %>
    </div>
    <%= f.submit "Apply", class: "yn-btn yn-btn-secondary" %>
  <% end %>

  <% if @date_range.valid? %>
    <% if view_mode == "receivable" %>
      <%
        opening_cents = @statement.opening_balance_cents
        closing_cents = @statement.closing_balance_cents
        from_label = @date_range.from&.strftime("%b %-d, %Y") || "the first entry"
        as_of_label = (@date_range.through || Date.current).strftime("%b %-d, %Y")
      %>
      <dl class="grid grid-cols-2 gap-x-8 gap-y-4 border-y border-stone-200 py-4 mb-6 max-w-xl">
        <div>
          <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Opening Balance</dt>
          <dd class="mt-0.5 text-lg font-semibold tabular-nums m-0"><%= balance_phrase_cents(opening_cents) %></dd>
          <dd class="text-xs text-stone-500 m-0">
            <% if opening_cents.positive? %>
              Amount owed prior to <%= from_label %>
            <% elsif opening_cents.negative? %>
              Credit balance prior to <%= from_label %>
            <% else %>
              Nothing owed prior to <%= from_label %>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Closing Balance</dt>
          <dd class="mt-0.5 text-lg font-semibold tabular-nums m-0"><%= balance_phrase_cents(closing_cents) %></dd>
          <dd class="text-xs text-stone-500 m-0">
            <% if closing_cents.positive? %>
              Amount owed as of <%= as_of_label %>
            <% elsif closing_cents.negative? %>
              Tenant credit as of <%= as_of_label %>
            <% else %>
              Paid in full as of <%= as_of_label %>
            <% end %>
          </dd>
        </div>
      </dl>

      <% if @statement.rows.any? %>
        <div class="overflow-x-auto">
          <table class="yn-table">
            <thead>
              <tr>
                <th scope="col">Date</th>
                <th scope="col">Activity</th>
                <th scope="col" class="text-right tabular-nums">Amount</th>
                <th scope="col" class="text-right tabular-nums">Balance</th>
                <th scope="col"><span class="sr-only">Audit</span></th>
              </tr>
            </thead>
            <tbody>
              <%= render partial: "tenancies/activity_row", collection: @statement.rows, as: :row %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-stone-500 m-0">No account activity in this period.</p>
      <% end %>
    <% else %>
      <% if @financial_activity.any? %>
        <div class="overflow-x-auto">
          <table class="yn-table">
            <thead>
              <tr>
                <th scope="col">Date</th>
                <th scope="col">Event</th>
                <th scope="col">Participant</th>
                <th scope="col" class="text-right tabular-nums">Amount</th>
                <th scope="col"><span class="sr-only">Audit</span></th>
              </tr>
            </thead>
            <tbody>
              <%= render partial: "accounting/activity_row", collection: @financial_activity, as: :row, locals: { context: :party, audit: true } %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-stone-500 m-0">No financial activity in this period.</p>
      <% end %>
    <% end %>
  <% else %>
    <div class="yn-alert yn-alert-warn" role="alert">
      <span>Unable to generate financial report: <%= @date_range.errors.to_sentence.presence || "the From date cannot be after the Through date" %>. Adjust the dates above.</span>
    </div>
  <% end %>
</div>
