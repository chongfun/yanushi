<% content_for :title, "Editing Tenancy ##{@tenancy.id}" %>

<% content_for :breadcrumbs do %>
  <li><%= link_to "Tenancies", tenancies_path %></li>
  <li><%= link_to "Tenancy ##{@tenancy.id}", @tenancy %></li>
  <li class="font-bold">Edit Details</li>
<% end %>

<div class="max-w-2xl mx-auto py-8">
  <div class="card bg-base-100 shadow-xl border border-base-200">
    <div class="card-body">
      <h2 class="card-title text-2xl font-bold mb-6">Editing Tenancy ##{@tenancy.id}</h2>

      <%= render "form", tenancy: @tenancy %>
    </div>
  </div>
</div>
