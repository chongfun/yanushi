<div id="tenancy_actions" class="flex items-center gap-2">
  <details class="relative" data-controller="menu">
    <summary class="yn-btn yn-btn-secondary list-none cursor-pointer">
      More
      <svg viewBox="0 0 16 16" class="w-3.5 h-3.5" fill="currentColor" aria-hidden="true"><path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z"/></svg>
    </summary>
    <div class="yn-menu">
      <% unless tenancy.past? %>
        <%= link_to "Change rent", new_tenancy_rent_term_path(tenancy), class: "yn-menu-item" %>
      <% end %>
      <%= link_to "Manage security deposit", tenancy_security_deposit_path(tenancy), class: "yn-menu-item" %>
      <%= link_to "Edit agreement", edit_tenancy_path(tenancy), class: "yn-menu-item" %>
      <%= link_to "Manage participants", tenancy_agreement_path(tenancy), class: "yn-menu-item" %>
      <hr class="yn-menu-separator">
      <% if tenancy.active? || tenancy.upcoming? %>
        <%= link_to "End tenancy…", edit_tenancy_path(tenancy), class: "yn-menu-item yn-menu-item-danger" %>
      <% end %>
      <div id="tenancy_delete_action">
        <% if tenancy.deletable? %>
          <%= button_to "Delete tenancy…", tenancy_path(tenancy), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this tenancy?" }, class: "yn-menu-item yn-menu-item-danger" %>
        <% end %>
      </div>
    </div>
  </details>
  <% if tenancy.active? %>
    <%= link_to "Add charge", new_tenancy_charge_path(tenancy), data: { turbo_frame: "modal-frame", turbo_prefetch: false }, class: "yn-btn yn-btn-secondary" %>
  <% end %>
  <% if tenancy.active? || tenancy.current_balance_cents > 0 %>
    <%= link_to "Record receipt", new_tenancy_receipt_path(tenancy), data: { turbo_frame: "modal-frame", turbo_prefetch: false }, class: "yn-btn yn-btn-primary" %>
  <% end %>
</div>
