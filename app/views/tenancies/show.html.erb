<% content_for :title, "Tenancy ##{@tenancy.id}" %>

<% content_for :breadcrumbs do %>
  <li><%= link_to "Tenancies", tenancies_path %></li>
  <li class="font-bold">Tenancy #<%= @tenancy.id %></li>
<% end %>

<div class="max-w-5xl mx-auto py-8">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold">Tenancy Agreement</h1>
      <p class="text-base-content/60"><%= @tenancy.property.address %> — <%= @tenancy.rentable_unit.display_name %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Back to List", tenancies_path, class: "btn btn-ghost" %>
      <%= link_to "Edit Details", edit_tenancy_path(@tenancy), class: "btn btn-outline" %>
      <%= link_to "View Property", property_path(@tenancy.property), class: "btn btn-outline btn-secondary" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Details & Participants -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Tenancy Info Card -->
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body">
          <h2 class="card-title text-xl mb-4">Agreement Details</h2>
          
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div>
              <div class="text-xs font-semibold text-base-content/50 uppercase tracking-wider mb-1">Agreement Type</div>
              <div class="font-medium"><%= @tenancy.agreement_type.titleize %></div>
            </div>
            <div>
              <div class="text-xs font-semibold text-base-content/50 uppercase tracking-wider mb-1">Commencement</div>
              <div class="font-medium"><%= @tenancy.commencement_date.strftime("%B %d, %Y") %></div>
            </div>
            <div>
              <div class="text-xs font-semibold text-base-content/50 uppercase tracking-wider mb-1">Termination</div>
              <div class="font-medium"><%= @tenancy.termination_date&.strftime("%B %d, %Y") || "Month-to-Month" %></div>
            </div>
            <div>
              <div class="text-xs font-semibold text-base-content/50 uppercase tracking-wider mb-1">Late Period</div>
              <div class="font-medium"><%= @tenancy.late_period_days %> Days</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Participants Card -->
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body">
          <div class="flex justify-between items-center mb-4">
            <div>
              <h2 class="card-title text-xl font-bold">Participants</h2>
              <p class="text-xs text-base-content/60">Tenants, guarantors, and occupants with effective participation dates</p>
            </div>
            <%= link_to "＋ Add Participant", new_tenancy_tenancy_party_path(@tenancy), class: "btn btn-sm btn-primary" %>
          </div>

          <div class="overflow-x-auto">
            <table class="table table-zebra w-full">
              <thead>
                <tr>
                  <th>Participant</th>
                  <th>Role</th>
                  <th>Effective Range</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @tenancy.tenancy_parties.includes(:party).each do |tp| %>
                  <tr>
                    <td>
                      <div class="font-bold"><%= link_to tp.party.display_name, tp.party, class: "link link-hover" %></div>
                      <div class="text-xs text-base-content/50"><%= tp.party.email_address || tp.party.phone_number %></div>
                    </td>
                    <td>
                      <span class="badge <%= tp.tenant? ? 'badge-primary' : 'badge-ghost' %> badge-sm">
                        <%= tp.role.titleize %>
                      </span>
                    </td>
                    <td class="text-sm">
                      <%= tp.effective_from.strftime("%b %d, %Y") %>
                      <% if tp.effective_until.present? %>
                        to <%= tp.effective_until.strftime("%b %d, %Y") %>
                      <% else %>
                        <span class="text-base-content/50">(Current)</span>
                      <% end %>
                    </td>
                    <td class="text-right space-x-1">
                      <%= link_to "Edit", edit_tenancy_tenancy_party_path(@tenancy, tp), class: "btn btn-ghost btn-xs" %>
                      <%= button_to "Remove", [@tenancy, tp], method: :delete, class: "btn btn-ghost btn-xs text-error", form: { data: { turbo_confirm: "Are you sure you want to remove this participant?" } } %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Rent Terms & History Card -->
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body">
          <div class="flex justify-between items-center mb-4">
            <div>
              <h2 class="card-title text-xl font-bold">Rent Terms History</h2>
              <p class="text-xs text-base-content/60">Effective-dated rental amounts and due schedule</p>
            </div>
            <%= link_to "＋ Change Rent", new_tenancy_rent_term_path(@tenancy), class: "btn btn-sm btn-accent" %>
          </div>

          <div class="overflow-x-auto">
            <table class="table table-zebra w-full">
              <thead>
                <tr>
                  <th>Monthly Rent</th>
                  <th>Due Day</th>
                  <th>Frequency</th>
                  <th>Effective Period</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% @tenancy.rent_terms.order(effective_from: :desc).each do |term| %>
                  <tr>
                    <td class="font-mono font-bold text-base"><%= number_to_currency(term.amount_cents / 100.0) %></td>
                    <td>Day <%= term.due_day %></td>
                    <td><%= term.frequency.titleize %></td>
                    <td class="text-sm">
                      <%= term.effective_from.strftime("%b %d, %Y") %>
                      <% if term.effective_until.present? %>
                        to <%= term.effective_until.strftime("%b %d, %Y") %>
                      <% else %>
                        onward
                      <% end %>
                    </td>
                    <td>
                      <% if term.active? %>
                        <span class="badge badge-success badge-sm">Current</span>
                      <% elsif term.effective_from > Date.current %>
                        <span class="badge badge-info badge-sm">Upcoming</span>
                      <% else %>
                        <span class="badge badge-ghost badge-sm">Past</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Charges Card -->
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body">
          <div class="flex justify-between items-center mb-4">
            <div>
              <h2 class="card-title text-xl font-bold">Charges & Obligations</h2>
              <p class="text-xs text-base-content/60">Rent, late fees, utilities, and reimbursement charges posted to ledger</p>
            </div>
            <%= link_to "＋ Add Charge", new_tenancy_charge_path(@tenancy), class: "btn btn-sm btn-primary" %>
          </div>

          <div class="overflow-x-auto">
            <table class="table table-zebra w-full">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Type</th>
                  <th>Period / Memo</th>
                  <th class="text-right">Amount</th>
                  <th>Status</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% charges = @tenancy.charges.order(charge_date: :desc, created_at: :desc) %>
                <% if charges.any? %>
                  <%= render partial: "charges/charge", collection: charges %>
                <% else %>
                  <tr>
                    <td colspan="6" class="text-center py-6 text-base-content/60">
                      No charges recorded yet.
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Recent Account Activity Card -->
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body">
          <div class="flex justify-between items-center mb-4">
            <div>
              <h2 class="card-title text-xl font-bold">Recent Account Activity</h2>
              <p class="text-xs text-base-content/60">Chronological tenant receivable ledger activity and running balance</p>
            </div>
            <div class="flex items-center gap-2">
              <%= link_to "Financial Activity", statement_tenancy_path(@tenancy, view: "all"), class: "btn btn-sm btn-outline btn-secondary" %>
              <%= link_to "View Statement", statement_tenancy_path(@tenancy), class: "btn btn-sm btn-outline btn-info" %>
            </div>

          <div class="overflow-x-auto">
            <table class="table table-zebra w-full">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Type</th>
                  <th>Description</th>
                  <th class="text-right">Amount</th>
                  <th class="text-right">Running Balance</th>
                </tr>
              </thead>
              <tbody>
                <% if @recent_activity_rows.blank? %>
                  <tr>
                    <td colspan="5" class="text-center py-6 text-base-content/60">
                      No account activity recorded yet.
                    </td>
                  </tr>
                <% else %>
                  <% @recent_activity_rows.each do |row| %>
                    <tr class="<%= 'opacity-60 bg-base-200/40' if row.corrected? || row.voided? %>">
                      <td class="text-sm"><%= row.occurred_on.strftime("%b %d, %Y") %></td>
                      <td>
                        <% if row.reversal %>
                          <% if row.kind == 'waiver' %>
                            <span class="badge badge-neutral text-xs">Waiver</span>
                          <% else %>
                            <span class="badge badge-warning text-xs">Correction</span>
                          <% end %>
                        <% elsif row.kind == "rent" || row.kind == "late_fee" || row.kind == "reimbursement" || row.kind == "other" %>
                          <span class="badge badge-info text-xs"><%= row.label %></span>
                        <% elsif row.kind == "payment" %>
                          <span class="badge badge-success text-xs text-success-content">Payment</span>
                        <% elsif row.kind == "deposit_applied" %>
                          <span class="badge badge-secondary text-xs">Deposit Applied</span>
                        <% else %>
                          <span class="badge badge-ghost text-xs"><%= row.label %></span>
                        <% end %>
                      </td>
                      <td class="text-sm">
                        <%= row.description %>
                        <% if row.lifecycle_status == :corrected %>
                          <span class="badge badge-warning badge-xs ml-2">Corrected</span>
                        <% elsif row.lifecycle_status == :voided %>
                          <span class="badge badge-neutral badge-xs ml-2">Waived</span>
                        <% end %>
                      </td>
                      <td class="text-right font-mono font-medium text-sm">
                        <% if row.amount_cents.positive? %>
                          <span class="text-error">+<%= number_to_currency(row.amount_cents / 100.0) %></span>
                        <% elsif row.amount_cents.negative? %>
                          <span class="text-success">-<%= number_to_currency(row.amount_cents.abs / 100.0) %></span>
                        <% else %>
                          $0.00
                        <% end %>
                      </td>
                      <td class="text-right font-mono font-bold text-sm <%= row.running_balance_cents > 0 ? 'text-error' : 'text-success' %>">
                        <%= row.running_balance_cents < 0 ? '-' : '' %><%= number_to_currency(row.running_balance_cents.abs / 100.0) %>
                      </td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Payments & Receipts Card -->
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body">
          <div class="flex justify-between items-center mb-4">
            <div>
              <h2 class="card-title text-xl font-bold">Payments & Receipts</h2>
              <p class="text-xs text-base-content/60">Payments received and applied to tenancy receivable</p>
            </div>
            <%= link_to "＋ Record Payment", new_tenancy_receipt_path(@tenancy), class: "btn btn-sm btn-primary" %>
          </div>

          <div class="overflow-x-auto">
            <table class="table table-zebra w-full">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Payer</th>
                  <th>Method</th>
                  <th>Reference</th>
                  <th class="text-right">Amount</th>
                  <th>Status</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% receipts = @tenancy.receipts.order(received_on: :desc, created_at: :desc) %>
                <% if receipts.any? %>
                  <% receipts.each do |receipt| %>
                    <tr class="<%= 'opacity-60 bg-base-200/50' if receipt.voided? %>">
                      <td class="text-sm"><%= receipt.received_on.strftime("%b %d, %Y") %></td>
                      <td class="font-medium text-sm"><%= receipt.payer_party&.display_name %></td>
                      <td><span class="badge badge-ghost badge-sm"><%= receipt.payment_method.titleize %></span></td>
                      <td class="text-xs font-mono"><%= receipt.external_reference || "—" %></td>
                      <td class="font-mono font-bold text-right <%= receipt.voided? ? 'line-through text-base-content/50' : 'text-success' %>">
                        <%= number_to_currency(receipt.amount) %>
                      </td>
                      <td>
                        <% if receipt.voided? && receipt.superseded? %>
                          <span class="badge badge-warning badge-sm">Corrected</span>
                        <% elsif receipt.voided? %>
                          <span class="badge badge-error badge-sm">Voided</span>
                        <% elsif receipt.superseded_receipt.present? %>
                          <span class="badge badge-info badge-sm">Replacement</span>
                        <% else %>
                          <span class="badge badge-success badge-sm">Active</span>
                        <% end %>
                      </td>
                      <td class="text-right space-x-1">
                        <%= link_to "View", receipt_path(receipt), class: "btn btn-xs btn-ghost" %>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="7" class="text-center py-6 text-base-content/60">
                      No payments recorded yet.
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden">
        <div class="card-body p-0">
          <div class="bg-error/10 p-6 flex justify-between items-center">
            <div>
              <h4 class="font-bold text-error">Danger Zone</h4>
              <p class="text-xs text-error/80">Deleting a tenancy will remove associated records.</p>
            </div>
            <%= button_to "Delete Tenancy Record", @tenancy, method: :delete, 
                class: "btn btn-error btn-sm", 
                form: { data: { turbo_confirm: "Are you sure you want to delete this tenancy? All associated data will be removed." } } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar Financial Summary -->
    <div class="space-y-6">
      <div class="card bg-primary text-primary-content shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-lg opacity-80">Current Rent</h2>
          <% current_term = @tenancy.current_rent_term %>
          <div class="mt-4 space-y-4">
            <div>
              <div class="text-xs uppercase font-bold opacity-70">Monthly Amount</div>
              <div class="text-3xl font-black">
                <%= current_term ? number_to_currency(current_term.amount_cents / 100.0) : "—" %>
              </div>
            </div>
            <% if current_term %>
              <div>
                <div class="text-xs uppercase font-bold opacity-70">Payment Due</div>
                <div class="text-base font-medium">Day <%= current_term.due_day %> of each month</div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body">
          <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Account Balance</div>
          <% balance = @tenancy.current_balance %>
          <% text_class = if balance > 0 then 'text-error' elsif balance < 0 then 'text-success' else 'text-base-content/70' end %>
          <% sub_text = if balance > 0 then 'Tenancy owes outstanding balance' elsif balance < 0 then 'Account has credit balance' else 'Account is settled ($0.00)' end %>
          <div class="text-3xl font-black <%= text_class %>">
            <%= balance < 0 ? '-' : '' %><%= number_to_currency(balance.abs) %>
          </div>
          <div class="text-xs text-base-content/50 mt-1">
            <%= sub_text %>
          </div>
          <div class="divider my-3"></div>
          <div class="space-y-2">
            <%= link_to "📄 View Full Statement", statement_tenancy_path(@tenancy), class: "btn btn-outline btn-info btn-sm w-full" %>
            <%= link_to "＋ Record Payment", new_tenancy_receipt_path(@tenancy), class: "btn btn-primary btn-sm w-full" %>
            <%= link_to "＋ Add Charge", new_tenancy_charge_path(@tenancy), class: "btn btn-outline btn-sm w-full" %>
          </div>
        </div>
      </div>

      <!-- Security Deposit Card -->
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body">
          <div class="flex justify-between items-center mb-1">
            <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider">Security Deposit</div>
            <% if @tenancy.security_deposit %>
              <% case @tenancy.security_deposit.funding_status %>
              <% when "funded" %>
                <span class="badge badge-success badge-xs">Funded</span>
              <% when "partially_funded" %>
                <span class="badge badge-warning badge-xs">Partial</span>
              <% when "overfunded" %>
                <span class="badge badge-info badge-xs">Overfunded</span>
              <% else %>
                <span class="badge badge-error badge-xs">Not Funded</span>
              <% end %>
            <% end %>
          </div>

          <% if @tenancy.security_deposit %>
            <% dep = @tenancy.security_deposit %>
            <div class="text-3xl font-black font-mono text-primary">
              <%= number_to_currency(dep.held_amount) %>
            </div>
            <div class="text-xs text-base-content/60 mt-1 space-y-1">
              <div>Required: <span class="font-medium text-base-content"><%= number_to_currency(dep.required_amount) %></span></div>
              <% if dep.remaining_required_amount > 0 %>
                <div>Remaining: <span class="font-medium text-warning"><%= number_to_currency(dep.remaining_required_amount) %></span></div>
              <% end %>
            </div>
            <div class="divider my-3"></div>
            <%= link_to "Manage Security Deposit", tenancy_security_deposit_path(@tenancy), class: "btn btn-outline btn-secondary btn-sm w-full" %>
          <% else %>
            <p class="text-xs text-base-content/60 my-2">No security deposit requirement recorded for this tenancy.</p>
            <%= link_to "＋ Set Up Security Deposit", new_tenancy_security_deposit_path(@tenancy), class: "btn btn-outline btn-sm w-full" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
