<%
  primary_names = @tenancy.primary_tenant_parties.map(&:display_name).to_sentence
  page_title = primary_names.present? ? "#{primary_names} · #{@tenancy.rentable_unit.display_name}" : "Tenancy ##{@tenancy.id} · #{@tenancy.rentable_unit.display_name}"
  content_for :title, page_title
%>

<div class="max-w-5xl">
  <%= render "tenancies/header", current_tab: :activity %>

  <!-- Balance + deposit summary row -->
  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4 mb-8">
    <%= render "tenancies/balance", balance_cents: @balance_cents %>
    <%= render "tenancies/security_deposit_summary", security_deposit_held_cents: @security_deposit_held_cents %>
  </div>

  <%= render "tenancies/activity" %>
</div>
