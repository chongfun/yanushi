<%= form_with(model: tenancy, class: "space-y-6") do |form| %>
  <% if tenancy.errors.any? %>
    <div class="yn-alert yn-alert-danger" role="alert">
      <div>
        <h3 class="font-bold text-sm"><%= pluralize(tenancy.errors.count, "error") %> prohibited this tenancy from being saved:</h3>
        <ul class="list-disc pl-5 mt-1 text-sm">
          <% tenancy.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <% if tenancy.new_record? %>
    <!-- Property & Unit Selection -->
    <div class="bg-white border border-stone-200 rounded-lg p-6">
      <h3 class="font-bold text-base text-stone-900 border-b border-stone-200 pb-3 mb-4">Property & Rentable Unit</h3>
      
      <div>
        <%= form.label :rentable_unit_id, "Rentable unit", class: "yn-label" %>
        <select name="tenancy[rentable_unit_id]" id="tenancy_rentable_unit_id" class="yn-select" required>
          <option value="">-- Choose a Unit --</option>
          <% @properties.each do |property| %>
            <optgroup label="<%= property.address %>">
              <% property.rentable_units.select(&:active?).each do |unit| %>
                <option value="<%= unit.id %>" <%= 'selected' if tenancy.rentable_unit_id == unit.id %>>
                  <%= unit.name %> <%= "(#{unit.unit_identifier})" if unit.unit_identifier.present? %>
                </option>
              <% end %>
            </optgroup>
          <% end %>
        </select>
      </div>
    </div>

    <!-- Tenants & Participants Selection -->
    <div class="bg-white border border-stone-200 rounded-lg p-6">
      <h3 class="font-bold text-base text-stone-900 border-b border-stone-200 pb-3 mb-2">Tenants & Payers</h3>
      <p class="text-xs text-stone-500 mb-4">Select at least one tenant who is financially and legally responsible for this agreement.</p>

      <div class="space-y-2 max-h-60 overflow-y-auto p-2 bg-stone-50 rounded-lg border border-stone-200">
        <% if @parties.empty? %>
          <div class="text-sm text-stone-500 p-2">
            No tenants or payers registered yet. <%= link_to "Create a Party first", new_party_path, class: "yn-link font-semibold", target: "_blank" %>.
          </div>
        <% else %>
          <% @parties.each do |party| %>
            <label class="flex items-center gap-3 bg-white p-2.5 rounded border border-stone-200 hover:bg-stone-50 cursor-pointer select-none">
              <input type="checkbox" name="tenancy[party_ids][]" value="<%= party.id %>" class="rounded border-stone-300 text-stone-900 focus:ring-stone-400" <%= 'checked' if tenancy.parties.include?(party) %> />
              <div>
                <span class="text-sm font-bold text-stone-900"><%= party.display_name %></span>
                <span class="text-xs text-stone-500 ml-2">(<%= party.party_type.titleize %><%= " — #{party.email_address}" if party.email_address.present? %>)</span>
              </div>
            </label>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Agreement Terms -->
  <div class="bg-white border border-stone-200 rounded-lg p-6">
    <h3 class="font-bold text-base text-stone-900 border-b border-stone-200 pb-3 mb-4">Agreement Details</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :agreement_type, "Agreement type", class: "yn-label" %>
        <%= form.select :agreement_type, Tenancy::AGREEMENT_TYPES.map { |k| [k.titleize, k] }, {}, { class: "yn-select", required: true } %>
      </div>

      <div>
        <%= form.label :late_period_days, "Grace period (days)", class: "yn-label" %>
        <%= form.number_field :late_period_days, class: "yn-input tabular-nums", min: 0 %>
      </div>

      <% if tenancy.new_record? %>
        <div>
          <%= form.label :commencement_date, "Commencement date", class: "yn-label" %>
          <%= form.date_field :commencement_date, class: "yn-input", required: true %>
        </div>
      <% end %>

      <div>
        <%= form.label :termination_date, "Termination date (leave blank for month-to-month)", class: "yn-label" %>
        <%= form.date_field :termination_date, class: "yn-input" %>
      </div>
    </div>
  </div>

  <% if tenancy.new_record? %>
    <!-- Initial Rent Terms -->
    <div class="bg-white border border-stone-200 rounded-lg p-6">
      <h3 class="font-bold text-base text-stone-900 border-b border-stone-200 pb-3 mb-4">Initial Rent Terms</h3>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="yn-label" for="tenancy_rent_amount">Monthly rent</label>
          <input type="number" name="tenancy[rent_amount]" id="tenancy_rent_amount" step="0.01" min="0" placeholder="2000.00" class="yn-input tabular-nums" required />
        </div>

        <div>
          <label class="yn-label" for="tenancy_due_day">Due day of month</label>
          <input type="number" name="tenancy[due_day]" id="tenancy_due_day" min="1" max="31" value="1" class="yn-input tabular-nums" required />
        </div>

        <div>
          <label class="yn-label" for="tenancy_frequency">Frequency</label>
          <select name="tenancy[frequency]" id="tenancy_frequency" class="yn-select">
            <option value="monthly" selected>Monthly</option>
          </select>
        </div>
      </div>
    </div>
  <% end %>

  <div class="flex justify-end gap-3 pt-2">
    <%= link_to "Cancel", tenancies_path, class: "yn-btn yn-btn-secondary" %>
    <%= form.submit (tenancy.persisted? ? "Save agreement" : "Create tenancy"), class: "yn-btn yn-btn-primary px-8" %>
  </div>
<% end %>
