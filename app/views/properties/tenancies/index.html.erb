<div class="max-w-5xl">
  <%= render "properties/header", current_tab: :tenancies %>

  <div class="space-y-10">
    <section aria-labelledby="current-heading">
      <h2 id="current-heading" class="text-sm font-semibold mb-3">Current</h2>
      <% if @active_tenancies.any? %>
        <div class="overflow-x-auto">
          <table class="yn-table">
            <thead>
              <tr>
                <th scope="col">Unit</th>
                <th scope="col">Parties</th>
                <th scope="col">Since</th>
                <th scope="col" class="text-right tabular-nums">Rent</th>
                <th scope="col" class="text-right tabular-nums">Balance</th>
              </tr>
            </thead>
            <tbody>
              <% @active_tenancies.each do |tenancy| %>
                <%
                  active_tenants = tenancy.tenant_parties_as_of(Date.current)
                  tenant_parties = active_tenants.presence || tenancy.all_tenant_parties
                  other_parties = tenancy.non_tenant_parties_as_of(Date.current)
                  tenant_name = tenant_parties.map(&:display_name).presence
                  rent_term = tenancy.current_rent_term(Date.current)
                  balance_cents = @balances[tenancy.id] || 0
                %>
                <tr>
                  <td class="font-medium whitespace-nowrap"><%= tenancy.rentable_unit&.name || "Unit" %></td>
                  <td>
                    <%= link_to tenancy_path(tenancy), class: "yn-row-link" do %>
                      <%= tenant_name ? tenant_name.to_sentence : "No tenant assigned" %>
                    <% end %>
                    <% if other_parties.any? %>
                      <span class="text-stone-400 text-[13px]">+ <%= pluralize(other_parties.size, "other party") %></span>
                    <% end %>
                  </td>
                  <td class="text-stone-500 whitespace-nowrap"><%= tenancy.commencement_date&.strftime("%b %Y") %></td>
                  <td class="text-right tabular-nums whitespace-nowrap">
                    <%= rent_term ? "#{format_money_cents(rent_term.amount_cents)}/mo" : "—" %>
                  </td>
                  <td class="text-right tabular-nums whitespace-nowrap <%= balance_cents.positive? ? 'text-stone-900 font-medium' : 'text-stone-500' %>">
                    <% if balance_cents.zero? %>
                      <span class="text-stone-400">—</span>
                    <% else %>
                      <%= balance_phrase_cents(balance_cents) %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-stone-500 m-0">No active tenancies.</p>
      <% end %>
    </section>

    <% if @upcoming_tenancies.any? %>
      <section aria-labelledby="upcoming-heading">
        <h2 id="upcoming-heading" class="text-sm font-semibold mb-3 text-stone-700">Upcoming</h2>
        <div class="overflow-x-auto">
          <table class="yn-table">
            <thead>
              <tr>
                <th scope="col">Unit</th>
                <th scope="col">Parties</th>
                <th scope="col">Starts</th>
                <th scope="col" class="text-right tabular-nums">Rent</th>
                <th scope="col" class="text-right tabular-nums">Balance</th>
              </tr>
            </thead>
            <tbody>
              <% @upcoming_tenancies.each do |tenancy| %>
                <%
                  as_of_date = tenancy.commencement_date || Date.current
                  upcoming_tenants = tenancy.tenant_parties_as_of(as_of_date)
                  tenant_parties = upcoming_tenants.presence || tenancy.all_tenant_parties
                  other_parties = tenancy.non_tenant_parties_as_of(as_of_date)
                  tenant_name = tenant_parties.map(&:display_name).presence
                  rent_term = tenancy.current_rent_term(as_of_date)
                  balance_cents = @balances[tenancy.id] || 0
                %>
                <tr>
                  <td class="font-medium whitespace-nowrap"><%= tenancy.rentable_unit&.name || "Unit" %></td>
                  <td>
                    <%= link_to tenancy_path(tenancy), class: "yn-row-link" do %>
                      <%= tenant_name ? tenant_name.to_sentence : "Upcoming tenancy" %>
                    <% end %>
                    <% if other_parties.any? %>
                      <span class="text-stone-400 text-[13px]">+ <%= pluralize(other_parties.size, "other party") %></span>
                    <% end %>
                  </td>
                  <td class="text-stone-500 whitespace-nowrap"><%= tenancy.commencement_date&.strftime("%b %-d, %Y") %></td>
                  <td class="text-right tabular-nums whitespace-nowrap">
                    <%= rent_term ? "#{format_money_cents(rent_term.amount_cents)}/mo" : "—" %>
                  </td>
                  <td class="text-right tabular-nums whitespace-nowrap <%= balance_cents.positive? ? 'text-stone-900 font-medium' : 'text-stone-500' %>">
                    <% if balance_cents.zero? %>
                      <span class="text-stone-400">—</span>
                    <% else %>
                      <%= balance_phrase_cents(balance_cents) %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>

    <% if @past_tenancies.any? %>
      <section aria-labelledby="past-heading">
        <h2 id="past-heading" class="text-sm font-semibold mb-3 text-stone-500">Past</h2>
        <div class="overflow-x-auto">
          <table class="yn-table">
            <thead>
              <tr>
                <th scope="col">Unit</th>
                <th scope="col">Parties</th>
                <th scope="col">Period</th>
                <th scope="col" class="text-right tabular-nums">Final balance</th>
              </tr>
            </thead>
            <tbody>
              <% @past_tenancies.each do |tenancy| %>
                <%
                  as_of_date = tenancy.termination_date || tenancy.commencement_date || Date.current
                  past_tenants = tenancy.tenant_parties_as_of(as_of_date)
                  tenant_parties = past_tenants.presence || tenancy.all_tenant_parties
                  party_names = tenant_parties.map(&:display_name).presence
                  balance_cents = @balances[tenancy.id] || 0
                  period_str = [tenancy.commencement_date&.strftime("%b %Y"), tenancy.termination_date&.strftime("%b %Y")].compact.join(" – ")
                %>
                <tr>
                  <td class="text-stone-500 whitespace-nowrap"><%= tenancy.rentable_unit&.name || "Unit" %></td>
                  <td>
                    <%= link_to tenancy_path(tenancy), class: "yn-row-link text-stone-600" do %>
                      <%= party_names ? party_names.to_sentence : "Past tenancy" %>
                    <% end %>
                  </td>
                  <td class="text-stone-500 whitespace-nowrap"><%= period_str %></td>
                  <td class="text-right tabular-nums whitespace-nowrap text-stone-500">
                    <%= balance_phrase_cents(balance_cents) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  </div>
</div>
