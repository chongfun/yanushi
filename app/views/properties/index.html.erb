<% content_for :title, "Properties" %>

<div class="max-w-6xl mx-auto py-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-stone-900">Properties</h1>
    <%= link_to "New Property", new_property_path, class: "yn-btn yn-btn-primary" %>
  </div>

  <div class="bg-white border border-stone-200 rounded-lg p-6">
    <div class="overflow-x-auto">
      <table class="yn-table">
        <thead>
          <tr>
            <th scope="col">Address</th>
            <th scope="col">Asset Type</th>
            <th scope="col">Size</th>
            <th scope="col">Units</th>
            <th scope="col">Tenancies</th>
            <th scope="col" class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="properties">
          <% @properties.each do |property| %>
            <%= render property %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
