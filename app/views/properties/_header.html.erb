<%
  current_tab = local_assigns[:current_tab] || :overview
  active_rentable_units = @property.rentable_units.select(&:active?)
  total_units = active_rentable_units.size
  occupied_units = active_rentable_units.count { |u| u.tenancies.any?(&:active?) }

  occupancy_text = if total_units == 1
    occupied_units == 1 ? "occupied" : "vacant"
  else
    "#{occupied_units} of #{total_units} occupied"
  end

  is_all_occupied = total_units > 0 && occupied_units == total_units
  dot_class = is_all_occupied ? "yn-dot-ok" : "yn-dot-warn"

  tab_items = [
    { label: "Overview", path: property_path(@property), current: current_tab == :overview },
    { label: "Tenancies", path: property_tenancies_path(@property), current: current_tab == :tenancies },
    { label: "Activity", path: property_activity_path(@property), current: current_tab == :activity },
    { label: "Tax", path: property_tax_path(@property), current: current_tab == :tax }
  ]
%>

<% content_for :title, [ @property.address, tab_items.find { |t| t[:current] }&.dig(:label) ].compact.join(" · ") %>

<%= render "shared/page_header",
      eyebrow: capture { %>
        <%= link_to "Portfolio", portfolio_path, class: "hover:text-stone-700 no-underline text-inherit" %>
        <span class="mx-1 text-stone-300">/</span>
        <%= @property.address %>
      <% },
      title: @property.address,
      meta: capture { %>
        <%= @property.asset_type.humanize %> &middot;
        <%= total_units == 1 ? "1 unit" : "#{total_units} units" %> &middot;
        <span class="yn-status yn-status-sm">
          <span class="yn-dot <%= dot_class %>"></span><%= occupancy_text %>
        </span>
      <% },
      actions: capture { %>
        <details class="relative" data-controller="menu">
          <summary class="yn-btn yn-btn-secondary list-none cursor-pointer">
            More
            <svg viewBox="0 0 16 16" class="w-3.5 h-3.5" fill="currentColor" aria-hidden="true"><path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z"/></svg>
          </summary>
          <div class="yn-menu">
            <%= link_to "Edit property", edit_property_path(@property), class: "yn-menu-item" %>
            <%= link_to "Add unit", new_property_rentable_unit_path(@property), class: "yn-menu-item" %>
            <hr class="yn-menu-separator">
            <%= button_to "Delete property…", property_path(@property), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this property?" }, class: "yn-menu-item yn-menu-item-danger" %>
          </div>
        </details>
        <%= link_to "Record expense", new_property_expense_path(@property), data: (current_tab == :overview ? { turbo_frame: "modal-frame" } : {}), class: (current_tab == :tax ? "yn-btn yn-btn-secondary" : "yn-btn yn-btn-primary") %>
      <% },
      tabs: render("shared/tabs", items: tab_items, aria_label: "Property sections") %>
