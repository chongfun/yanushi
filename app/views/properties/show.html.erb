<div class="max-w-5xl">
  <%= render "properties/header", current_tab: :overview %>

  <div class="space-y-10">
    <!-- Units & current occupancy -->
    <section aria-labelledby="units-heading">
      <h2 id="units-heading" class="text-sm font-semibold mb-3">Units</h2>
      <% active_units = @property.rentable_units.select(&:active?) %>
      <% if active_units.any? %>
        <div class="overflow-x-auto">
          <table class="yn-table">
            <thead>
              <tr>
                <th scope="col">Unit</th>
                <th scope="col">Occupant</th>
                <th scope="col" class="text-right tabular-nums">Rent</th>
                <th scope="col" class="text-right tabular-nums">Balance</th>
              </tr>
            </thead>
            <tbody>
              <% active_units.each do |unit| %>
                <%
                  active_tenancy = unit.tenancies.find(&:active?)
                  tenant_parties = active_tenancy&.tenant_parties_as_of(Date.current)&.presence || active_tenancy&.all_tenant_parties
                  tenant_name = tenant_parties&.map(&:display_name)&.presence
                  rent_term = active_tenancy&.current_rent_term(Date.current)
                  balance_cents = active_tenancy ? (@balances[active_tenancy.id] || 0) : nil
                %>
                <tr>
                  <td class="font-medium"><%= unit.name %></td>
                  <td>
                    <% if active_tenancy %>
                      <%= link_to tenancy_path(active_tenancy), class: "yn-row-link" do %>
                        <%= tenant_name ? tenant_name.to_sentence : "Active tenancy" %>
                      <% end %>
                      <% if active_tenancy.commencement_date %>
                        <span class="text-stone-400 text-[13px]">&middot; since <%= active_tenancy.commencement_date.strftime("%b %Y") %></span>
                      <% end %>
                    <% else %>
                      <%= render "shared/status", text: "Vacant", size: :sm %>
                      <%= link_to "Create tenancy", new_tenancy_path(rentable_unit_id: unit.id), class: "yn-link text-[13px] ml-2" %>
                    <% end %>
                  </td>
                  <td class="text-right tabular-nums whitespace-nowrap">
                    <%= rent_term ? "#{format_money_cents(rent_term.amount_cents)}/mo" : "—" %>
                  </td>
                  <td class="text-right tabular-nums whitespace-nowrap <%= balance_cents && balance_cents.positive? ? 'text-stone-900 font-medium' : 'text-stone-500' %>">
                    <% if balance_cents.nil? %>
                      <span class="text-stone-400" aria-hidden="true">—</span>
                    <% elsif balance_cents.zero? %>
                      <span class="text-stone-400" aria-hidden="true">—</span><span class="sr-only">Settled</span>
                    <% else %>
                      <%= balance_phrase_cents(balance_cents) %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <%= render "shared/empty_state",
              title: "No units yet",
              body: "Add the rentable units at this property before creating tenancies.",
              action: link_to("Add unit", new_property_rentable_unit_path(@property), class: "yn-btn yn-btn-primary yn-btn-sm") %>
      <% end %>
    </section>

    <%= render "properties/summary",
          security_deposits_held_cents: @security_deposits_held_cents,
          ytd_summary: @ytd_summary %>

    <%= render "properties/recent_activity",
          property: @property,
          recent_activity: @recent_activity %>
  </div>
</div>
