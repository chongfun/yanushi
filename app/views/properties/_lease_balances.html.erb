<% active_tenancies = active_tenancies_for(property) %>
<% if active_tenancies.any? %>
  <div class="mb-8">
    <h3 class="text-lg font-bold text-base-content/70 mb-3">Active Tenancy Balances</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% active_tenancies.each do |tenancy| %>
        <% balance = tenancy.current_balance %>
        <div class="p-4 rounded-xl border bg-base-100 shadow-sm flex justify-between items-center <%= balance >= 0 ? 'border-success/30' : 'border-error/30' %>">
          <div>
            <div class="font-bold text-sm text-base-content/85">Tenancy #<%= tenancy.id %> (<%= tenancy.parties.map(&:display_name).join(', ') %>)</div>
            <div class="text-xs text-base-content/50"><%= tenancy.commencement_date.strftime("%b %Y") %> - <%= tenancy.termination_date&.strftime("%b %Y") || 'Month-to-Month' %></div>
          </div>
          <div class="text-right">
            <div class="text-lg font-black <%= balance >= 0 ? 'text-success' : 'text-error' %>">
              <%= balance >= 0 ? "+" : "" %><%= number_to_currency(balance) %>
            </div>
            <div class="text-xxs uppercase tracking-wider text-base-content/40 font-bold"><%= balance >= 0 ? 'Surplus / Paid' : 'Balance Owed' %></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
