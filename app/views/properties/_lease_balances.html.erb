<% active_tenancies = active_tenancies_for(property) %>
<% if active_tenancies.any? %>
  <div class="mb-8">
    <h3 class="text-lg font-bold text-base-content/70 mb-3">Active Tenancy Balances</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% active_tenancies.each do |tenancy| %>
        <% balance = tenancy.current_balance %>
        <% border_class = if balance > 0 then 'border-error/30' elsif balance < 0 then 'border-success/30' else 'border-base-200' end %>
        <% text_class = if balance > 0 then 'text-error' elsif balance < 0 then 'text-success' else 'text-base-content/70' end %>
        <% label_text = if balance > 0 then 'Balance Owed' elsif balance < 0 then 'Credit Balance' else 'Settled' end %>
        <div class="p-4 rounded-xl border bg-base-100 shadow-sm flex justify-between items-center <%= border_class %>">
          <div>
            <div class="font-bold text-sm text-base-content/85">Tenancy #<%= tenancy.id %> (<%= tenancy.parties.map(&:display_name).join(', ') %>)</div>
            <div class="text-xs text-base-content/50"><%= tenancy.commencement_date.strftime("%b %Y") %> - <%= tenancy.termination_date&.strftime("%b %Y") || 'Month-to-Month' %></div>
          </div>
          <div class="text-right">
            <div class="text-lg font-black <%= text_class %>">
              <%= balance < 0 ? "-" : "" %><%= number_to_currency(balance.abs) %>
            </div>
            <div class="text-xxs uppercase tracking-wider text-base-content/40 font-bold"><%= label_text %></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
