<% content_for :title, "Schedule E — #{@year}" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="max-w-4xl">
  <header class="mb-6">
    <p class="text-xs font-medium uppercase tracking-wider text-stone-500 mb-1.5">
      <%= link_to "Reports", reports_path(year: @year), class: "hover:text-stone-700 no-underline text-inherit" %>
      <span class="mx-1 text-stone-300">/</span>
      <%= link_to @property.address, property_tax_path(@property, year: @year), class: "hover:text-stone-700 no-underline text-inherit" %>
    </p>

    <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
      <div class="min-w-0">
        <h1 class="text-2xl font-semibold tracking-tight text-stone-900">Schedule E — <%= @year %></h1>
        <%= render "properties/schedule_e/readiness" %>
      </div>
      <%= render "properties/schedule_e/export" %>
    </div>
  </header>

  <div class="space-y-10">
    <%= render "properties/schedule_e/review" %>
    <%= render "properties/schedule_e/projection" %>

    <!-- Disclaimers / Scope -->
    <div class="yn-surface p-4 text-xs text-stone-500 space-y-1 max-w-2xl">
      <p class="font-medium text-stone-700 m-0">Important Tax Information & Scope</p>
      <p class="m-0">This worksheet summarizes tracked cash rental receipts and operating expenses from the double-entry accounting ledger.</p>
      <p class="font-medium text-stone-700 mt-2 m-0">Not tracked or computed by Yanushi:</p>
      <ul class="list-disc list-inside space-y-0.5 pl-1 m-0">
        <li>Depreciation & Section 179 property basis allocations (Line 18)</li>
        <li>Passive activity loss limitations and Form 8582 calculations</li>
        <li>Personal-use vs. rental percentage allocations</li>
      </ul>
    </div>
  </div>
</div>
