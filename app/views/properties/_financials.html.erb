<%= turbo_frame_tag "property_financials" do %>
  <% date_range = local_assigns[:date_range] || Accounting::DateRange.parse(year: local_assigns[:year] || params[:year], from: params[:from], through: params[:through]) %>
  <% schedule_e_year = if date_range.year.present?
       date_range.year
     elsif date_range.from && date_range.through && date_range.from.year == date_range.through.year
       date_range.from.year
     elsif date_range.from && date_range.through.nil? && date_range.from.year == Date.current.year
       date_range.from.year
     end %>
  <% active_years = local_assigns[:active_years] || Accounting::ActiveYearsQuery.call(property: property, additional_years: [date_range.year || Date.current.year]) %>
  <% financial_activity = local_assigns[:financial_activity] || Accounting::PropertyLedgerQuery.call(property: property, date_range: date_range) %>
  <% financial_summary = local_assigns[:financial_summary] || Accounting::PropertySummaryQuery.call(property: property, date_range: date_range) %>

  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to "＋ Record Expense",
            new_property_expense_path(property),
            class: "btn btn-sm btn-outline btn-error",
            data: { turbo_frame: "modal-frame" } %>
      <% active_tenancy = active_tenancy_for(property) %>
      <% if active_tenancy %>
        <%= link_to "＋ Record Payment",
              new_tenancy_receipt_path(active_tenancy),
              class: "btn btn-sm btn-outline btn-primary",
              data: { turbo_frame: "modal-frame" } %>
      <% end %>
      <% if schedule_e_year %>
        <%= link_to "📋 Schedule E",
              schedule_e_property_path(property, year: schedule_e_year),
              class: "btn btn-sm btn-outline btn-accent",
              data: { turbo_frame: "modal-frame" } %>
      <% else %>
        <span class="tooltip tooltip-bottom" data-tip="Choose a single tax year to view Schedule E">
          <button type="button" class="btn btn-sm btn-outline btn-accent btn-disabled opacity-50 cursor-not-allowed" disabled>📋 Schedule E</button>
        </span>
      <% end %>
    </div>

    <%= form_with url: property_path(property), method: :get, data: { turbo_frame: "property_financials", controller: "date-range-filter" }, class: "flex flex-wrap items-center gap-2" do |f| %>
      <%= f.label :year, "Year", class: "text-sm font-semibold" %>
      <%= f.select :year,
            options_for_select(active_years, date_range.year),
            { include_blank: date_range.year.nil? ? "Custom Range" : false },
            class: "select select-bordered select-sm",
            data: { date_range_filter_target: "yearSelect", action: "change->date-range-filter#yearChanged" } %>
      <div class="flex items-center gap-1 ml-2">
        <%= f.date_field :from, value: (date_range.year ? nil : date_range.from), placeholder: "From", class: "input input-bordered input-xs", data: { date_range_filter_target: "fromInput", action: "input->date-range-filter#dateChanged" } %>
        <span class="text-xs text-base-content/50">to</span>
        <%= f.date_field :through, value: (date_range.year ? nil : date_range.through), placeholder: "Through", class: "input input-bordered input-xs", data: { date_range_filter_target: "throughInput", action: "input->date-range-filter#dateChanged" } %>
        <%= f.submit "Go", class: "btn btn-xs btn-primary" %>
      </div>
    <% end %>
  </div>

  <% if date_range.valid? %>
    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <!-- Cash Movement -->
      <div class="card bg-base-100 shadow border border-base-200">
        <div class="card-body p-4">
          <h3 class="text-xs font-bold uppercase tracking-wider text-base-content/60">Cash Movement (Period)</h3>
          <div class="space-y-2 mt-2 text-sm">
            <div class="flex justify-between font-bold text-base">
              <span>Net Cash Movement:</span>
              <span class="font-mono <%= financial_summary.net_cash_movement_cents >= 0 ? 'text-success' : 'text-error' %>">
                <%= number_to_currency(financial_summary.net_cash_movement) %>
              </span>
            </div>
            <div class="text-xs text-base-content/50">
              Total net cash flow for the selected period
            </div>
          </div>
        </div>
      </div>

      <!-- Operating Activity (Accrual) -->
      <div class="card bg-base-100 shadow border border-base-200">
        <div class="card-body p-4">
          <h3 class="text-xs font-bold uppercase tracking-wider text-base-content/60">Operating Activity (Accrual)</h3>
          <div class="space-y-1 mt-2 text-sm">
            <div class="flex justify-between">
              <span class="text-base-content/70">Income Recognized:</span>
              <span class="font-mono <%= financial_summary.income_recognized_cents >= 0 ? 'text-success' : 'text-error' %>">
                <%= number_to_currency(financial_summary.income_recognized) %>
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-base-content/70">Operating Expenses:</span>
              <span class="font-mono <%= financial_summary.operating_expenses_cents > 0 ? 'text-error' : 'text-success' %>">
                <%= number_to_currency(financial_summary.operating_expenses) %>
              </span>
            </div>
            <div class="divider my-1"></div>
            <div class="flex justify-between font-bold">
              <span>Net Operating Income:</span>
              <span class="font-mono <%= financial_summary.net_operating_income_cents >= 0 ? 'text-success' : 'text-error' %>">
                <%= number_to_currency(financial_summary.net_operating_income) %>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Balances As Of Date -->
      <div class="card bg-base-100 shadow border border-base-200">
        <div class="card-body p-4">
          <h3 class="text-xs font-bold uppercase tracking-wider text-base-content/60">Closing Balances</h3>
          <div class="space-y-1 mt-2 text-sm">
            <div class="flex justify-between">
              <span class="text-base-content/70">Tenant Receivable:</span>
              <span class="font-mono font-bold <%= financial_summary.tenant_receivable_cents > 0 ? 'text-error' : 'text-base-content' %>">
                <%= number_to_currency(financial_summary.tenant_receivable) %>
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-base-content/70">Security Deposits Held:</span>
              <span class="font-mono font-bold text-info">
                <%= number_to_currency(financial_summary.security_deposits_held) %>
              </span>
            </div>
            <div class="text-xs text-base-content/40 mt-3">
              As of <%= date_range.as_of.strftime("%b %d, %Y") %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Activity Ledger Table -->
    <div class="overflow-x-auto bg-base-100 rounded-box shadow border border-base-200">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Details</th>
            <th class="text-right">Amount</th>
            <th class="text-right">Entry</th>
          </tr>
        </thead>
        <tbody>
          <% if financial_activity.empty? %>
            <tr>
              <td colspan="5" class="text-center py-8 text-base-content/50">
                <% if date_range.year.present? %>
                  No financial activity found for <%= date_range.year %>.
                <% elsif date_range.from || date_range.through %>
                  No financial activity found for the selected period.
                <% else %>
                  No financial activity found.
                <% end %>
              </td>
            </tr>
          <% else %>
            <% financial_activity.each do |row| %>
              <tr class="<%= 'opacity-60 bg-base-200/40' if row.corrected? || row.voided? %>">
                <td class="text-sm"><%= row.occurred_on.strftime("%b %d, %Y") %></td>
                <td>
                  <% if row.reversal %>
                    <% if row.kind == 'waiver' %>
                      <div class="badge badge-neutral gap-1 text-xs">Waiver</div>
                    <% else %>
                      <div class="badge badge-warning gap-1 text-xs">Correction</div>
                    <% end %>
                  <% else %>
                    <% case row.kind %>
                    <% when 'rent', 'late_fee', 'reimbursement', 'charge' %>
                      <div class="badge badge-info gap-1 text-xs"><%= row.label %></div>
                    <% when 'payment' %>
                      <div class="badge badge-success gap-1 text-xs text-success-content">Payment</div>
                    <% when 'expense' %>
                      <div class="badge badge-error gap-1 text-xs text-error-content">Expense</div>
                    <% when 'deposit_received', 'deposit_refunded', 'deposit_applied' %>
                      <div class="badge badge-secondary gap-1 text-xs"><%= row.label %></div>
                    <% else %>
                      <div class="badge badge-ghost gap-1 text-xs"><%= row.label %></div>
                    <% end %>
                  <% end %>
                </td>
                <td class="text-sm">
                  <span class="font-medium"><%= row.description.presence || row.label %></span>
                  <% if row.party %>
                    <span class="text-xs text-base-content/60">(<%= row.party.display_name %>)</span>
                  <% end %>
                  <% if row.rentable_unit %>
                    <span class="badge badge-ghost badge-xs ml-1"><%= row.rentable_unit.display_name %></span>
                  <% end %>
                  <% if row.lifecycle_status == :corrected %>
                    <span class="badge badge-warning badge-xs ml-2">Corrected</span>
                  <% elsif row.lifecycle_status == :voided %>
                    <span class="badge badge-neutral badge-xs ml-2">Waived</span>
                  <% end %>
                </td>
                <td class="text-right font-mono font-medium">
                  <% if row.amount_cents.negative? %>
                    <span class="text-error">-<%= number_to_currency(row.amount_cents.abs / 100.0) %></span>
                  <% elsif row.amount_cents.positive? %>
                    <span class="text-success">+<%= number_to_currency(row.amount_cents / 100.0) %></span>
                  <% else %>
                    <span class="text-base-content/50">$0.00</span>
                  <% end %>
                </td>
                <td class="text-right">
                  <%= link_to "Audit", journal_entry_path(row.journal_entry), class: "btn btn-ghost btn-xs" %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-warning shadow-sm border border-warning/30">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      <div>
        <h3 class="font-bold">Unable to calculate financial summary</h3>
        <div class="text-sm">Please correct the date range above (From date cannot be after Through date).</div>
      </div>
    </div>
  <% end %>
<% end %>
