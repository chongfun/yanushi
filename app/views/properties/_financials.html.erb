<%= turbo_frame_tag "property_financials" do %>
  <div class="flex justify-between items-center mb-4">
    <div class="flex items-center gap-2">
      <%= link_to "＋ Record Expense",
            new_property_expense_path(property),
            class: "btn btn-sm btn-outline btn-error",
            data: { turbo_frame: "modal-frame" } %>
      <% active_tenancy = active_tenancy_for(property) %>
      <% if active_tenancy %>
        <%= link_to "＋ Record Payment",
              new_tenancy_receipt_path(active_tenancy),
              class: "btn btn-sm btn-outline btn-primary",
              data: { turbo_frame: "modal-frame" } %>
      <% end %>
      <%= link_to "📋 Schedule E",
            schedule_e_property_path(property, year: year),
            class: "btn btn-sm btn-outline btn-accent",
            data: { turbo_frame: "modal-frame" } %>
    </div>
    <%= form_with url: property_path(property), method: :get, data: { turbo_frame: "property_financials" }, class: "flex items-center gap-2" do |f| %>
      <%= f.label :year, "Select Year", class: "text-sm font-semibold" %>
      <%= f.select :year,
            options_for_select(property.active_years([year]), year),
            {},
            onchange: "this.form.requestSubmit()",
            class: "select select-bordered select-sm" %>
    <% end %>
  </div>

  <div class="overflow-x-auto bg-base-100 rounded-box shadow border border-base-200">
    <table class="table table-zebra w-full">
      <thead>
        <tr>
          <th>Date</th>
          <th>Type</th>
          <th>Details</th>
          <th class="text-right">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% if financial_items.empty? %>
          <tr>
            <td colspan="4" class="text-center py-8 text-base-content/50">
              No financial activity found for <%= year %>
            </td>
          </tr>
        <% else %>
          <% financial_items.each do |item| %>
            <tr>
              <td><%= item[:date].strftime("%b %d, %Y") %></td>
              <td>
                <% case item[:type] %>
                <% when 'Charge' %>
                  <div class="badge badge-info gap-2 text-xs"><%= item[:type] %></div>
                <% when 'Payment', 'Receipt' %>
                  <div class="badge badge-success gap-2 text-xs text-success-content"><%= item[:type] %></div>
                <% when 'Expense' %>
                  <div class="badge badge-error gap-2 text-xs text-error-content"><%= item[:type] %></div>
                <% when 'Security Deposit' %>
                  <div class="badge badge-secondary gap-2 text-xs"><%= item[:type] %></div>
                <% end %>
              </td>
              <td class="text-sm">
                <% if item[:type] == 'Charge' %>
                  <% charge = item[:object] %>
                  <span class="font-medium"><%= charge.charge_kind.titleize %></span>
                  <% if charge.description.present? %>
                    - <%= charge.description %>
                  <% end %>
                  <% if charge.superseded? %>
                    <span class="badge badge-warning text-xs ml-2">Corrected</span>
                  <% elsif charge.voided? %>
                    <span class="badge badge-ghost text-xs ml-2">Voided</span>
                  <% end %>
                <% elsif item[:type] == 'Payment' || item[:type] == 'Receipt' %>
                  <% receipt = item[:object] %>
                  Tenancy #<%= receipt.tenancy_id %>
                  <% if receipt.respond_to?(:payer_party) && receipt.payer_party %>
                    (<%= receipt.payer_party.display_name %>, <%= receipt.payment_method&.titleize %>)
                  <% else %>
                    (Method: <%= receipt.payment_method %>)
                  <% end %>
                  <% if receipt.respond_to?(:superseded?) && receipt.superseded? %>
                    <span class="badge badge-warning text-xs ml-2">Corrected</span>
                  <% elsif receipt.respond_to?(:voided?) && receipt.voided? %>
                    <span class="badge badge-ghost text-xs ml-2">Voided</span>
                  <% end %>
                <% elsif item[:type] == 'Expense' %>
                  <% exp = item[:object] %>
                  <%= exp.expense_kind&.titleize %> - <%= exp.description %>
                  <% if exp.superseded? %>
                    <span class="badge badge-warning text-xs ml-2">Corrected</span>
                  <% elsif exp.voided? %>
                    <span class="badge badge-ghost text-xs ml-2">Voided</span>
                  <% elsif exp.reimbursed? %>
                    <span class="badge badge-warning text-xs text-warning-content ml-2">Reimbursable</span>
                  <% end %>
                <% elsif item[:type] == 'Security Deposit' %>
                  <% sdt = item[:object] %>
                  <%= sdt.transaction_kind.titleize %>
                  <% if sdt.party %>
                    - <%= sdt.party.display_name %>
                  <% elsif sdt.charge %>
                    - Charge #<%= sdt.charge_id %>
                  <% end %>
                  <% if sdt.superseded? %>
                    <span class="badge badge-warning text-xs ml-2">Corrected</span>
                  <% elsif sdt.voided? %>
                    <span class="badge badge-ghost text-xs ml-2">Voided</span>
                  <% end %>
                <% end %>
              </td>
              <td class="text-right font-medium">
                <% if item[:type] == 'Expense' %>
                  <span class="text-error">-<%= number_to_currency(item[:amount]) %></span>
                <% elsif item[:type] == 'Charge' %>
                  <span class="text-base-content/75"><%= number_to_currency(item[:amount]) %></span>
                <% elsif item[:type] == 'Payment' || item[:type] == 'Receipt' %>
                  <span class="text-success">+<%= number_to_currency(item[:amount]) %></span>
                <% elsif item[:type] == 'Security Deposit' %>
                  <% sdt = item[:object] %>
                  <span class="<%= sdt.received? ? 'text-primary' : 'text-base-content/75' %>"><%= sdt.received? ? '+' : '-' %><%= number_to_currency(item[:amount]) %></span>
                <% else %>
                  <%= number_to_currency(item[:amount]) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
