<% content_for :title, "Editing #{@property.address}" %>

<div class="max-w-xl mx-auto py-6">
  <h1 class="text-2xl font-bold tracking-tight text-stone-900 mb-6">Editing Property</h1>

  <div class="bg-white border border-stone-200 rounded-lg p-6 mb-6">
    <%= render "form", property: @property %>
  </div>

  <div class="flex justify-between">
    <%= link_to "Show Property", @property, class: "yn-btn yn-btn-secondary yn-btn-sm" %>
    <%= link_to "Back to Properties", properties_path, class: "yn-btn yn-btn-ghost yn-btn-sm" %>
  </div>
</div>
