<%= form_with(model: property, class: "space-y-4") do |form| %>
  <% if property.errors.any? %>
    <div class="yn-alert yn-alert-danger" role="alert">
      <div>
        <h3 class="font-bold text-sm"><%= pluralize(property.errors.count, "error") %> prohibited this property from being saved:</h3>
        <ul class="list-disc pl-5 mt-1 text-sm">
          <% property.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div>
    <%= form.label :address, class: "yn-label" %>
    <%= form.text_field :address, class: "yn-input", required: true %>
  </div>

  <div>
    <%= form.label :asset_type, class: "yn-label" %>
    <%= form.select :asset_type, Property::ASSET_TYPES.map { |k| [k.titleize, k] }, {}, { class: "yn-select", required: true } %>
  </div>

  <div>
    <%= form.label :square_footage, class: "yn-label" %>
    <%= form.number_field :square_footage, class: "yn-input" %>
  </div>

  <% if property.new_record? %>
    <div class="border-t border-stone-200 pt-4 mt-6">
      <h3 class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Initial Unit (Optional)</h3>
      <p class="text-xs text-stone-400 mb-4">Leave blank to automatically create "Main Unit" for single-family/single-space properties.</p>

      <%= form.fields_for :unit do |uf| %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= uf.label :name, "Unit Name (e.g. Unit A, Apt 1)", class: "yn-label" %>
            <%= uf.text_field :name, class: "yn-input", placeholder: "Main Unit" %>
          </div>
          <div>
            <%= uf.label :unit_identifier, "Identifier (Optional)", class: "yn-label" %>
            <%= uf.text_field :unit_identifier, class: "yn-input", placeholder: "101" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="pt-2">
    <%= form.submit class: "yn-btn yn-btn-primary w-full" %>
  </div>
<% end %>
