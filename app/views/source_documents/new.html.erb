<% content_for :title, "Upload statement" %>

<div class="max-w-2xl">
  <%= render "shared/page_header",
        eyebrow: link_to("Inbox", inbox_path, class: "hover:text-stone-700 no-underline text-inherit"),
        title: "Upload statement",
        meta: "Yanushi reads the transactions out of the PDF, skips files it has already seen, and matches payments to your tenancies." %>

  <div class="yn-surface p-6">
    <%= form_with(model: @source_document, data: { turbo: false }, class: "space-y-5") do |f| %>
      <div>
        <%= f.label :pdf_file, "Statement or receipt PDF", class: "yn-label", for: "source_document_pdf_file" %>
        <%= f.file_field :pdf_file, accept: "application/pdf", id: "source_document_pdf_file",
              class: "yn-input file:mr-4 file:py-1 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-stone-100 file:text-stone-700 hover:file:bg-stone-200 cursor-pointer",
              "aria-describedby": "source_document_pdf_hint" %>
        <p id="source_document_pdf_hint" class="yn-hint">PDF only. Processing runs in the background; the Inbox updates on its own when it finishes.</p>
      </div>

      <section aria-labelledby="supported-heading">
        <h2 id="supported-heading" class="text-sm font-semibold mb-2">What you can upload</h2>
        <dl class="text-sm divide-y divide-stone-200 border-y border-stone-200">
          <div class="py-2.5">
            <dt class="font-medium text-stone-900">Chase</dt>
            <dd class="m-0 text-stone-500">Single Zelle receipts, and monthly checking statements. Zelle and peer-to-peer ACH deposits are extracted.</dd>
          </div>
          <div class="py-2.5">
            <dt class="font-medium text-stone-900">Venmo</dt>
            <dd class="m-0 text-stone-500">Transaction detail pages saved as PDF. Payers are matched by name or @username.</dd>
          </div>
        </dl>
      </section>

      <div class="flex justify-end gap-2 pt-2">
        <%= link_to "Cancel", inbox_path, class: "yn-btn yn-btn-ghost" %>
        <%= f.submit "Upload statement", class: "yn-btn yn-btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
