<% content_for :title, "Upload Source Document - Yanushi" %>

<div class="max-w-2xl mx-auto py-6">
  <div class="bg-white border border-stone-200 rounded-lg p-6">
    <h1 class="text-2xl font-bold tracking-tight text-stone-900 mb-2">Ingest Source Document</h1>
    <p class="text-sm text-stone-500 mb-6">
      Upload a Chase Zelle receipt, Venmo receipt, or monthly Chase checking statement PDF. The system will automatically parse transactions, extract metadata, and match them to your tenants.
    </p>

    <%= form_with(model: @source_document, local: true, data: { turbo: false }, class: "space-y-6") do |f| %>
      <div>
        <label class="yn-label">
          <span>Select Document PDF</span>
        </label>
        <%= f.file_field :pdf_file, accept: "application/pdf", class: "yn-input file:mr-4 file:py-1 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-stone-100 file:text-stone-700 hover:file:bg-stone-200 cursor-pointer" %>
        <p class="yn-hint">PDF format only</p>
      </div>

      <div class="space-y-4">
        <h3 class="text-xs font-semibold text-stone-500 uppercase tracking-wider">Supported Documents & Formats</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Chase Zelle / P2P -->
          <div class="bg-stone-50 border border-stone-200 rounded-lg p-4">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-mono font-semibold px-2 py-0.5 bg-stone-200 rounded text-stone-800">Chase</span>
              <span class="text-sm font-bold text-stone-900">Zelle & Statements</span>
            </div>
            <ul class="text-xs text-stone-600 space-y-1 list-disc list-inside">
              <li>Single-payment PDF Zelle receipts</li>
              <li>Multi-page checking account statements</li>
              <li>Extracts Zelle & P2P ACH deposits</li>
            </ul>
          </div>

          <!-- Venmo Receipts -->
          <div class="bg-stone-50 border border-stone-200 rounded-lg p-4">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-mono font-semibold px-2 py-0.5 bg-stone-200 rounded text-stone-800">Venmo</span>
              <span class="text-sm font-bold text-stone-900">Venmo Receipts</span>
            </div>
            <ul class="text-xs text-stone-600 space-y-1 list-disc list-inside">
              <li>"Transaction details" pages saved as PDF</li>
              <li>Single-payment receipts</li>
              <li>Resolves by name or @username handle</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <%= link_to "Cancel", imported_transactions_path, class: "yn-btn yn-btn-secondary" %>
        <%= f.submit "Upload & Parse", class: "yn-btn yn-btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
