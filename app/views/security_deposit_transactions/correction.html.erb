<% content_for :title, "Correct Deposit Transaction ##{@transaction.id}" %>

<div class="max-w-xl mx-auto py-6">
  <div class="bg-white border border-stone-200 rounded-lg p-6">
    <h1 class="text-2xl font-bold tracking-tight text-stone-900 mb-2">Correct Deposit <%= @transaction.transaction_kind.titleize %></h1>
    <p class="text-sm text-stone-500 mb-6">
      This will reverse the original journal entry on its original date (<%= @transaction.occurred_on.strftime("%b %d, %Y") %>) and post a replacement transaction.
    </p>

    <%= form_with model: @transaction, url: correct_security_deposit_transaction_path(@transaction), method: :post, class: "space-y-4" do |f| %>
      <div>
        <label class="yn-label" for="security_deposit_transaction_amount">Amount ($)</label>
        <%= f.number_field :amount, value: sprintf("%.2f", @transaction.amount), step: "0.01", min: "0.01", class: "yn-input font-mono tabular-nums", id: "security_deposit_transaction_amount", required: true %>
      </div>

      <div>
        <label class="yn-label" for="security_deposit_transaction_occurred_on">Date</label>
        <%= f.date_field :occurred_on, value: @transaction.occurred_on, class: "yn-input", id: "security_deposit_transaction_occurred_on", required: true %>
      </div>

      <% if @transaction.received? || @transaction.refunded? %>
        <div>
          <label class="yn-label" for="security_deposit_transaction_party_id">
            <%= @transaction.received? ? "Contributor (Payer)" : "Recipient" %>
          </label>
          <%= f.collection_select :party_id, @parties, :id, :display_name, { selected: @transaction.party_id }, class: "yn-select", id: "security_deposit_transaction_party_id", required: true %>
        </div>
      <% elsif @transaction.applied? %>
        <div>
          <label class="yn-label" for="security_deposit_transaction_charge_id">Target Charge</label>
          <%= f.collection_select :charge_id, @active_charges, :id, :description, { selected: @transaction.charge_id }, class: "yn-select", id: "security_deposit_transaction_charge_id", required: true %>
        </div>
      <% end %>

      <div>
        <label class="yn-label" for="security_deposit_transaction_external_reference">Reference (Optional)</label>
        <%= f.text_field :external_reference, value: @transaction.external_reference, class: "yn-input", id: "security_deposit_transaction_external_reference" %>
      </div>

      <div>
        <label class="yn-label" for="security_deposit_transaction_memo">Memo (Optional)</label>
        <%= f.text_field :memo, value: @transaction.memo, class: "yn-input", id: "security_deposit_transaction_memo" %>
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <%= link_to "Cancel", security_deposit_transaction_path(@transaction), class: "yn-btn yn-btn-secondary" %>
        <%= f.submit "Save Correction", class: "yn-btn yn-btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
