<%
  # form_context: :dialog (modal) or :standalone (full page)
  form_context = local_assigns[:form_context] || :dialog
  tenancy = local_assigns[:tenancy] || receipt.tenancy
  balance_cents = local_assigns[:balance_cents]
  balance_cents ||= Accounting::TenancyBalanceQuery.balance_cents_as_of(tenancy: tenancy, as_of: Date.current) if tenancy

  action_url = if form_context == :standalone
    tenancy_receipts_path(tenancy, format: :html)
  else
    tenancy_receipts_path(tenancy)
  end

  parties = tenancy.property.user.parties.order(:display_name)
%>

<%= form_with(model: receipt, url: action_url, class: "space-y-4", id: "receipt-form") do |form| %>
  <% if receipt.errors.any? || flash[:alert].present? %>
    <div class="yn-alert yn-alert-danger" role="alert">
      <% if flash[:alert].present? %>
        <%= flash[:alert] %>
      <% else %>
        Receipt couldn't be recorded — <%= pluralize(receipt.errors.count, "field") %> needs a fix.
      <% end %>
      <% if receipt.errors.any? %>
        <ul class="list-disc pl-5 mt-1 text-sm">
          <% receipt.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>

  <!-- Read-only context strip -->
  <div class="rounded-lg bg-stone-50 border border-stone-200 px-3.5 py-2.5 text-sm">
    <div class="flex justify-between gap-4">
      <span class="text-stone-500">Tenancy</span>
      <span class="font-medium text-right">
        <% primary = tenancy.primary_tenant_parties.map(&:display_name).to_sentence %>
        <%= primary.presence || "Tenancy ##{tenancy.id}" %> · <%= tenancy.rentable_unit.display_name %>, <%= tenancy.property.address %>
      </span>
    </div>
    <div class="flex justify-between gap-4 mt-1">
      <span class="text-stone-500">Current balance</span>
      <span class="font-medium tabular-nums"><%= balance_phrase_cents(balance_cents) %></span>
    </div>
  </div>

  <%= form.hidden_field :tenancy_id, value: tenancy.id %>

  <div>
    <%= form.label :payer_party_id, "Payer", class: "yn-label", for: "receipt-payer" %>
    <%= form.collection_select :payer_party_id, parties, :id, :display_name,
          { include_blank: "Select payer" },
          { class: "yn-select #{'yn-field-invalid' if receipt.errors[:payer_party_id].any?}", id: "receipt-payer",
            "aria-invalid": receipt.errors[:payer_party_id].any? ? "true" : nil,
            "aria-describedby": receipt.errors[:payer_party_id].any? ? "receipt-payer-error" : nil } %>
    <% if receipt.errors[:payer_party_id].any? %>
      <p id="receipt-payer-error" class="yn-error-text"><%= receipt.errors[:payer_party_id].first %></p>
    <% end %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <% has_amount_error = receipt.errors[:amount].any? || receipt.errors[:amount_cents].any? %>
      <%= form.label :amount, "Amount", class: "yn-label", for: "receipt-amount" %>
      <%= form.text_field :amount, value: receipt.formatted_amount, inputmode: "decimal", placeholder: "0.00",
            class: "yn-input tabular-nums #{'yn-field-invalid' if has_amount_error}", id: "receipt-amount",
            autofocus: (receipt.errors.empty? ? true : nil),
            "aria-invalid": has_amount_error ? "true" : nil,
            "aria-describedby": has_amount_error ? "receipt-amount-error" : nil %>
      <% if has_amount_error %>
        <p id="receipt-amount-error" class="yn-error-text"><%= receipt.errors[:amount].first || receipt.errors[:amount_cents].first %></p>
      <% end %>
    </div>
    <div>
      <%= form.label :received_on, "Received on", class: "yn-label", for: "receipt-date" %>
      <%= form.date_field :received_on, class: "yn-input #{'yn-field-invalid' if receipt.errors[:received_on].any?}", id: "receipt-date",
            "aria-invalid": receipt.errors[:received_on].any? ? "true" : nil,
            "aria-describedby": receipt.errors[:received_on].any? ? "receipt-date-error" : nil %>
      <% if receipt.errors[:received_on].any? %>
        <p id="receipt-date-error" class="yn-error-text"><%= receipt.errors[:received_on].first %></p>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :payment_method, "Payment method", class: "yn-label", for: "receipt-method" %>
      <%= form.text_field :payment_method, placeholder: "Zelle, check, cash…",
            class: "yn-input #{'yn-field-invalid' if receipt.errors[:payment_method].any?}", id: "receipt-method",
            "aria-invalid": receipt.errors[:payment_method].any? ? "true" : nil,
            "aria-describedby": receipt.errors[:payment_method].any? ? "receipt-method-error" : nil %>
      <% if receipt.errors[:payment_method].any? %>
        <p id="receipt-method-error" class="yn-error-text"><%= receipt.errors[:payment_method].first %></p>
      <% end %>
    </div>
    <div>
      <%= form.label :external_reference, class: "yn-label", for: "receipt-ref" do %>
        Reference <span class="font-normal text-stone-400">(optional)</span>
      <% end %>
      <%= form.text_field :external_reference, placeholder: "Check #1042",
            class: "yn-input #{'yn-field-invalid' if receipt.errors[:external_reference].any?}", id: "receipt-ref",
            "aria-invalid": receipt.errors[:external_reference].any? ? "true" : nil,
            "aria-describedby": receipt.errors[:external_reference].any? ? "receipt-ref-error" : nil %>
      <% if receipt.errors[:external_reference].any? %>
        <p id="receipt-ref-error" class="yn-error-text"><%= receipt.errors[:external_reference].first %></p>
      <% end %>
    </div>
  </div>

  <div>
    <%= form.label :memo, class: "yn-label", for: "receipt-memo" do %>
      Memo <span class="font-normal text-stone-400">(optional)</span>
    <% end %>
    <%= form.text_area :memo, rows: 2, class: "yn-textarea", id: "receipt-memo" %>
  </div>

  <div class="flex justify-end gap-2 pt-2">
    <% if form_context == :dialog %>
      <button type="button" data-action="modal#close" class="yn-btn yn-btn-ghost">Cancel</button>
    <% else %>
      <%= link_to "Cancel", tenancy_path(tenancy), class: "yn-btn yn-btn-ghost" %>
    <% end %>
    <%= form.submit "Record receipt", class: "yn-btn yn-btn-primary" %>
  </div>
<% end %>
