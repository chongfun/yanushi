<tr id="<%= dom_id receipt %>" class="<%= 'opacity-60 bg-base-200/50' if receipt.voided? %>">
  <td>
    <div class="font-medium text-sm"><%= receipt.tenancy&.property&.address %></div>
    <div class="text-xs text-base-content/60">
      Unit: <%= receipt.tenancy&.rentable_unit&.display_name %> (Tenancy #<%= receipt.tenancy_id %>)
    </div>
  </td>
  <td>
    <div class="font-medium text-sm"><%= receipt.payer_party&.display_name %></div>
  </td>
  <td class="text-sm"><%= receipt.received_on.strftime("%b %d, %Y") %></td>
  <td class="font-mono font-bold <%= receipt.voided? ? 'line-through text-base-content/50' : 'text-success' %>">
    <%= number_to_currency(receipt.amount) %>
  </td>
  <td>
    <span class="badge badge-ghost badge-sm"><%= receipt.payment_method.titleize %></span>
  </td>
  <td class="text-xs font-mono">
    <%= receipt.external_reference || "—" %>
  </td>
  <td>
    <% if receipt.voided? && receipt.superseded? %>
      <span class="badge badge-warning badge-sm">Corrected</span>
    <% elsif receipt.voided? %>
      <span class="badge badge-error badge-sm">Voided</span>
    <% elsif receipt.superseded_receipt.present? %>
      <span class="badge badge-info badge-sm">Replacement</span>
    <% else %>
      <span class="badge badge-success badge-sm">Active</span>
    <% end %>
  </td>
  <td class="text-right space-x-1">
    <%= link_to "View", receipt_path(receipt), class: "btn btn-xs btn-ghost" %>
  </td>
</tr>
