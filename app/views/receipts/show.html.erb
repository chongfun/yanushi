<div class="max-w-3xl mx-auto py-6">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-stone-900">Payment Details</h1>
      <p class="text-sm text-stone-500">Receipt ID: #<%= @receipt.id %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Back to Payments", receipts_path, class: "yn-btn yn-btn-secondary yn-btn-sm" %>
    </div>
  </div>

  <% if @receipt.voided? && @receipt.superseded? %>
    <div class="yn-alert yn-alert-warn mb-6" role="status">
      <div>
        <div class="font-bold text-sm">This payment was corrected and reversed.</div>
        <div class="text-xs">Replaced by <%= link_to "Receipt ##{@receipt.superseded_by_id}", receipt_path(@receipt.superseded_by), class: "yn-link font-semibold" %></div>
      </div>
    </div>
  <% elsif @receipt.voided? %>
    <div class="yn-alert yn-alert-danger mb-6" role="status">
      <div>
        <div class="font-bold text-sm">This payment was voided.</div>
        <div class="text-xs">Accounting postings for this receipt have been completely reversed on the ledger.</div>
      </div>
    </div>
  <% elsif @receipt.superseded_receipt.present? %>
    <div class="yn-alert mb-6" role="status">
      <div>
        <div class="font-bold text-sm">Replacement Payment</div>
        <div class="text-xs">This receipt replaces corrected <%= link_to "Receipt ##{@receipt.superseded_receipt.id}", receipt_path(@receipt.superseded_receipt), class: "yn-link font-semibold" %></div>
      </div>
    </div>
  <% end %>

  <div class="bg-white border border-stone-200 rounded-lg p-6">
    <div class="flex flex-col md:flex-row justify-between gap-8">
      <!-- Payment Summary -->
      <div class="space-y-6 flex-1">
        <div>
          <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Amount Paid</div>
          <div class="text-3xl font-bold font-mono tabular-nums <%= @receipt.voided? ? 'line-through text-stone-400' : 'text-stone-900' %>">
            <%= number_to_currency(@receipt.amount) %>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Payment Date</div>
            <div class="text-sm font-medium text-stone-900"><%= @receipt.received_on.strftime("%B %d, %Y") %></div>
          </div>
          <div>
            <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Payment Method</div>
            <div class="text-sm font-mono uppercase text-stone-700"><%= @receipt.payment_method.titleize %></div>
          </div>
        </div>

        <div>
          <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Payer</div>
          <div class="text-base font-bold text-stone-900"><%= @receipt.payer_party&.display_name %></div>
        </div>

        <% if @receipt.external_reference.present? %>
          <div>
            <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">External Reference / Txn #</div>
            <div class="font-mono text-xs bg-stone-100 px-3 py-1.5 rounded w-fit border border-stone-200 text-stone-700">
              <%= @receipt.external_reference %>
            </div>
          </div>
        <% end %>

        <% if @receipt.memo.present? %>
          <div>
            <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Memo</div>
            <div class="text-sm bg-stone-50 p-3 rounded-lg border border-stone-200 text-stone-700">
              <%= @receipt.memo %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Property & Tenancy Details -->
      <div class="border-t md:border-t-0 md:border-l border-stone-200 pt-6 md:pt-0 md:pl-8 space-y-6 flex-1">
        <div>
          <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Property Address</div>
          <div class="text-base font-bold leading-tight text-stone-900"><%= @receipt.tenancy&.property&.address %></div>
          <div class="text-xs text-stone-500 mt-0.5"><%= @receipt.tenancy&.rentable_unit&.display_name %></div>
        </div>

        <div>
          <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Tenancy</div>
          <div class="font-medium">
            <%= link_to "Tenancy ##{@receipt.tenancy_id}", tenancy_path(@receipt.tenancy), class: "yn-link" %>
          </div>
          <div class="text-xs text-stone-500 mt-1">
            <%= @receipt.tenancy&.commencement_date&.strftime("%b %d, %Y") %> – <%= @receipt.tenancy&.termination_date ? @receipt.tenancy.termination_date.strftime("%b %d, %Y") : "Month-to-Month" %>
          </div>
        </div>

        <div>
          <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Tenants on Lease</div>
          <div class="flex flex-wrap gap-1.5">
            <% @receipt.tenancy&.parties&.each do |party| %>
              <span class="text-xs text-stone-700 bg-stone-100 px-2 py-0.5 rounded border border-stone-200"><%= party.display_name %></span>
            <% end %>
          </div>
        </div>

        <div>
          <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Ledger Status</div>
          <div class="text-xs text-stone-500">
            <% if @receipt.posted? %>
              Posted on <%= @receipt.posted_at.strftime("%b %d, %Y at %l:%M %p") %>
            <% else %>
              Pending posting
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap justify-between items-center mt-8 border-t border-stone-200 pt-6 gap-3">
      <div class="flex flex-wrap gap-2">
        <%= link_to "Download PDF Receipt", receipt_path(@receipt, format: :pdf), target: "_blank", class: "yn-btn yn-btn-primary yn-btn-sm" %>
        <% if @receipt.active? %>
          <%= link_to "Correct Payment", correction_receipt_path(@receipt), class: "yn-btn yn-btn-secondary yn-btn-sm" %>
          <%= button_to "Void Payment", void_receipt_path(@receipt), method: :post, class: "yn-btn yn-btn-danger yn-btn-sm", data: { turbo_confirm: "Are you sure you want to void this payment? This will reverse all ledger entries and cannot be undone." } %>
        <% end %>
      </div>
      <div class="text-xs text-stone-400">
        Posted to ledger • Double-entry verified
      </div>
    </div>
  </div>
</div>
