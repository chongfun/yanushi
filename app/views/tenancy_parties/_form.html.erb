<%= form_with(model: [@tenancy, tenancy_party], class: "space-y-4") do |form| %>
  <% if tenancy_party.errors.any? %>
    <div class="yn-alert yn-alert-danger" role="alert">
      <div>
        <h3 class="font-bold text-sm"><%= pluralize(tenancy_party.errors.count, "error") %> prohibited this participant from being saved:</h3>
        <ul class="list-disc pl-5 mt-1 text-sm">
          <% tenancy_party.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <% if tenancy_party.new_record? %>
    <div>
      <%= form.label :party_id, "Select Party", class: "yn-label" %>
      <%= form.select :party_id, @parties.map { |p| [p.display_name, p.id] }, {}, { class: "yn-select", required: true } %>
    </div>

    <div>
      <%= form.label :role, "Role", class: "yn-label" %>
      <%= form.select :role, TenancyParty::ROLES.map { |r| [r.titleize, r] }, {}, { class: "yn-select", required: true } %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :effective_from, "Effective From Date", class: "yn-label" %>
        <%= form.date_field :effective_from, class: "yn-input", required: true %>
      </div>

      <div>
        <%= form.label :effective_until, "Effective Until Date (Optional)", class: "yn-label" %>
        <%= form.date_field :effective_until, class: "yn-input" %>
      </div>
    </div>
  <% else %>
    <div class="bg-stone-50 border border-stone-200 p-4 rounded-lg space-y-3">
      <div>
        <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider">Participant</div>
        <div class="text-base font-bold text-stone-900"><%= tenancy_party.party.display_name %></div>
      </div>
      <div class="flex gap-6">
        <div>
          <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider">Role</div>
          <span class="text-xs font-mono uppercase px-2 py-0.5 bg-stone-200 rounded text-stone-800 font-semibold inline-block mt-1"><%= tenancy_party.role.titleize %></span>
        </div>
        <div>
          <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider">Effective From</div>
          <div class="text-sm font-medium text-stone-900 mt-1"><%= tenancy_party.effective_from&.to_fs(:rfc822) %></div>
        </div>
      </div>
    </div>

    <div>
      <%= form.label :effective_until, "Effective Until Date (End of participation)", class: "yn-label" %>
      <%= form.date_field :effective_until, class: "yn-input" %>
      <p class="yn-hint">To change a participant's role or start a new period, add a new participant record.</p>
    </div>
  <% end %>

  <div class="flex justify-end gap-3 pt-2">
    <%= link_to "Cancel", @tenancy, class: "yn-btn yn-btn-secondary" %>
    <%= form.submit class: "yn-btn yn-btn-primary px-8" %>
  </div>
<% end %>
