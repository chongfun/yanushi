<% content_for :title, "Portfolio" %>

<div class="max-w-5xl">
  <header class="mb-6">
    <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
      <h1 class="text-2xl font-semibold tracking-tight text-stone-900">Portfolio</h1>
      <%= link_to "Add property", new_property_path, class: "yn-btn yn-btn-primary" %>
    </div>
    <nav class="yn-tabs mt-4" aria-label="Portfolio sections">
      <%= link_to "Properties", properties_path, class: "yn-tab", "aria-current": "page" %>
      <%= link_to "Tenancies", tenancies_path, class: "yn-tab" %>
      <%= link_to "Parties", parties_path, class: "yn-tab" %>
    </nav>
  </header>

  <div class="space-y-4">
    <div class="flex flex-wrap gap-3">
      <%= link_to "View all properties", properties_path, class: "yn-btn yn-btn-secondary" %>
      <%= link_to "View all tenancies", tenancies_path, class: "yn-btn yn-btn-secondary" %>
      <%= link_to "View all parties", parties_path, class: "yn-btn yn-btn-secondary" %>
    </div>

    <% if @properties.any? %>
      <table class="yn-table">
        <thead>
          <tr>
            <th scope="col">Property</th>
            <th scope="col">Asset Type</th>
            <th scope="col">Units</th>
          </tr>
        </thead>
        <tbody>
          <% @properties.each do |property| %>
            <tr>
              <td><%= link_to property.address, property_path(property), class: "yn-row-link" %></td>
              <td><%= property.asset_type.humanize %></td>
              <td class="tabular-nums"><%= property.rentable_units.count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="yn-empty">
        <p class="yn-empty-title">Add your first property</p>
        <p class="yn-empty-body">Yanushi tracks units, tenancies, and finances per property.</p>
        <%= link_to "Add property", new_property_path, class: "yn-btn yn-btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
