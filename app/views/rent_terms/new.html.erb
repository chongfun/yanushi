<% content_for :title, "Change Rent" %>

<div class="max-w-xl mx-auto py-6">
  <div class="bg-white border border-stone-200 rounded-lg p-6">
    <h1 class="text-2xl font-bold tracking-tight text-stone-900 mb-2">Change Rent for Tenancy #<%= @tenancy.id %></h1>
    <p class="text-xs text-stone-500 mb-6">Changing rent creates a new effective-dated term and closes the prior term. Historical terms remain unchanged.</p>

    <%= form_with(model: [@tenancy, @rent_term], class: "space-y-4") do |form| %>
      <% if @rent_term.errors.any? %>
        <div class="yn-alert yn-alert-danger" role="alert">
          <div>
            <h3 class="font-bold text-sm"><%= pluralize(@rent_term.errors.count, "error") %> prohibited this rent change:</h3>
            <ul class="list-disc pl-5 mt-1 text-sm">
              <% @rent_term.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <div>
        <%= form.label :amount, "New Monthly Rent ($)", class: "yn-label" %>
        <%= form.number_field :amount, value: (@rent_term.amount_cents ? @rent_term.amount_cents / 100.0 : nil), step: 0.01, min: 0, class: "yn-input font-mono tabular-nums", placeholder: "2150.00", required: true %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= form.label :effective_from, "Effective From Date", class: "yn-label" %>
          <%= form.date_field :effective_from, class: "yn-input", required: true %>
        </div>

        <div>
          <%= form.label :due_day, "Due Day of Month", class: "yn-label" %>
          <%= form.number_field :due_day, min: 1, max: 31, class: "yn-input font-mono tabular-nums", required: true %>
        </div>
      </div>

      <div>
        <%= form.label :frequency, "Frequency", class: "yn-label" %>
        <%= form.select :frequency, RentTerm::FREQUENCIES.map { |f| [f.titleize, f] }, {}, { class: "yn-select" } %>
      </div>

      <div class="flex justify-end gap-3 pt-4">
        <%= link_to "Cancel", @tenancy, class: "yn-btn yn-btn-secondary" %>
        <%= form.submit "Apply Rent Change", class: "yn-btn yn-btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
