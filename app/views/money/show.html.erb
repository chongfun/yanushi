<% content_for :title, "Money" %>

<div class="max-w-5xl">
  <header class="mb-6">
    <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
      <h1 class="text-2xl font-semibold tracking-tight text-stone-900">Money</h1>
    </div>
    <nav class="yn-tabs mt-4" aria-label="Money sections">
      <%= link_to "Receipts", receipts_path, class: "yn-tab" %>
      <%= link_to "Expenses", expenses_path, class: "yn-tab" %>
    </nav>
  </header>

  <div class="space-y-4">
    <p class="text-sm text-stone-500">Track and manage financial activity across your portfolio.</p>
    <div class="flex flex-wrap gap-3">
      <%= link_to "View Receipts", receipts_path, class: "yn-btn yn-btn-primary" %>
      <%= link_to "View Expenses", expenses_path, class: "yn-btn yn-btn-secondary" %>
    </div>
  </div>
</div>
