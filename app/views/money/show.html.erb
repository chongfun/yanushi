<% content_for :title, "Money" %>

<div class="max-w-5xl">
  <%= render "money/header", current_tab: :activity %>

  <!-- GET filters -->
  <%= form_with url: money_path, method: :get, class: "flex flex-wrap items-end gap-3 mb-6" do |f| %>
    <div>
      <%= f.label :property_id, "Property", class: "yn-label", for: "ma-property" %>
      <%= f.select :property_id,
            options_from_collection_for_select(@properties, :id, :address, @selected_property_id),
            { include_blank: "All properties" },
            class: "yn-select w-52",
            id: "ma-property" %>
    </div>
    <div>
      <%= f.label :year, "Year", class: "yn-label", for: "ma-year" %>
      <%= f.select :year,
            options_for_select(@active_years, @date_range.year),
            {},
            class: "yn-select w-32",
            id: "ma-year" %>
    </div>
    <%= f.submit "Apply", class: "yn-btn yn-btn-secondary" %>
    <% if @selected_property_id.present? || params[:year].present? || params[:from].present? || params[:through].present? %>
      <%= link_to "Clear filters", money_path, class: "yn-btn yn-btn-ghost text-sm" %>
    <% end %>
  <% end %>

  <% if @date_range.valid? %>
    <!-- Period totals for the current filter -->
    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-8 gap-y-4 border-y border-stone-200 py-4 mb-6">
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Income</dt>
        <dd class="mt-0.5 text-lg font-semibold tabular-nums m-0"><%= format_money_cents(@summary.income_recognized_cents) %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Expenses</dt>
        <dd class="mt-0.5 text-lg font-semibold tabular-nums m-0"><%= format_money_cents(@summary.total_expenses_cents) %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Net income</dt>
        <dd class="mt-0.5 text-lg font-semibold tabular-nums m-0"><%= signed_money_cents(@summary.net_income_cents) %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Net cash movement</dt>
        <dd class="mt-0.5 text-lg font-semibold tabular-nums m-0"><%= signed_money_cents(@summary.net_cash_movement_cents) %></dd>
      </div>
    </dl>
  <% end %>

  <% if @activity_result.rows.any? %>
    <div class="overflow-x-auto">
      <table class="yn-table">
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Event</th>
            <th scope="col">Property</th>
            <th scope="col" class="text-right tabular-nums">Amount</th>
            <th scope="col"><span class="sr-only">Audit</span></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "accounting/activity_row", collection: @activity_result.rows, as: :row, locals: { context: :property, audit: true } %>
        </tbody>
      </table>
    </div>

    <%= render "shared/pagination",
          page: @activity_result.page, per_page: @activity_result.per_page,
          total_count: @activity_result.total_count, total_pages: @activity_result.total_pages,
          page_url: ->(p) { money_path(page: p, property_id: @selected_property_id, year: params[:year], from: params[:from], through: params[:through]) } %>
  <% else %>
    <div class="yn-empty">
      <p class="yn-empty-title">No financial activity found</p>
      <% if @selected_property_id.present? || params[:year].present? %>
        <p class="yn-empty-body">No transactions match the selected filters.</p>
        <%= link_to "Clear filters", money_path, class: "yn-btn yn-btn-secondary yn-btn-sm mt-3" %>
      <% else %>
        <p class="yn-empty-body">Financial events will appear here as payments and expenses are recorded.</p>
      <% end %>
    </div>
  <% end %>
</div>
