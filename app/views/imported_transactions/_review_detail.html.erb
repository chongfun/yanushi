<turbo-frame id="inbox_review">
  <% if local_assigns[:inbox_revision].present? %>
    <div class="hidden"
         aria-hidden="true"
         data-controller="inbox-sync"
         data-inbox-sync-revision-value="<%= inbox_revision %>"
         <% if local_assigns[:stale_recovery] %>data-inbox-sync-stale-recovery-value="true"<% end %>
         <% if local_assigns[:review_count].present? %>data-inbox-sync-review-count-value="<%= review_count %>"<% end %>></div>
  <% end %>
  <% if transaction %>
    <div class="yn-surface p-5" data-controller="inbox-focus" data-inbox-focus-autofocus-value="<%= local_assigns[:focus_on_connect] ? 'true' : 'false' %>">
      <div class="flex items-start justify-between gap-4 mb-4">
        <div>
          <h2 class="text-base font-semibold m-0" id="review_detail_title" tabindex="-1">
            <%= [transaction.payment_method&.titleize || "Imported payment", transaction.occurred_on&.strftime("%b %d, %Y")].compact.join(" · ") %>
          </h2>
          <p class="text-sm text-stone-500 m-0 mt-0.5">
            <%= [transaction.payer_name ? "“#{transaction.payer_name}”" : nil, transaction.source_document ? "from #{transaction.source_document.attachment_filename}" : nil].compact.join(" · ") %>
          </p>
        </div>
        <p class="text-xl font-semibold tabular-nums whitespace-nowrap m-0">
          <%= format_money_cents(transaction.amount_cents) %>
        </p>
      </div>

      <%= render "imported_transactions/review_form",
                 transaction: transaction,
                 review_context: review_context,
                 parties: parties,
                 tenancies: tenancies,
                 party_tenancies_map: party_tenancies_map,
                 tenancy_parties_map: tenancy_parties_map %>
    </div>
  <% else %>
    <%= render "imported_transactions/caught_up",
               processing_count: local_assigns[:processing_count],
               failed_count: local_assigns[:failed_count] %>
  <% end %>
</turbo-frame>
