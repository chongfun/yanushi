<%= render "imported_transactions/count_streams",
           review_count: @review_count,
           processing_count: @processing_count,
           failed_count: @failed_count,
           history_count: @history_count,
           inbox_revision: @inbox_revision %>

<% if @transaction.present? %>
  <%= turbo_stream.replace "imported_transaction_#{@transaction.id}",
                           partial: "imported_transactions/review_row",
                           locals: { transaction: @transaction, selected: true } %>

  <%= turbo_stream.replace "inbox_review",
                           partial: "imported_transactions/review_detail",
                           locals: {
                             transaction: @transaction,
                             review_context: :inbox,
                             parties: @parties,
                             tenancies: @tenancies,
                             party_tenancies_map: @party_tenancies_map,
                             tenancy_parties_map: @tenancy_parties_map,
                             processing_count: @processing_count,
                             failed_count: @failed_count,
                             inbox_revision: @inbox_revision
                           } %>
<% elsif @next_transaction.present? %>
  <%= turbo_stream.replace "inbox_review_queue_list",
                           partial: "imported_transactions/review_list",
                           locals: { transactions: @reviewable_transactions, selected_transaction: @next_transaction } %>

  <%= turbo_stream.replace "inbox_review",
                           partial: "imported_transactions/review_detail",
                           locals: {
                             transaction: @next_transaction,
                             review_context: :inbox,
                             parties: @parties,
                             tenancies: @tenancies,
                             party_tenancies_map: @party_tenancies_map,
                             tenancy_parties_map: @tenancy_parties_map,
                             processing_count: @processing_count,
                             failed_count: @failed_count,
                             inbox_revision: @inbox_revision,
                             focus_on_connect: true
                           } %>
<% else %>
  <%= render "imported_transactions/caught_up_streams",
             processing_count: @processing_count,
             failed_count: @failed_count %>
<% end %>

<%= turbo_stream.append "flash-messages",
                        partial: "shared/toast",
                        locals: { type: :notice, message: (@notice_message || "Transaction record updated successfully.") } %>
