<% content_for :title, "Imported Transactions - Yanushi" %>

<% content_for :breadcrumbs do %>
  <li>Imported Transactions</li>
<% end %>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight text-base-content">Transaction Ingestion</h1>
    <p class="text-base-content/70 mt-1">Upload and review transactions to record payments and security deposits.</p>
  </div>
  <div>
    <%= link_to new_source_document_path, class: "btn btn-primary gap-2" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
      Upload Document
    <% end %>
  </div>
</div>

<div class="space-y-12">
  <% if @processing_documents.any? || @failed_documents.any? %>
    <!-- Section: Recent Uploads -->
    <div>
      <h2 class="text-xl font-bold text-base-content mb-4 flex items-center gap-2">
        <span>Recent Uploads</span>
        <span class="badge badge-primary font-semibold"><%= @processing_documents.size + @failed_documents.size %></span>
      </h2>

      <div class="overflow-x-auto card bg-base-100 border border-base-200 shadow-md">
        <table class="table table-zebra w-full">
          <thead>
            <tr>
              <th>File Name</th>
              <th>Status</th>
              <th>Uploaded At</th>
              <th>Details / Error Message</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @processing_documents.each do |doc| %>
              <tr class="animate-pulse">
                <td class="whitespace-nowrap font-medium text-sm">
                  <%= doc.attachment_filename %>
                </td>
                <td>
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary">
                    <span class="h-2 w-2 rounded-full bg-primary animate-ping"></span>
                    Processing...
                  </span>
                </td>
                <td class="text-xs text-base-content/60">
                  <%= doc.created_at.in_time_zone(Current.session.user.timezone).strftime("%b %d, %Y %I:%M %p") %>
                </td>
                <td class="text-sm text-base-content/50 italic">
                  Parsing and extracting document details...
                </td>
                <td class="text-right">
                  <%= link_to "Cancel", source_document_path(doc), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to cancel processing this document?" }, class: "btn btn-sm btn-ghost text-error" %>
                </td>
              </tr>
            <% end %>

            <% @failed_documents.each do |doc| %>
              <tr>
                <td class="whitespace-nowrap font-medium text-sm">
                  <%= doc.attachment_filename %>
                </td>
                <td>
                  <span class="badge badge-error text-xs font-semibold">Failed</span>
                </td>
                <td class="text-xs text-base-content/60">
                  <%= doc.created_at.in_time_zone(Current.session.user.timezone).strftime("%b %d, %Y %I:%M %p") %>
                </td>
                <td class="text-sm text-error font-medium">
                  <%= doc.error_message.presence || "Unknown parsing error" %>
                </td>
                <td class="text-right space-x-1">
                  <%= link_to "Retry", retry_source_document_path(doc), data: { turbo_method: :post }, class: "btn btn-sm btn-outline btn-primary" %>
                  <%= link_to "Dismiss", source_document_path(doc), data: { turbo_method: :delete }, class: "btn btn-sm btn-ghost" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Section: Review Queue -->
  <div>
    <h2 class="text-xl font-bold text-base-content mb-4 flex items-center gap-2">
      <span>Review Queue</span>
      <% if @reviewable_transactions.any? %>
        <span class="badge badge-secondary font-semibold"><%= @reviewable_transactions.size %></span>
      <% end %>
    </h2>

    <% if @reviewable_transactions.empty? %>
      <div class="card bg-base-100 border border-base-200 shadow-sm py-12">
        <div class="text-center max-w-md mx-auto space-y-4">
          <div class="inline-flex p-4 rounded-full bg-base-200 text-base-content/40">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="font-bold text-lg text-base-content">No Pending Imports</h3>
          <p class="text-sm text-base-content/60">All uploaded transactions have been reviewed and confirmed.</p>
        </div>
      </div>
    <% else %>
      <div class="overflow-x-auto card bg-base-100 border border-base-200 shadow-md">
        <table class="table table-zebra w-full">
          <thead>
            <tr>
              <th>Date</th>
              <th>Payer / Handle</th>
              <th>Matched Tenancy</th>
              <th>Kind</th>
              <th>Status</th>
              <th>Amount</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @reviewable_transactions.each do |txn| %>
              <tr class="hover:bg-base-200/40 transition-colors">
                <td class="whitespace-nowrap font-medium text-sm">
                  <%= txn.occurred_on&.strftime("%b %d, %Y") || content_tag(:span, "—", class: "text-base-content/40") %>
                </td>
                <td>
                  <div class="font-bold text-sm">
                    <%= txn.matched_party&.display_name || txn.payer_name.presence || "Unidentified Payer" %>
                  </div>
                  <% if txn.payer_username.present? %>
                    <div class="text-xs text-base-content/60 font-mono"><%= txn.payer_username %></div>
                  <% end %>
                </td>
                <td class="text-sm">
                  <% if txn.matched_tenancy %>
                    <div class="font-medium"><%= txn.matched_tenancy.property.address %></div>
                    <div class="text-xs text-base-content/60"><%= txn.matched_tenancy.agreement_type.titleize %></div>
                  <% else %>
                    <span class="text-xs text-base-content/40 italic">Not matched</span>
                  <% end %>
                </td>
                <td>
                  <% case txn.transaction_kind %>
                  <% when "tenant_receipt" %>
                    <span class="badge badge-primary badge-sm font-medium">Tenant Payment</span>
                  <% when "security_deposit" %>
                    <span class="badge badge-info badge-sm font-medium">Security Deposit</span>
                  <% else %>
                    <span class="badge badge-warning badge-sm font-medium">Needs Classification</span>
                  <% end %>
                </td>
                <td>
                  <% case txn.status %>
                  <% when "matched" %>
                    <span class="badge badge-success badge-sm font-semibold">Matched</span>
                  <% when "ambiguous" %>
                    <span class="badge badge-warning badge-sm font-semibold">Ambiguous</span>
                  <% when "unmatched" %>
                    <span class="badge badge-neutral badge-sm font-semibold">Unmatched</span>
                  <% when "failed" %>
                    <span class="badge badge-error badge-sm font-semibold">Failed</span>
                  <% else %>
                    <span class="badge badge-ghost badge-sm font-semibold"><%= txn.status.titleize %></span>
                  <% end %>
                </td>
                <td class="font-mono font-bold text-sm">
                  <%= txn.amount ? number_to_currency(txn.amount) : "—" %>
                </td>
                <td class="text-right space-x-2">
                  <%= link_to "Review", imported_transaction_path(txn), class: "btn btn-sm btn-primary" %>
                  <%= link_to "Delete", imported_transaction_path(txn), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this imported transaction?" }, class: "btn btn-sm btn-ghost text-error" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <!-- Section: Confirmed History -->
  <div>
    <h2 class="text-xl font-bold text-base-content mb-4 flex items-center gap-2">
      <span>Confirmed History</span>
      <% if @total_confirmed_count.positive? %>
        <span class="badge badge-neutral font-semibold"><%= @total_confirmed_count %></span>
      <% end %>
    </h2>

    <% if @confirmed_transactions.empty? %>
      <div class="card bg-base-100 border border-base-200 shadow-sm py-8 text-center text-base-content/50 text-sm">
        No confirmed transactions recorded yet.
      </div>
    <% else %>
      <div class="overflow-x-auto card bg-base-100 border border-base-200 shadow-md">
        <table class="table table-zebra w-full text-sm">
          <thead>
            <tr>
              <th>Date</th>
              <th>Payer</th>
              <th>Tenancy</th>
              <th>Classification</th>
              <th>Amount</th>
              <th>Method / Ref</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @confirmed_transactions.each do |txn| %>
              <tr>
                <td><%= txn.occurred_on&.strftime("%b %d, %Y") %></td>
                <td class="font-bold"><%= txn.matched_party&.display_name %></td>
                <td><%= txn.matched_tenancy&.property&.address %></td>
                <td>
                  <% if txn.tenant_receipt? %>
                    <span class="badge badge-primary badge-sm">Tenant Payment</span>
                  <% elsif txn.security_deposit? %>
                    <span class="badge badge-info badge-sm">Security Deposit</span>
                  <% else %>
                    <span class="badge badge-ghost badge-sm"><%= txn.transaction_kind.titleize %></span>
                  <% end %>
                </td>
                <td class="font-mono font-semibold"><%= number_to_currency(txn.amount) %></td>
                <td class="text-xs text-base-content/60">
                  <span class="capitalize"><%= txn.payment_method %></span>
                  <% if txn.external_reference.present? %>
                    &bull; <span class="font-mono"><%= txn.external_reference %></span>
                  <% end %>
                </td>
                <td class="text-right space-x-1">
                  <% if txn.confirmed_source.is_a?(Receipt) %>
                    <%= link_to "View Receipt", receipt_path(txn.confirmed_source), class: "btn btn-xs btn-outline" %>
                  <% elsif txn.confirmed_source.is_a?(SecurityDepositTransaction) %>
                    <%= link_to "View Deposit", security_deposit_transaction_path(txn.confirmed_source), class: "btn btn-xs btn-outline" %>
                  <% end %>
                  <%= link_to "Details", imported_transaction_path(txn), class: "btn btn-xs btn-ghost" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @total_pages > 1 %>
        <div class="flex justify-center mt-6">
          <div class="join">
            <% if @page > 1 %>
              <%= link_to "«", imported_transactions_path(page: @page - 1), class: "join-item btn btn-sm" %>
            <% end %>
            <button class="join-item btn btn-sm btn-active">Page <%= @page %> of <%= @total_pages %></button>
            <% if @page < @total_pages %>
              <%= link_to "»", imported_transactions_path(page: @page + 1), class: "join-item btn btn-sm" %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
