<% content_for :title, "Inbox - Yanushi" %>

<%= turbo_stream_from [Current.user, :inbox] %>

<%= render "imported_transactions/sync_target", revision: @inbox_revision, review_count: @review_count %>

<div class="max-w-6xl">
  <header class="mb-6">
    <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
      <h1 class="text-2xl font-semibold tracking-tight">Inbox</h1>
      <%= link_to "Upload statement", new_source_document_path, class: "yn-btn yn-btn-primary" %>
    </div>
    <%= render "imported_transactions/tab_counts",
               view: @view,
               review_count: @review_count,
               processing_count: @processing_count + @failed_count,
               history_count: @history_count %>
  </header>

  <% case @view %>
  <% when "processing" %>
    <%= render "imported_transactions/processing_view",
               processing_documents: @processing_documents,
               failed_documents: @failed_documents %>
  <% when "history" %>
    <%= render "imported_transactions/history_view",
               confirmed_transactions: @confirmed_transactions,
               page: @page,
               per_page: @per_page,
               total_pages: @total_pages,
               total_confirmed_count: @total_confirmed_count,
               filters: @history_filters %>
  <% else %>
    <%= render "imported_transactions/review_view",
               transactions: @reviewable_transactions,
               selected_transaction: @selected_transaction,
               total_count: @review_count,
               parties: @parties,
               tenancies: @tenancies,
               party_tenancies_map: @party_tenancies_map,
               tenancy_parties_map: @tenancy_parties_map,
               processing_count: @processing_count,
               failed_count: @failed_count %>
  <% end %>
</div>
