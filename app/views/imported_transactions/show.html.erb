<% content_for :title, "Review Imported Transaction - Yanushi" %>

<% content_for :breadcrumbs do %>
  <li><%= link_to "Imported Transactions", imported_transactions_path %></li>
  <li>Review Transaction #<%= @transaction.id %></li>
<% end %>

<!-- Status Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-6 border-b border-base-200">
  <div>
    <h1 class="text-3xl font-extrabold text-base-content flex items-center gap-3">
      <span>Review Imported Transaction</span>
      <% case @transaction.status %>
      <% when "confirmed" %>
        <span class="badge badge-success gap-1 py-3 px-4 font-bold text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
          Confirmed
        </span>
      <% when "matched" %>
        <span class="badge badge-success font-semibold py-3 px-3">Matched</span>
      <% when "ambiguous" %>
        <span class="badge badge-warning font-semibold py-3 px-3">Ambiguous Match</span>
      <% when "unmatched" %>
        <span class="badge badge-neutral font-semibold py-3 px-3">Unmatched</span>
      <% when "failed" %>
        <span class="badge badge-error font-semibold py-3 px-3">Failed Parse</span>
      <% end %>
    </h1>
    <p class="text-sm text-base-content/70 mt-1">Uploaded on <%= @transaction.created_at.in_time_zone(Current.session.user.timezone).strftime("%B %d, %Y at %I:%M %p") %></p>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to "Back to Queue", imported_transactions_path, class: "btn btn-outline btn-sm" %>
    <% unless @transaction.confirmed? %>
      <%= link_to "Delete Transaction", imported_transaction_path(@transaction), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this imported transaction?" }, class: "btn btn-error btn-outline btn-sm" %>
    <% end %>
  </div>
</div>

<% if @transaction.confirmed? %>
  <!-- Success Confirmation Banner -->
  <div class="alert alert-success shadow-lg mb-8">
    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    <div>
      <h3 class="font-bold text-lg">Transaction Confirmed!</h3>
      <p class="text-sm">
        Recorded as <strong><%= @transaction.tenant_receipt? ? "Tenant Payment Receipt" : "Security Deposit" %></strong> of
        <%= number_to_currency(@transaction.amount) %> on <%= @transaction.occurred_on&.strftime("%b %d, %Y") %>.
      </p>
    </div>
    <div class="flex-none">
      <% if @transaction.confirmed_source.is_a?(Receipt) %>
        <%= link_to "View Receipt", receipt_path(@transaction.confirmed_source), class: "btn btn-sm btn-outline text-success-content border-success-content/30 hover:bg-success-content/10" %>
      <% elsif @transaction.confirmed_source.is_a?(SecurityDepositTransaction) %>
        <%= link_to "View Deposit", security_deposit_transaction_path(@transaction.confirmed_source), class: "btn btn-sm btn-outline text-success-content border-success-content/30 hover:bg-success-content/10" %>
      <% end %>
    </div>
  </div>
<% elsif @transaction.failed? && @transaction.error_message.present? %>
  <!-- Failed Parse Alert -->
  <div class="alert alert-error shadow-sm mb-8 text-sm">
    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    <div>
      <h3 class="font-bold">PDF Parsing Failed</h3>
      <p><%= @transaction.error_message %>. Please review the document on the left and enter all required details manually below.</p>
    </div>
  </div>
<% end %>

<!-- Main Side-by-Side Review Section -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
  <!-- Left Side: Dynamic Receipt Preview -->
  <div class="lg:col-span-6 flex flex-col space-y-2">
    <div class="flex items-center justify-between">
      <h3 class="font-bold text-lg text-base-content">Document Preview</h3>
      <% if @transaction.source_document&.attachment_file.present? %>
        <%= link_to "Open Document in New Tab", download_source_document_path(@transaction.source_document), target: "_blank", class: "link link-primary text-xs" %>
      <% end %>
    </div>
    <div class="border border-base-300 rounded-lg overflow-hidden shadow-inner bg-base-300 flex-grow" style="height: 600px;">
      <% if @transaction.source_document&.chase_statement? && @transaction.raw_text.present? %>
        <div class="p-6 h-full overflow-auto font-mono text-sm whitespace-pre-wrap bg-base-200 text-base-content shadow-inner leading-relaxed flex flex-col justify-center items-center text-center">
          <div class="text-xs uppercase tracking-wider text-base-content/40 font-bold mb-4">Extracted Statement Line Item</div>
          <div class="bg-base-100 p-4 rounded-lg border border-base-300 shadow-sm font-bold font-mono text-base text-base-content whitespace-pre-wrap break-all text-left w-full max-w-lg">
            <%= @transaction.raw_text %>
          </div>
          <p class="text-xs text-base-content/50 mt-6">
            This transaction was extracted from a multi-page Chase statement.
            <br>
            Use the link above to view or download the full document.
          </p>
        </div>
      <% elsif @transaction.source_document&.attachment_file.present? %>
        <iframe src="<%= download_source_document_path(@transaction.source_document, anchor: 'navpanes=0&pagemode=none') %>" class="w-full h-full border-0" title="Document Preview"></iframe>
      <% elsif @transaction.raw_text.present? %>
        <div class="p-6 h-full overflow-auto font-mono text-sm whitespace-pre-wrap bg-base-200 text-base-content shadow-inner leading-relaxed">
          <%= @transaction.raw_text %>
        </div>
      <% else %>
        <div class="flex flex-col items-center justify-center h-full text-base-content/50 space-y-2 p-6 bg-base-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="text-sm font-medium">No preview available</span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Right Side: Edit Form and Confirmation -->
  <div class="lg:col-span-6 space-y-6">
    <div class="card bg-base-100 border border-base-200 shadow-lg">
      <div class="card-body space-y-6">
        <h3 class="card-title text-xl font-bold text-base-content">Extracted & Match Details</h3>

        <% unless @transaction.confirmed? %>
          <%= form_with(model: @transaction, local: true, class: "space-y-4", data: { controller: "imported-transaction-form", imported_transaction_form_party_tenancies_value: @party_tenancies_map.to_json, imported_transaction_form_tenancy_parties_value: @tenancy_parties_map.to_json }) do |f| %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Payer / Party</span></label>
                <%= f.select :matched_party_id, @parties.map { |p| [p.display_name, p.id] }, { include_blank: "Select Party" }, class: "select select-bordered w-full", data: { imported_transaction_form_target: "partySelect", action: "change->imported-transaction-form#partyChanged" } %>
              </div>

              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Tenancy</span></label>
                <%= f.select :matched_tenancy_id, @tenancies.map { |t| [ "#{t.property.address} - #{t.agreement_type.titleize} (Commenced #{t.commencement_date.strftime('%b %Y')})", t.id ] }, { include_blank: "Select Tenancy" }, class: "select select-bordered w-full", data: { imported_transaction_form_target: "tenancySelect", action: "change->imported-transaction-form#tenancyChanged" } %>
              </div>
            </div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold">Transaction Classification</span>
                <span class="label-text-alt text-base-content/60">Required</span>
              </label>
              <%= f.select :transaction_kind, [
                ["Needs Classification (Unknown)", "unknown"],
                ["Tenant Payment (Rent / Fee)", "tenant_receipt"],
                ["Security Deposit", "security_deposit"]
              ], {}, class: "select select-bordered w-full font-medium", data: { imported_transaction_form_target: "kindSelect", action: "change->imported-transaction-form#kindChanged" } %>
            </div>

            <!-- Dynamic Explanations based on Kind -->
            <div class="text-xs bg-base-200/60 p-3 rounded-lg border border-base-300">
              <div data-imported-transaction-form-target="unknownExplanation" class="<%= 'hidden' unless @transaction.unknown? %>">
                <p class="text-warning-content/90 font-medium">Please classify this transaction before confirmation. Unclassified transactions cannot be posted to the ledger.</p>
              </div>
              <div data-imported-transaction-form-target="receiptExplanation" class="<%= 'hidden' unless @transaction.tenant_receipt? %>">
                <p class="text-base-content/70">Will create a <strong>Payment Receipt</strong> and post Debit Cash / Credit Tenant Accounts Receivable.</p>
              </div>
              <div data-imported-transaction-form-target="depositExplanation" class="<%= 'hidden' unless @transaction.security_deposit? %>">
                <p class="text-base-content/70">Will record a <strong>Security Deposit Received</strong> transaction and post Debit Cash / Credit Security Deposit Liability.</p>
              </div>
            </div>

            <% if @transaction.matched_tenancy&.security_deposit %>
              <div data-imported-transaction-form-target="depositContext" class="card bg-info/10 border border-info/20 p-3 text-xs <%= 'hidden' unless @transaction.security_deposit? %>">
                <div class="font-bold text-info-content mb-1">Tenancy Security Deposit Requirement:</div>
                <div class="text-base-content/80">
                  Required: <%= number_to_currency(@transaction.matched_tenancy.security_deposit.required_amount) %> |
                  Held Balance: <%= number_to_currency(@transaction.matched_tenancy.security_deposit.held_balance) %>
                </div>
              </div>
            <% end %>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Payment Date</span></label>
                <%= f.date_field :occurred_on, class: "input input-bordered w-full" %>
              </div>

              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Amount</span></label>
                <div class="join w-full">
                  <span class="btn join-item pointer-events-none">$</span>
                  <%= f.number_field :amount, step: "0.01", class: "input input-bordered join-item w-full" %>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Payment Method</span></label>
                <%= f.select :payment_method, [["Zelle", "zelle"], ["Venmo", "venmo"], ["P2P ACH", "p2p"], ["Check", "check"], ["Cash", "cash"], ["Other", "other"]], { include_blank: "Select Method" }, class: "select select-bordered w-full" %>
              </div>

              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Transaction Reference</span></label>
                <%= f.text_field :external_reference, class: "input input-bordered w-full font-mono text-sm" %>
              </div>
            </div>

            <!-- Extra Extracted Payer Info -->
            <div class="bg-base-200/50 p-3 rounded-lg text-xs space-y-1 mt-2">
              <div class="font-bold text-base-content/85">Original PDF Metadata:</div>
              <div>Payer Name: <span class="font-semibold"><%= @transaction.payer_name.presence || "—" %></span></div>
              <% if @transaction.payer_username.present? %>
                <div>Payer Handle: <span class="font-semibold font-mono"><%= @transaction.payer_username %></span></div>
              <% end %>
            </div>

            <div class="flex justify-end pt-2">
              <%= f.submit "Save Corrections", class: "btn btn-outline btn-primary btn-sm" %>
            </div>
          <% end %>

          <div class="divider"></div>

          <!-- Step B: Final Confirmation Form -->
          <div class="space-y-4">
            <h4 class="font-bold text-md text-base-content">Record to Ledger</h4>
            
            <% if @transaction.confirmable? %>
              <%= form_with(url: confirm_imported_transaction_path(@transaction), method: :post, local: true, class: "space-y-4") do %>
                <!-- Checkbox to auto-add aliases -->
                <% alias_name_proposal = imported_transaction_alias_proposal(@transaction) %>

                <% if alias_name_proposal %>
                  <div class="form-control bg-primary/5 border border-primary/20 rounded-lg p-3">
                    <label class="flex items-start gap-3 cursor-pointer select-none">
                      <%= check_box_tag :create_alias, "1", true, class: "checkbox checkbox-primary checkbox-sm mt-0.5" %>
                      <div class="flex-1 min-w-0">
                        <span class="label-text font-bold text-primary block mb-0.5">Add payer alias</span>
                        <p class="text-xs text-base-content/60 leading-normal break-words">Automatically associate payer identifier "<%= alias_name_proposal %>" with this payer for future uploads.</p>
                      </div>
                    </label>
                  </div>
                <% end %>

                <button type="submit" class="btn btn-success btn-block gap-2 shadow-md">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                  Confirm & Record <%= @transaction.tenant_receipt? ? "Payment Receipt" : "Security Deposit" %>
                </button>
              <% end %>
            <% else %>
              <div class="bg-base-200 border border-base-300 rounded-lg p-4 text-center">
                <p class="text-sm text-base-content/60 mb-2">To confirm this transaction, please correct the form above to ensure all fields are complete and classified.</p>
                <div class="flex flex-wrap justify-center gap-2 text-xs">
                  <span class="badge <%= @transaction.matched_party_id ? 'badge-success' : 'badge-neutral/30' %>">Payer</span>
                  <span class="badge <%= @transaction.matched_tenancy_id ? 'badge-success' : 'badge-neutral/30' %>">Tenancy</span>
                  <span class="badge <%= !@transaction.unknown? ? 'badge-success' : 'badge-neutral/30' %>">Classified</span>
                  <span class="badge <%= @transaction.amount_cents ? 'badge-success' : 'badge-neutral/30' %>">Amount</span>
                  <span class="badge <%= @transaction.occurred_on ? 'badge-success' : 'badge-neutral/30' %>">Date</span>
                  <% if @transaction.security_deposit? %>
                    <span class="badge <%= @transaction.matched_tenancy&.security_deposit ? 'badge-success' : 'badge-error' %>">Deposit Requirement Exists</span>
                  <% end %>
                </div>
                <button class="btn btn-block btn-disabled mt-4">Confirm & Record</button>
              </div>
            <% end %>
          </div>

        <% else %>
          <!-- Show Read-Only Details for Confirmed Transactions -->
          <div class="space-y-4">
            <div class="grid grid-cols-2 gap-4 text-sm border-t border-base-200 pt-4">
              <div>
                <span class="text-base-content/50 block">Payer / Party</span>
                <span class="font-bold text-base-content"><%= @transaction.matched_party&.display_name %></span>
              </div>
              <div>
                <span class="text-base-content/50 block">Property / Tenancy</span>
                <span class="font-bold text-base-content"><%= @transaction.matched_tenancy&.property&.address %></span>
              </div>
              <div>
                <span class="text-base-content/50 block">Classification</span>
                <span class="font-bold text-base-content"><%= @transaction.tenant_receipt? ? "Tenant Payment" : "Security Deposit" %></span>
              </div>
              <div>
                <span class="text-base-content/50 block">Payment Date</span>
                <span class="font-bold text-base-content"><%= @transaction.occurred_on&.strftime("%b %d, %Y") %></span>
              </div>
              <div>
                <span class="text-base-content/50 block">Confirmed Amount</span>
                <span class="font-bold text-success"><%= number_to_currency(@transaction.amount) %></span>
              </div>
              <div>
                <span class="text-base-content/50 block">Payment Method</span>
                <span class="font-bold text-base-content capitalize"><%= @transaction.payment_method %></span>
              </div>
              <div>
                <span class="text-base-content/50 block">Transaction Reference</span>
                <span class="font-mono font-bold text-base-content"><%= @transaction.external_reference.presence || "—" %></span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
