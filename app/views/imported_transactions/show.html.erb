<% content_for :title, "Review Imported Transaction - Yanushi" %>

<div class="max-w-2xl">
  <header class="mb-6">
    <p class="text-xs font-medium uppercase tracking-wider text-stone-500 mb-1.5">
      <%= link_to "Inbox", inbox_path, class: "hover:text-stone-700 no-underline text-inherit" %>
      <span class="mx-1 text-stone-300">/</span>
      Needs review
    </p>
    <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2">
      <div class="min-w-0">
        <h1 class="text-2xl font-semibold tracking-tight">
          <%= [@transaction.payment_method&.titleize || "Imported payment", @transaction.occurred_on&.strftime("%b %d, %Y")].compact.join(" · ") %>
        </h1>
        <p class="mt-1 text-sm text-stone-500">
          <%= [@transaction.payer_name ? "“#{@transaction.payer_name}”" : nil, @transaction.source_document ? "from #{@transaction.source_document.attachment_filename}" : nil].compact.join(" · ") %>
        </p>
      </div>
      <p class="text-xl font-semibold tabular-nums whitespace-nowrap m-0">
        <%= format_money_cents(@transaction.amount_cents) %>
      </p>
    </div>
    <% if @reviewable_count && @reviewable_count > 0 %>
      <p class="mt-2 text-sm text-stone-500 m-0">
        Item <%= @item_index || 1 %> of <%= @reviewable_count %> needing review · <%= link_to "Back to Inbox", inbox_path, class: "yn-link" %>
      </p>
    <% else %>
      <p class="mt-2 text-sm text-stone-500 m-0">
        <%= link_to "Back to Inbox", inbox_path, class: "yn-link" %>
      </p>
    <% end %>
  </header>

  <%= render "imported_transactions/review_form",
             transaction: @transaction,
             review_context: :standalone,
             parties: @parties,
             tenancies: @tenancies,
             party_tenancies_map: @party_tenancies_map,
             tenancy_parties_map: @tenancy_parties_map %>
</div>
