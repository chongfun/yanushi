<div class="px-4 py-3.5" id="source_document_<%= document.id %>">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <p class="text-sm font-medium m-0"><%= document.attachment_filename %></p>
      <% if document.failed? %>
        <p class="text-sm m-0 mt-0.5">
          <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-danger"></span>Failed</span>
          <span class="text-stone-500"> — <%= document.error_message.presence || "Parsing error" %></span>
        </p>
      <% elsif document.processing? %>
        <p class="text-sm m-0 mt-0.5">
          <span class="yn-status yn-status-sm">
            <svg class="animate-spin w-3.5 h-3.5 text-stone-400" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" opacity="0.25"/>
              <path d="M14 8a6 6 0 0 0-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            Processing…
          </span>
        </p>
      <% else %>
        <p class="text-sm m-0 mt-0.5">
          <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-ok"></span>Success</span>
        </p>
      <% end %>
      <p class="text-[13px] text-stone-500 m-0 mt-0.5">Uploaded <%= time_ago_in_words(document.created_at) %> ago</p>
    </div>
    <% if document.failed? %>
      <div class="flex gap-2 shrink-0">
        <%= button_to "Retry", retry_source_document_path(document), method: :post, class: "yn-btn yn-btn-secondary yn-btn-sm" %>
        <%= button_to "Delete…", source_document_path(document), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this upload record?" }, class: "yn-btn yn-btn-ghost yn-btn-sm text-red-700" %>
      </div>
    <% end %>
  </div>
</div>
