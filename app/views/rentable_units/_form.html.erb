<%= form_with(model: [@property, rentable_unit], class: "space-y-4") do |form| %>
  <% if rentable_unit.errors.any? %>
    <div class="yn-alert yn-alert-danger" role="alert">
      <div>
        <h3 class="font-bold text-sm"><%= pluralize(rentable_unit.errors.count, "error") %> prohibited this rentable unit from being saved:</h3>
        <ul class="list-disc pl-5 mt-1 text-sm">
          <% rentable_unit.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Unit name", class: "yn-label" %>
    <%= form.text_field :name, class: "yn-input", required: true %>
  </div>

  <div>
    <%= form.label :unit_identifier, "Unit identifier (optional)", class: "yn-label" %>
    <%= form.text_field :unit_identifier, class: "yn-input" %>
  </div>

  <div>
    <%= form.label :square_footage, class: "yn-label" %>
    <%= form.number_field :square_footage, class: "yn-input" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :active, class: "rounded border-stone-300 text-stone-900 focus:ring-stone-400" %>
    <%= form.label :active, "Active Unit", class: "text-sm font-medium text-stone-700 select-none cursor-pointer" %>
  </div>

  <div class="pt-2">
    <%= form.submit (rentable_unit.persisted? ? "Save unit" : "Add unit"), class: "yn-btn yn-btn-primary w-full" %>
  </div>
<% end %>
