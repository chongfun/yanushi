<% content_for :title, "Editing #{@rentable_unit.name}" %>

<div class="max-w-xl mx-auto py-6">
  <h1 class="text-2xl font-bold tracking-tight text-stone-900 mb-6">Editing <%= @rentable_unit.name %></h1>

  <div class="bg-white border border-stone-200 rounded-lg p-6 mb-6">
    <%= render "form", rentable_unit: @rentable_unit %>
  </div>

  <div class="flex justify-between">
    <%= button_to "Deactivate / Delete Unit", [@property, @rentable_unit], method: :delete,
        class: "yn-btn yn-btn-danger yn-btn-sm",
        form: { data: { turbo_confirm: "Are you sure you want to deactivate or delete this unit?" } } %>
    <%= link_to "Back to Property", @property, class: "yn-btn yn-btn-ghost yn-btn-sm" %>
  </div>
</div>
