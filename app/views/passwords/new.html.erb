<% content_for :title, "Reset your password" %>

<%= render layout: "shared/auth_card", locals: { title: "Reset your password", meta: "We will email you a link to choose a new password.", footer: link_to("Back to sign in", new_session_path, class: "yn-link") } do %>
  <%= form_with url: passwords_path, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :email, "Email", class: "yn-label", for: "email" %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username",
            placeholder: "you@example.com", value: params[:email], class: "yn-input", id: "email" %>
    </div>

    <%= form.submit "Email reset instructions", class: "yn-btn yn-btn-primary w-full" %>
  <% end %>
<% end %>
