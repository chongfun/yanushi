<% content_for :title, "Choose a new password" %>

<%= render layout: "shared/auth_card", locals: { title: "Choose a new password", meta: "Use at least 8 characters." } do %>
  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :password, "New password", class: "yn-label", for: "password" %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password",
            maxlength: 72, class: "yn-input", id: "password" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Repeat new password", class: "yn-label", for: "password_confirmation" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
            maxlength: 72, class: "yn-input", id: "password_confirmation" %>
    </div>

    <%= form.submit "Save password", class: "yn-btn yn-btn-primary w-full" %>
  <% end %>
<% end %>
