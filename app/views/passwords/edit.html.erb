<div class="flex justify-center items-center min-h-[70vh]">
  <div class="w-full max-w-md bg-white border border-stone-200 rounded-lg p-8 shadow-sm">
    <h1 class="text-2xl font-bold tracking-tight text-stone-900 text-center mb-6">Update your password</h1>
    
    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :password, class: "yn-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter new password", maxlength: 72, class: "yn-input" %>
      </div>
      
      <div>
        <%= form.label :password_confirmation, class: "yn-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72, class: "yn-input" %>
      </div>
      
      <div class="pt-2">
        <%= form.submit "Save password", class: "yn-btn yn-btn-primary w-full" %>
      </div>
    <% end %>
  </div>
</div>
