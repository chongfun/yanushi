<div class="max-w-3xl mx-auto py-8">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold">Expense Details</h1>
      <p class="text-base-content/60">Reference: <%= dom_id(@expense) %></p>
    </div>
    <div class="flex gap-2 items-center">
      <%= link_to "Back to List", expenses_path, class: "btn btn-ghost" %>
      <% if @expense.active? %>
        <%= link_to "Correct Expense", correction_expense_path(@expense), class: "btn btn-outline btn-sm" %>
        <% if @expense.reimbursement_charges.active.exists? %>
          <div class="tooltip tooltip-bottom" data-tip="Void all active reimbursement charges before voiding this expense.">
            <button class="btn btn-outline btn-error btn-sm btn-disabled" disabled>Void Expense</button>
          </div>
        <% else %>
          <%= button_to "Void Expense", void_expense_path(@expense), method: :post,
              class: "btn btn-outline btn-error btn-sm",
              form: { data: { turbo_confirm: "Are you sure you want to void this expense? This will reverse its ledger entry at the original paid date." } } %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @expense.superseded? %>
    <div class="alert alert-warning mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      <div>
        <h3 class="font-bold">Expense Corrected</h3>
        <div class="text-xs">
          This expense was superseded by replacement <%= link_to "Expense ##{@expense.superseded_by_id}", expense_path(@expense.superseded_by_id), class: "link font-bold" %>
          on <%= @expense.voided_at&.strftime("%B %d, %Y") %>.
        </div>
      </div>
    </div>
  <% elsif @expense.voided? %>
    <div class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <h3 class="font-bold">Expense Voided</h3>
        <div class="text-xs">This expense was voided on <%= @expense.voided_at.strftime("%B %d, %Y at %I:%M %p") %> and its accounting entries have been reversed.</div>
      </div>
    </div>
  <% end %>

  <% if @expense.superseded_expense %>
    <div class="alert alert-info mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <h3 class="font-bold">Replacement Expense</h3>
        <div class="text-xs">
          This record replaces original <%= link_to "Expense ##{@expense.superseded_expense.id}", expense_path(@expense.superseded_expense), class: "link font-bold" %>.
        </div>
      </div>
    </div>
  <% end %>

  <div class="card bg-base-100 shadow-xl border border-base-200">
    <div class="card-body">
      <div class="flex flex-col md:flex-row justify-between gap-8">
        <!-- Expense Summary -->
        <div class="space-y-6 flex-1">
          <div>
            <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Amount</div>
            <div class="text-4xl font-bold <%= @expense.voided? ? 'line-through text-base-content/40' : 'text-error' %>">
              <%= number_to_currency(@expense.amount) %>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Paid On</div>
              <div class="text-lg font-medium"><%= @expense.paid_on.strftime("%B %d, %Y") %></div>
            </div>
            <div>
              <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Category</div>
              <div><span class="badge badge-warning badge-lg badge-outline font-medium"><%= @expense.expense_kind&.titleize %></span></div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Vendor</div>
              <div class="text-base font-medium"><%= @expense.vendor_name.presence || "—" %></div>
            </div>
            <div>
              <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Reference #</div>
              <div class="text-base font-mono"><%= @expense.external_reference.presence || "—" %></div>
            </div>
          </div>

          <% if @expense.description.present? %>
            <div>
              <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Description</div>
              <div class="text-base-content/80 bg-base-200 px-4 py-3 rounded-lg border border-base-300">
                <%= @expense.description %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="divider md:divider-horizontal"></div>

        <!-- Property / Scope Details -->
        <div class="space-y-6 flex-1">
          <div>
            <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Property</div>
            <div class="text-lg font-bold leading-tight"><%= @expense.property.address %></div>
            <div class="text-sm text-base-content/60 mt-1">
              Type: <%= @expense.property.asset_type.titleize %>
            </div>
          </div>

          <div>
            <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Unit Scope</div>
            <% if @expense.rentable_unit %>
              <span class="badge badge-info"><%= @expense.rentable_unit.display_name %></span>
            <% else %>
              <span class="badge badge-ghost">Property-wide / No specific unit</span>
            <% end %>
          </div>

          <div>
            <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Accounting Status</div>
            <% if @expense.superseded? %>
              <span class="badge badge-warning">Corrected (Superseded)</span>
            <% elsif @expense.voided? %>
              <span class="badge badge-error">Voided & Reversed</span>
            <% elsif @expense.posted? %>
              <span class="badge badge-success">Posted to Ledger</span>
            <% else %>
              <span class="badge badge-ghost">Unposted</span>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Reimbursements Section -->
      <div class="divider my-6">Tenant Reimbursements</div>

      <div class="space-y-4">
        <div class="flex justify-between items-center">
          <div>
            <h3 class="font-bold text-base">Reimbursement Charges</h3>
            <p class="text-xs text-base-content/60">
              Reimbursed: <%= number_to_currency(@expense.total_active_reimbursement_cents / 100.0) %> of <%= number_to_currency(@expense.amount) %>
              (<%= number_to_currency(@expense.remaining_reimbursable_amount) %> available)
            </p>
          </div>
          <% if @expense.active? %>
            <% if @expense.fully_reimbursed? %>
              <span class="badge badge-success">Fully Reimbursed</span>
            <% else %>
              <%= link_to "＋ Add Reimbursement Charge", new_expense_reimbursement_path(@expense), class: "btn btn-sm btn-primary" %>
            <% end %>
          <% end %>
        </div>

        <% reimbursements = @expense.reimbursement_charges.order(created_at: :asc) %>
        <% if reimbursements.any? %>
          <div class="overflow-x-auto">
            <table class="table table-zebra w-full text-sm">
              <thead>
                <tr>
                  <th>Tenancy</th>
                  <th>Date</th>
                  <th>Description</th>
                  <th class="text-right">Amount</th>
                  <th>Status</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% reimbursements.each do |charge| %>
                  <tr class="<%= 'opacity-60 bg-base-200/50' if charge.voided? %>">
                    <td>
                      <div class="font-medium"><%= charge.tenancy.rentable_unit.display_name %></div>
                      <div class="text-xs text-base-content/60">Tenancy #<%= charge.tenancy_id %></div>
                    </td>
                    <td><%= charge.charge_date.strftime("%b %d, %Y") %></td>
                    <td class="text-xs text-base-content/70 truncate max-w-xs"><%= charge.description %></td>
                    <td class="font-mono text-right font-medium <%= charge.voided? ? 'line-through text-base-content/40' : 'text-error' %>">
                      <%= number_to_currency(charge.amount) %>
                    </td>
                    <td>
                      <% if charge.superseded? %>
                        <span class="badge badge-xs badge-warning">Corrected</span>
                      <% elsif charge.voided? %>
                        <span class="badge badge-xs badge-error">Voided</span>
                      <% else %>
                        <span class="badge badge-xs badge-success">Active</span>
                      <% end %>
                    </td>
                    <td class="text-right flex justify-end gap-1 items-center">
                      <%= link_to "View", charge_path(charge), class: "btn btn-xs btn-ghost" %>
                      <% if charge.active? %>
                        <%= button_to "Void", void_charge_path(charge), method: :post,
                            class: "btn btn-xs btn-outline btn-error",
                            form: { data: { turbo_confirm: "Are you sure you want to void this reimbursement charge?" } } %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-xs text-base-content/60 p-4 bg-base-200/40 rounded-lg border border-base-300 text-center">
            No tenant reimbursement charges have been posted for this expense.
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
