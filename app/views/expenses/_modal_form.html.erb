<%# Modal form for creating an expense against a specific property %>
<% property ||= expense.property %>

<div class="mb-4 p-3 bg-base-200 rounded-box text-sm">
  <div class="flex justify-between">
    <span class="text-base-content/70">Property</span>
    <span class="font-semibold"><%= property.address %></span>
  </div>
</div>

<%= form_with(model: [property, expense], data: { turbo: true }) do |form| %>
  <% if expense.errors.any? %>
    <div class="alert alert-error mb-4">
      <ul>
        <% expense.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-control w-full mb-4">
    <%= form.label :rentable_unit_id, "Unit (Optional)", class: "label font-semibold" %>
    <%= form.collection_select :rentable_unit_id, property.rentable_units, :id, :display_name, { include_blank: "Entire property / No specific unit" }, { class: "select select-bordered w-full" } %>
  </div>

  <div class="form-control w-full mb-4">
    <%= form.label :expense_kind, "Category", class: "label font-semibold" %>
    <%= form.select :expense_kind, Expense::EXPENSE_KINDS.map { |k| [k.titleize, k] }, { prompt: "Select a category" }, class: "select select-bordered w-full", required: true %>
  </div>

  <div class="grid grid-cols-2 gap-4 mb-4">
    <div class="form-control w-full">
      <%= form.label :amount, "Amount ($)", class: "label font-semibold" %>
      <%= form.number_field :amount, step: "0.01", min: "0.01", class: "input input-bordered w-full", placeholder: "0.00", required: true %>
    </div>

    <div class="form-control w-full">
      <%= form.label :paid_on, "Date Paid", class: "label font-semibold" %>
      <%= form.date_field :paid_on, value: (expense.paid_on || Date.current), class: "input input-bordered w-full", required: true %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4 mb-4">
    <div class="form-control w-full">
      <%= form.label :vendor_name, "Vendor / Payee", class: "label font-semibold" %>
      <%= form.text_field :vendor_name, class: "input input-bordered w-full", placeholder: "e.g. Utility Co" %>
    </div>

    <div class="form-control w-full">
      <%= form.label :external_reference, "Invoice / Receipt #", class: "label font-semibold" %>
      <%= form.text_field :external_reference, class: "input input-bordered w-full", placeholder: "INV-123" %>
    </div>
  </div>

  <div class="form-control w-full mb-4">
    <%= form.label :description, class: "label font-semibold" %>
    <%= form.text_area :description, class: "textarea textarea-bordered w-full", rows: 2, placeholder: "Notes or description..." %>
  </div>

  <div class="flex gap-2 mt-6">
    <%= form.submit "Record Expense", class: "btn btn-primary flex-1" %>
    <button type="button" data-action="modal#close" class="btn btn-ghost">Cancel</button>
  </div>
<% end %>
