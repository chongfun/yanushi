<div class="max-w-xl mx-auto py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Correct Expense</h1>
    <%= link_to "Cancel", expense_path(@expense), class: "btn btn-ghost" %>
  </div>

  <div class="alert alert-warning mb-6">
    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
    <div>
      <h3 class="font-bold">Reversal & Replacement Notice</h3>
      <div class="text-xs">Correcting this expense will reverse the original ledger entry dated <%= @expense.paid_on.strftime("%B %d, %Y") %> and create a replacement record with the corrected facts.</div>
    </div>
  </div>

  <% if @expense.reimbursement_charges.active.exists? %>
    <div class="alert alert-info mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <h3 class="font-bold">Active Reimbursements Notice</h3>
        <div class="text-xs">
          <%= pluralize(@expense.reimbursement_charges.active.count, "active reimbursement charge") %>
          totalling <%= number_to_currency(@expense.reimbursement_charges.active.sum(:amount_cents) / 100.0) %>
          will be automatically restated to link to the corrected replacement expense.
        </div>
      </div>
    </div>
  <% end %>

  <div class="card bg-base-100 shadow-xl border border-base-200">
    <div class="card-body">
      <%= form_with(url: correct_expense_path(@expense), method: :post, local: true) do |form| %>
        <% if @expense.errors.any? %>
          <div class="alert alert-error shadow-lg mb-6 text-error-content">
            <div>
              <h3 class="font-bold"><%= pluralize(@expense.errors.count, "error") %> prohibited this correction from being saved:</h3>
              <ul class="list-disc list-inside mt-2 text-sm">
                <% @expense.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div data-controller="property-units"
             data-property-units-units-value="<%= @properties.each_with_object({}) { |p, h| h[p.id.to_s] = p.rentable_units.map { |u| { id: u.id, name: u.display_name } } }.to_json %>">
          <div class="form-control w-full mb-4">
            <label class="label font-semibold" for="expense_property_id">Property</label>
            <%= select_tag "expense[property_id]", options_from_collection_for_select(@properties, :id, :address, @expense.property_id), class: "select select-bordered w-full", id: "expense_property_id", required: true, data: { property_units_target: "propertySelect", action: "change->property-units#propertyChanged" } %>
          </div>

          <div class="form-control w-full mb-4">
            <label class="label font-semibold" for="expense_rentable_unit_id">Unit (Optional)</label>
            <%= select_tag "expense[rentable_unit_id]", options_from_collection_for_select(@expense.property.rentable_units, :id, :display_name, @expense.rentable_unit_id), include_blank: "Entire property / No specific unit", class: "select select-bordered w-full", id: "expense_rentable_unit_id", data: { property_units_target: "unitSelect", current_unit_id: @expense.rentable_unit_id } %>
          </div>
        </div>

        <div class="form-control w-full mb-4">
          <label class="label font-semibold" for="expense_expense_kind">Category</label>
          <%= select_tag "expense[expense_kind]", options_for_select(Expense::EXPENSE_KINDS.map { |k| [k.titleize, k] }, @expense.expense_kind), class: "select select-bordered w-full", id: "expense_expense_kind", required: true %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div class="form-control w-full">
            <label class="label font-semibold" for="expense_amount">Amount ($)</label>
            <%= number_field_tag "expense[amount]", sprintf("%.2f", @expense.amount), step: "0.01", min: "0.01", class: "input input-bordered w-full", id: "expense_amount", required: true %>
          </div>

          <div class="form-control w-full">
            <label class="label font-semibold" for="expense_paid_on">Date Paid</label>
            <%= date_field_tag "expense[paid_on]", @expense.paid_on, class: "input input-bordered w-full", id: "expense_paid_on", required: true %>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div class="form-control w-full">
            <label class="label font-semibold" for="expense_vendor_name">Vendor / Payee</label>
            <%= text_field_tag "expense[vendor_name]", @expense.vendor_name, class: "input input-bordered w-full", id: "expense_vendor_name" %>
          </div>

          <div class="form-control w-full">
            <label class="label font-semibold" for="expense_external_reference">Invoice / Receipt #</label>
            <%= text_field_tag "expense[external_reference]", @expense.external_reference, class: "input input-bordered w-full", id: "expense_external_reference" %>
          </div>
        </div>

        <div class="form-control w-full mb-6">
          <label class="label font-semibold" for="expense_description">Description</label>
          <%= text_area_tag "expense[description]", @expense.description, rows: 3, class: "textarea textarea-bordered w-full", id: "expense_description" %>
        </div>

        <div>
          <%= submit_tag "Post Corrected Expense", class: "btn btn-primary w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
