<tr id="<%= dom_id expense %>">
  <td class="font-medium text-stone-900">
    <%= expense.property.address %>
    <% if expense.rentable_unit %>
      <div class="text-xs text-stone-500"><%= expense.rentable_unit.display_name %></div>
    <% end %>
  </td>
  <td>
    <span class="text-xs font-mono text-stone-600"><%= expense.expense_kind&.titleize %></span>
  </td>
  <td class="font-mono tabular-nums"><%= number_to_currency(expense.amount) %></td>
  <td class="text-stone-500 text-sm whitespace-nowrap"><%= expense.paid_on.strftime("%b %-d, %Y") %></td>
  <td>
    <% if expense.superseded? %>
      <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-warn"></span>Corrected</span>
    <% elsif expense.voided? %>
      <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-danger"></span>Voided</span>
    <% elsif expense.posted? %>
      <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-ok"></span>Active</span>
    <% else %>
      <span class="yn-status yn-status-sm"><span class="yn-dot"></span>Pending</span>
    <% end %>
  </td>
  <td class="max-w-xs truncate text-sm text-stone-500"><%= expense.description %></td>
  <td class="text-right whitespace-nowrap">
    <%= link_to "View", expense, class: "yn-link text-[13px]" %>
  </td>
</tr>
