<tr id="<%= dom_id expense %>">
  <td class="font-medium">
    <%= expense.property.address %>
    <% if expense.rentable_unit %>
      <div class="text-xs text-base-content/60"><%= expense.rentable_unit.display_name %></div>
    <% end %>
  </td>
  <td>
    <span class="badge badge-ghost"><%= expense.expense_kind&.titleize %></span>
  </td>
  <td class="font-mono"><%= number_to_currency(expense.amount) %></td>
  <td><%= expense.paid_on %></td>
  <td>
    <% if expense.superseded? %>
      <span class="badge badge-warning badge-sm">Corrected</span>
    <% elsif expense.voided? %>
      <span class="badge badge-error badge-sm">Voided</span>
    <% elsif expense.posted? %>
      <span class="badge badge-success badge-sm">Active</span>
    <% else %>
      <span class="badge badge-ghost badge-sm">Pending</span>
    <% end %>
  </td>
  <td class="max-w-xs truncate text-sm text-base-content/60"><%= expense.description %></td>
  <td class="text-right">
    <%= link_to "View", expense, class: "btn btn-xs btn-ghost" %>
  </td>
</tr>
