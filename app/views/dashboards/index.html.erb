<div class="max-w-5xl space-y-10">
  <header>
    <h1 class="text-2xl font-semibold tracking-tight">Overview</h1>
    <p class="mt-1 text-sm text-stone-500"><%= Date.current.strftime("%A, %B %-d") %></p>
  </header>

  <!-- Needs attention -->
  <section aria-labelledby="attention-heading">
    <div class="flex items-baseline justify-between mb-3">
      <h2 id="attention-heading" class="text-sm font-semibold">
        Needs attention
        <% if @overview.attention_items.any? %>
          <span class="yn-count ml-1"><%= @overview.attention_items.size %></span>
        <% end %>
      </h2>
    </div>

    <% if @overview.attention_items.any? %>
      <div class="yn-surface divide-y divide-stone-200">
        <% @overview.attention_items.each do |item| %>
          <%= link_to item.path, class: "flex items-center gap-3 px-4 py-3 no-underline text-inherit hover:bg-stone-50 first:rounded-t-xl last:rounded-b-xl" do %>
            <span class="yn-dot <%= item.severity == :danger ? 'yn-dot-danger' : 'yn-dot-warn' %> mt-0.5"></span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-medium text-stone-900"><%= item.title %></span>
              <span class="block text-sm text-stone-500"><%= item.description %></span>
            </span>
            <span class="text-sm font-medium text-stone-500 whitespace-nowrap">
              <% if item.kind == :inbox_review %>
                Open Inbox &rarr;
              <% elsif item.kind == :balance_due %>
                Open tenancy &rarr;
              <% else %>
                View &rarr;
              <% end %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-stone-500 m-0">
        <span class="yn-status"><span class="yn-dot yn-dot-ok"></span>Nothing needs attention.</span>
      </p>
    <% end %>
  </section>

  <!-- Portfolio summary -->
  <section aria-labelledby="summary-heading">
    <h2 id="summary-heading" class="sr-only">Portfolio summary</h2>
    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-8 gap-y-4 border-y border-stone-200 py-4">
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Properties</dt>
        <dd class="mt-0.5 text-lg font-semibold tabular-nums m-0"><%= @overview.portfolio_summary.properties_count %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Units occupied</dt>
        <dd class="mt-0.5 text-lg font-semibold tabular-nums m-0">
          <%= @overview.portfolio_summary.occupied_units_count %>
          <span class="text-sm font-normal text-stone-500">of <%= @overview.portfolio_summary.total_units_count %></span>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Outstanding balances</dt>
        <dd class="mt-0.5 text-lg font-semibold tabular-nums m-0"><%= format_money_cents(@overview.portfolio_summary.outstanding_balances_cents) %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Net income, YTD</dt>
        <dd class="mt-0.5 text-lg font-semibold tabular-nums m-0"><%= signed_money_cents(@overview.portfolio_summary.net_income_cents) %></dd>
      </div>
    </dl>
  </section>

  <!-- Properties -->
  <section aria-labelledby="properties-heading">
    <div class="flex items-baseline justify-between mb-3">
      <h2 id="properties-heading" class="text-sm font-semibold">Properties</h2>
      <%= link_to "Portfolio →", portfolio_path, class: "yn-link text-sm" %>
    </div>

    <% if @overview.properties.any? %>
      <ul class="divide-y divide-stone-200 border-y border-stone-200 list-none m-0 p-0">
        <% @overview.properties.each do |row| %>
          <li>
            <%= link_to property_path(row.property), class: "flex items-center gap-4 py-3 no-underline text-inherit hover:bg-stone-50 px-1" do %>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-medium text-stone-900"><%= row.property.address %></span>
                <span class="block text-sm text-stone-500">
                  <% if row.total_units_count == 1 %>
                    1 unit &middot; <%= row.occupied_units_count == 1 ? "occupied" : "vacant" %>
                  <% else %>
                    <%= row.total_units_count %> units &middot; <%= row.occupied_units_count %> occupied, <%= row.total_units_count - row.occupied_units_count %> vacant
                  <% end %>
                </span>
              </span>
              <% if row.balance_cents.positive? %>
                <span class="text-sm text-stone-500 whitespace-nowrap tabular-nums"><%= format_money_cents(row.balance_cents) %> outstanding</span>
              <% elsif row.balance_cents.negative? %>
                <span class="text-sm text-stone-500 whitespace-nowrap tabular-nums"><%= format_money_cents(row.balance_cents.abs) %> credit</span>
              <% else %>
                <span class="yn-status yn-status-sm whitespace-nowrap"><span class="yn-dot yn-dot-ok"></span>Settled</span>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-stone-500 m-0">No properties added yet.</p>
    <% end %>
  </section>

  <!-- Recent activity -->
  <section aria-labelledby="recent-heading">
    <div class="flex items-baseline justify-between mb-3">
      <h2 id="recent-heading" class="text-sm font-semibold">Recent activity</h2>
    </div>

    <% if @overview.recent_activity.any? %>
      <div class="overflow-x-auto">
        <table class="yn-table">
          <thead class="sr-only">
            <tr>
              <th>Date</th>
              <th>Event</th>
              <th>Property</th>
              <th class="text-right">Amount</th>
            </tr>
          </thead>
          <tbody>
            <% @overview.recent_activity.each do |row| %>
              <tr>
                <td class="whitespace-nowrap text-stone-500 w-20"><%= row.occurred_on.strftime("%b %-d") %></td>
                <td>
                  <% target_path = row.source ? url_for(row.source) : journal_entry_path(row.journal_entry) rescue journal_entry_path(row.journal_entry) %>
                  <%= link_to target_path, class: "yn-row-link" do %>
                    <%= row.label %>
                    <% if row.rentable_unit %>
                      <span class="text-stone-400">&middot; <%= row.rentable_unit.name %></span>
                    <% end %>
                  <% end %>
                  <% if row.corrected? %>
                    <span class="yn-status yn-status-sm ml-1"><span class="yn-dot yn-dot-warn"></span>Corrected</span>
                  <% elsif row.voided? %>
                    <span class="yn-status yn-status-sm ml-1"><span class="yn-dot yn-dot-danger"></span>Voided</span>
                  <% end %>
                </td>
                <td class="text-stone-500"><%= row.property&.address %></td>
                <td class="text-right tabular-nums whitespace-nowrap"><%= format_money_cents(row.amount_cents.abs) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-stone-500 m-0">No recent activity recorded.</p>
    <% end %>
  </section>
</div>
