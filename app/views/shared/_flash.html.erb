<%# Toasts stack from the bottom-right corner so they never cover the page header actions. %>
<div id="flash-messages" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-md w-full pointer-events-none px-4 sm:px-0">
  <% flash.each do |key, message| %>
    <%= render partial: "shared/toast", locals: { type: key, message: message } %>
  <% end %>
</div>
