<%
  is_error = type.to_s.in?(%w[alert error])
  is_warn = type.to_s == "warning"
  is_ok = type.to_s.in?(%w[notice success])

  alert_class = if is_ok
                  "yn-alert-ok"
                elsif is_error
                  "yn-alert-danger"
                elsif is_warn
                  "yn-alert-warn"
                else
                  ""
                end

  aria_role = is_error ? "alert" : "status"
%>

<div class="yn-alert <%= alert_class %> shadow-lg pointer-events-auto flex items-center justify-between gap-3" role="<%= aria_role %>" data-controller="toast">
  <div class="flex items-center gap-2 min-w-0">
    <% if is_ok %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    <% elsif is_error %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    <% elsif is_warn %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
    <% else %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    <% end %>
    <span class="break-words font-medium"><%= message %></span>
  </div>
  <button type="button" class="yn-btn yn-btn-ghost yn-btn-sm shrink-0 -mr-1" data-action="toast#close" aria-label="Close notification">&times;</button>
</div>
