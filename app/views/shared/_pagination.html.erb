<%# Pagination for a server-paged collection. Renders nothing on a single page.
    Locals:
      page, per_page, total_count, total_pages
      page_url : lambda taking a page number and returning the URL for it
      aria_label : optional, defaults to "Pagination" %>
<% if total_pages.to_i > 1 %>
  <% start_idx = ((page - 1) * per_page) + 1 %>
  <% end_idx = [ page * per_page, total_count ].min %>
  <nav class="flex items-center justify-between mt-4" aria-label="<%= local_assigns.fetch(:aria_label, "Pagination") %>">
    <p class="text-sm text-stone-500 m-0">
      Showing <span class="tabular-nums"><%= start_idx %>–<%= end_idx %></span> of <span class="tabular-nums"><%= total_count %></span>
    </p>
    <div class="flex gap-2">
      <% if page > 1 %>
        <%= link_to "Previous", page_url.call(page - 1), class: "yn-btn yn-btn-secondary yn-btn-sm", rel: "prev" %>
      <% end %>
      <% if page < total_pages %>
        <%= link_to "Next", page_url.call(page + 1), class: "yn-btn yn-btn-secondary yn-btn-sm", rel: "next" %>
      <% end %>
    </div>
  </nav>
<% end %>
