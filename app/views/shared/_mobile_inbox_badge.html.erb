<%# Inbox count in the mobile top bar. Stable wrapper, streamed content: see
    shared/_inbox_badge. Local: count %>
<% count = local_assigns.fetch(:count) { inbox_reviewable_count } %>
<span id="mobile_inbox_badge" class="ml-auto inline-flex items-center" aria-live="polite" aria-atomic="true">
  <%= render "shared/mobile_inbox_badge_content", count: count %>
</span>
