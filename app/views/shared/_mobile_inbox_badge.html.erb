<% count = local_assigns.fetch(:count) { inbox_reviewable_count } %>
<span id="mobile_inbox_badge" class="ml-auto inline-flex items-center gap-1.5 text-sm font-medium text-stone-600 <%= 'hidden' if count.to_i <= 0 %>">
  <%= link_to inbox_path, class: "inline-flex items-center gap-1.5 text-stone-600 hover:text-stone-900 no-underline" do %>
    Inbox <span class="yn-count"><%= count %></span>
  <% end %>
</span>
