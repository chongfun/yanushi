<% content_for :title, "Chart of Accounts" %>

<div class="max-w-5xl mx-auto py-6">
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-stone-900">Chart of Accounts</h1>
    <p class="text-sm text-stone-500">System-defined double-entry ledger accounts</p>
  </div>

  <div class="overflow-x-auto border border-stone-200 rounded-lg bg-white">
    <table class="yn-table">
      <thead>
        <tr>
          <th scope="col">Account Name</th>
          <th scope="col">Key</th>
          <th scope="col">Type</th>
          <th scope="col" class="text-right">Natural Balance</th>
          <th scope="col" class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @accounts.each do |account| %>
          <% balance_cents = @balances[account.id] || 0 %>
          <tr>
            <td>
              <%= link_to account.name, account_path(account), class: "yn-row-link" %>
            </td>
            <td class="font-mono text-xs text-stone-500"><%= account.key %></td>
            <td>
              <span class="yn-status yn-status-sm">
                <span class="yn-dot <%= case account.account_type when 'asset', 'income' then 'yn-dot-ok' when 'liability', 'expense' then 'yn-dot-warn' else '' end %>"></span>
                <%= account.account_type.titleize %>
              </span>
            </td>
            <td class="text-right tabular-nums font-mono font-medium">
              <%= format_money_cents(balance_cents) %>
            </td>
            <td class="text-right">
              <%= link_to "View Ledger", account_path(account), class: "yn-link text-[13px]" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
