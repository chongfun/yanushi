<% content_for :title, "Chart of Accounts" %>

<div class="max-w-5xl">
  <%= render "shared/page_header",
        eyebrow: "Accounting",
        title: "Chart of Accounts",
        meta: "System-defined double-entry ledger accounts. Balances are shown in each account's natural direction." %>

  <div class="overflow-x-auto">
    <table class="yn-table">
      <thead>
        <tr>
          <th scope="col">Account</th>
          <th scope="col">Type</th>
          <th scope="col" class="text-right tabular-nums">Natural balance</th>
        </tr>
      </thead>
      <tbody>
        <% @accounts.each do |account| %>
          <% balance_cents = @balances[account.id] || 0 %>
          <tr>
            <td>
              <%= link_to account.name, account_path(account), class: "yn-row-link" %>
              <span class="block text-[13px] text-stone-500"><%= account.key %></span>
            </td>
            <td>
              <%= render "shared/status",
                    text: account.account_type.titleize,
                    tone: (%w[asset income].include?(account.account_type) ? :ok : (%w[liability expense].include?(account.account_type) ? :warn : :neutral)),
                    size: :sm %>
            </td>
            <td class="text-right tabular-nums whitespace-nowrap font-medium"><%= format_money_cents(balance_cents) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
