<%= form_with(model: party, data: { controller: "nested-form" }, class: "space-y-6") do |form| %>
  <% if party.errors.any? %>
    <div class="yn-alert yn-alert-danger" role="alert">
      <div>
        <h3 class="font-bold text-sm"><%= pluralize(party.errors.count, "error") %> prohibited this party from being saved:</h3>
        <ul class="list-disc pl-5 mt-1 text-sm">
          <% party.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="bg-white border border-stone-200 rounded-lg p-6">
    <h3 class="font-bold text-base text-stone-900 border-b border-stone-200 pb-3 mb-4">Contact Profile</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :display_name, "Legal or display name", class: "yn-label" %>
        <%= form.text_field :display_name, placeholder: "e.g. John Doe or Acme Corp", class: "yn-input", required: true %>
      </div>

      <div>
        <%= form.label :party_type, "Party type", class: "yn-label" %>
        <%= form.select :party_type, Party::PARTY_TYPES.map { |k| [k.titleize, k] }, {}, { class: "yn-select", required: true } %>
      </div>

      <div>
        <%= form.label :email_address, "Email", class: "yn-label" %>
        <%= form.email_field :email_address, placeholder: "john@example.com", class: "yn-input" %>
      </div>

      <div>
        <%= form.label :phone_number, "Phone", class: "yn-label" %>
        <%= form.text_field :phone_number, placeholder: "+15556661234", class: "yn-input" %>
      </div>

      <div class="md:col-span-2">
        <%= form.label :mailing_address, "Mailing address", class: "yn-label" %>
        <%= form.text_field :mailing_address, placeholder: "123 Main St", class: "yn-input" %>
      </div>
    </div>
  </div>

  <!-- Party Aliases (Dynamic Nested Fields) -->
  <div class="bg-white border border-stone-200 rounded-lg p-6">
    <div class="flex justify-between items-center border-b border-stone-200 pb-3 mb-4">
      <div>
        <h3 class="font-bold text-base text-stone-900">Payment Name Aliases</h3>
        <p class="text-xs text-stone-500 mt-0.5">Add other names (e.g. maiden name, abbreviations, @handles) this party might use on Zelle/Venmo payments.</p>
      </div>
      <button type="button" class="yn-btn yn-btn-secondary yn-btn-sm" data-action="nested-form#add">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        Add Alias
      </button>
    </div>

    <div class="space-y-3" data-nested-form-target="target">
      <%= form.fields_for :party_aliases do |alias_form| %>
        <div class="flex items-center gap-3" data-nested-form-wrapper data-new-record="false">
          <%= alias_form.hidden_field :_destroy %>
          <div class="w-full">
            <%= alias_form.text_field :alias_name, placeholder: "e.g. Jane S. Smith or @janesmith", class: "yn-input text-sm" %>
          </div>
          <button type="button" class="yn-btn yn-btn-danger yn-btn-sm shrink-0" data-action="nested-form#remove" aria-label="Remove alias">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 pointer-events-none" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.34 12m-4.72 0L9.34 9m1.28-6h3.707a1 1 0 0 1 .707.293l.586.586H18.5a1 1 0 0 1 0 2H5.5a1 1 0 0 1 0-2h2.929l.586-.586A1 1 0 0 1 9.73 3z" /></svg>
          </button>
        </div>
      <% end %>
    </div>

    <!-- Template for new alias fields -->
    <template data-nested-form-target="template">
      <%= form.fields_for :party_aliases, PartyAlias.new, child_index: "NEW_RECORD" do |alias_form| %>
        <div class="flex items-center gap-3 mt-3" data-nested-form-wrapper data-new-record="true">
          <div class="w-full">
            <%= alias_form.text_field :alias_name, placeholder: "e.g. Jane S. Smith or @janesmith", class: "yn-input text-sm" %>
          </div>
          <button type="button" class="yn-btn yn-btn-danger yn-btn-sm shrink-0" data-action="nested-form#remove" aria-label="Remove alias">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 pointer-events-none" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.34 12m-4.72 0L9.34 9m1.28-6h3.707a1 1 0 0 1 .707.293l.586.586H18.5a1 1 0 0 1 0 2H5.5a1 1 0 0 1 0-2h2.929l.586-.586A1 1 0 0 1 9.73 3z" /></svg>
          </button>
        </div>
      <% end %>
    </template>
  </div>

  <div class="flex justify-end gap-3 pt-2">
    <%= link_to "Cancel", parties_path, class: "yn-btn yn-btn-secondary" %>
    <%= form.submit (party.persisted? ? "Save party" : "Add party"), class: "yn-btn yn-btn-primary" %>
  </div>
<% end %>
