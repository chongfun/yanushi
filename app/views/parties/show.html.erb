<% content_for :title, @party.display_name %>

<div class="max-w-4xl mx-auto py-6">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-stone-900"><%= @party.display_name %></h1>
      <div class="flex gap-2 items-center mt-1">
        <span class="yn-status yn-status-sm"><span class="yn-dot"></span><%= @party.party_type.titleize %></span>
        <span class="text-xs text-stone-400">ID: <%= dom_id(@party) %></span>
      </div>
    </div>
    <div class="flex gap-2">
      <%= link_to "Back to List", parties_path, class: "yn-btn yn-btn-secondary yn-btn-sm" %>
      <%= link_to "Edit Profile", edit_party_path(@party), class: "yn-btn yn-btn-secondary yn-btn-sm" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Contact Info Card -->
    <div class="bg-white border border-stone-200 rounded-lg p-6 flex flex-col items-center text-center">
      <div class="w-16 h-16 rounded-full bg-stone-100 text-stone-700 flex items-center justify-center font-bold text-xl mb-3 border border-stone-200">
        <%= @party.display_name.split.map(&:first).join.upcase[0..1] %>
      </div>
      <h2 class="text-lg font-bold text-stone-900"><%= @party.display_name %></h2>
      
      <hr class="w-full border-stone-200 my-4">
      
      <div class="w-full space-y-4">
        <% if @party.email_address.present? %>
          <div class="text-left">
            <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Email</div>
            <%= mail_to @party.email_address, class: "flex items-center gap-2 yn-link" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span class="font-medium truncate"><%= @party.email_address %></span>
            <% end %>
          </div>
        <% end %>

        <% if @party.phone_number.present? %>
          <div class="text-left">
            <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Phone</div>
            <a href="tel:<%= @party.phone_number %>" class="flex items-center gap-2 yn-link">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span class="font-medium"><%= @party.phone_number %></span>
            </a>
          </div>
        <% end %>

        <div class="text-left">
          <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Mailing Address</div>
          <div class="text-sm leading-relaxed text-stone-700">
            <%= @party.mailing_address.presence || "No address on file" %>
          </div>
        </div>

        <div class="text-left">
          <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Payment Aliases</div>
          <div class="flex flex-wrap gap-1 mt-1">
            <% if @party.party_aliases.any? %>
              <% @party.party_aliases.each do |pa| %>
                <span class="text-xs font-mono text-stone-700 bg-stone-100 px-2 py-0.5 rounded border border-stone-200"><%= pa.alias_name %></span>
              <% end %>
            <% else %>
              <span class="text-xs text-stone-400">No aliases configured</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Tenancies List -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white border border-stone-200 rounded-lg p-6">
        <h3 class="font-bold text-base text-stone-900 mb-4">Tenancies & Agreements</h3>
        
        <% if @party.tenancies.any? %>
          <div class="space-y-3">
            <% @party.tenancy_parties.includes(tenancy: { rentable_unit: :property }).each do |tp| %>
              <% tenancy = tp.tenancy %>
              <div class="bg-stone-50 p-4 rounded-lg border border-stone-200 flex justify-between items-center">
                <div>
                  <div class="font-bold text-sm text-stone-900"><%= tenancy.property.address %> — <%= tenancy.rentable_unit.name %></div>
                  <div class="flex gap-2 items-center mt-1 text-xs">
                    <span class="text-xs font-medium text-stone-700 bg-white px-2 py-0.5 rounded border border-stone-200"><%= tp.role.titleize %></span>
                    <span class="text-stone-500">
                      <%= tp.effective_from.strftime("%b %d, %Y") %> - <%= tp.effective_until&.strftime("%b %d, %Y") || "Ongoing" %>
                    </span>
                  </div>
                </div>
                <%= link_to "View Tenancy", tenancy, class: "yn-link text-sm" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="yn-empty">
            <p class="yn-empty-body mb-0">This party currently has no tenancy agreements.</p>
          </div>
        <% end %>
      </div>

      <div class="bg-white border border-stone-200 rounded-lg overflow-hidden">
        <div class="p-4 flex justify-between items-center bg-stone-50">
          <div>
            <h4 class="font-bold text-sm text-stone-900">Danger Zone</h4>
            <p class="text-xs text-stone-500">Deleting a party record cannot be undone.</p>
          </div>
          <%= button_to "Delete Party", @party, method: :delete, 
              class: "yn-btn yn-btn-danger yn-btn-sm", 
              form: { data: { turbo_confirm: "Are you sure you want to delete this party? This action is irreversible." } } %>
        </div>
      </div>
    </div>
  </div>
</div>
