<%
  party = @party
  contact_lines = [ party.email_address.presence, party.phone_number.presence ].compact
%>
<% content_for :title, party.display_name %>

<div class="max-w-4xl">
  <%= render "shared/page_header",
        eyebrow: capture { %>
          <%= link_to "Portfolio", portfolio_path, class: "hover:text-stone-700 no-underline text-inherit" %>
          <span class="mx-1 text-stone-300">/</span>
          <%= link_to "Parties", parties_path, class: "hover:text-stone-700 no-underline text-inherit" %>
        <% },
        title: party.display_name,
        meta: capture { %>
          <%= party.party_type.humanize %>
          <% if contact_lines.any? %>&middot; <%= contact_lines.join(" · ") %><% end %>
        <% },
        actions: capture { %>
          <details class="relative" data-controller="menu">
            <summary class="yn-btn yn-btn-secondary list-none cursor-pointer">
              More
              <svg viewBox="0 0 16 16" class="w-3.5 h-3.5" fill="currentColor" aria-hidden="true"><path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z"/></svg>
            </summary>
            <div class="yn-menu">
              <%= button_to "Delete party…", party_path(party), method: :delete,
                    class: "yn-menu-item yn-menu-item-danger",
                    data: { turbo_confirm: "Delete #{party.display_name}? This cannot be undone, and it is only possible for a party with no tenancy history." } %>
            </div>
          </details>
          <%= link_to "Edit party", edit_party_path(party), class: "yn-btn yn-btn-primary" %>
        <% } %>

  <div class="space-y-10">
    <section aria-labelledby="party-contact-heading">
      <h2 id="party-contact-heading" class="text-sm font-semibold mb-3">Contact</h2>
      <dl class="text-sm divide-y divide-stone-200 border-y border-stone-200 max-w-xl">
        <div class="flex justify-between gap-6 py-2.5">
          <dt class="text-stone-500">Email</dt>
          <dd class="m-0 text-right">
            <%= party.email_address.present? ? mail_to(party.email_address, class: "yn-link") : "—" %>
          </dd>
        </div>
        <div class="flex justify-between gap-6 py-2.5">
          <dt class="text-stone-500">Phone</dt>
          <dd class="m-0 text-right">
            <% if party.phone_number.present? %>
              <a href="tel:<%= party.phone_number %>" class="yn-link"><%= party.phone_number %></a>
            <% else %>
              —
            <% end %>
          </dd>
        </div>
        <div class="flex justify-between gap-6 py-2.5">
          <dt class="text-stone-500">Mailing address</dt>
          <dd class="m-0 text-right"><%= party.mailing_address.presence || "—" %></dd>
        </div>
        <div class="flex justify-between gap-6 py-2.5">
          <dt class="text-stone-500">Payment aliases</dt>
          <dd class="m-0 text-right">
            <% if party.party_aliases.any? %>
              <%= party.party_aliases.map(&:alias_name).join(", ") %>
            <% else %>
              <span class="text-stone-500">None. Imports match this party by name.</span>
            <% end %>
          </dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="party-tenancies-heading">
      <h2 id="party-tenancies-heading" class="text-sm font-semibold mb-3">Tenancies</h2>

      <% if @tenancy_participations.any? %>
        <div class="overflow-x-auto">
          <table class="yn-table">
            <thead>
              <tr>
                <th scope="col">Property / Unit</th>
                <th scope="col">Role</th>
                <th scope="col">Participating</th>
              </tr>
            </thead>
            <tbody>
              <% @tenancy_participations.each do |tp| %>
                <% tenancy = tp.tenancy %>
                <tr>
                  <td>
                    <%= link_to tenancy.property.address, tenancy_path(tenancy), class: "yn-row-link" %>
                    <span class="block text-[13px] text-stone-500"><%= tenancy.rentable_unit.display_name %></span>
                  </td>
                  <td><%= tp.role.humanize %></td>
                  <td class="text-stone-500 whitespace-nowrap">
                    <%= tp.effective_from.strftime("%b %-d, %Y") %> –
                    <%= tp.effective_until&.strftime("%b %-d, %Y") || "present" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <%= render "shared/empty_state",
              title: "No tenancies yet",
              body: "This party is not on any tenancy. Add them as a participant from a tenancy's Agreement tab.",
              action: link_to("Browse tenancies", tenancies_path, class: "yn-btn yn-btn-secondary yn-btn-sm") %>
      <% end %>
    </section>
  </div>
</div>
