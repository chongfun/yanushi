<% content_for :title, "Edit security deposit requirement" %>

<div class="max-w-xl">
  <%= render "tenancies/page_header", tenancy: @tenancy, title: "Edit security deposit requirement" %>
  <div class="yn-surface p-6">
    <p class="text-sm text-stone-500 mt-0 mb-5">The requirement can change until the first deposit transaction is recorded.</p>
    <%= render "security_deposits/form", security_deposit: @security_deposit,
               submit_label: "Update requirement", cancel_path: tenancy_security_deposit_path(@tenancy) %>
  </div>
</div>
