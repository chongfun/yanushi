<% content_for :title, "Edit Security Deposit — Tenancy ##{@tenancy.id}" %>

<div class="max-w-xl mx-auto py-6">
  <div class="bg-white border border-stone-200 rounded-lg p-6">
    <h1 class="text-2xl font-bold tracking-tight text-stone-900 mb-2">Edit Security Deposit Requirement</h1>
    <p class="text-sm text-stone-500 mb-6">Modify the contractual deposit terms before transactions have been recorded.</p>

    <%= form_with model: @security_deposit, url: tenancy_security_deposit_path(@tenancy), method: :patch, class: "space-y-4" do |f| %>
      <% if @security_deposit.errors.any? %>
        <div class="yn-alert yn-alert-danger mb-6" role="alert">
          <ul class="list-disc list-inside text-sm">
            <% @security_deposit.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <label class="yn-label" for="security_deposit_required_amount">
          <span>Required Deposit Amount ($)</span>
        </label>
        <%= f.number_field :required_amount, step: "0.01", min: "0.01", value: sprintf("%.2f", @security_deposit.required_amount), class: "yn-input font-mono tabular-nums", id: "security_deposit_required_amount", required: true %>
      </div>

      <div>
        <label class="yn-label" for="security_deposit_due_on">
          <span>Due Date</span>
        </label>
        <%= f.date_field :due_on, value: @security_deposit.due_on, class: "yn-input", id: "security_deposit_due_on", required: true %>
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <%= link_to "Cancel", tenancy_security_deposit_path(@tenancy), class: "yn-btn yn-btn-secondary" %>
        <%= f.submit "Update Requirement", class: "yn-btn yn-btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
