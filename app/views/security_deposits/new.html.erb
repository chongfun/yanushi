<% content_for :title, "Set up security deposit" %>

<div class="max-w-xl">
  <%= render "tenancies/page_header", tenancy: @tenancy, title: "Set up security deposit" %>
  <div class="yn-surface p-6">
    <p class="text-sm text-stone-500 mt-0 mb-5">Record the deposit this tenancy is required to hold. Money received against it is tracked as a liability, separate from rent.</p>
    <%= render "security_deposits/form", security_deposit: @security_deposit,
               submit_label: "Save deposit requirement", cancel_path: tenancy_path(@tenancy) %>
  </div>
</div>
