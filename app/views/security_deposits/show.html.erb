<% content_for :title, "Security deposit · #{@tenancy.rentable_unit.display_name}" %>

<div class="max-w-5xl">
  <%= render "tenancies/page_header",
        tenancy: @tenancy,
        title: "Security deposit",
        actions: (@transactions.none? ? link_to("Edit requirement", edit_tenancy_security_deposit_path(@tenancy), class: "yn-btn yn-btn-secondary") : nil) %>

  <% failed = @failed_action %>

  <!-- Summary -->
  <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-8 gap-y-4 border-y border-stone-200 py-4 mb-8">
    <div>
      <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Required</dt>
      <dd class="mt-0.5 text-lg font-semibold tabular-nums m-0"><%= format_money_cents(@security_deposit.required_amount_cents) %></dd>
      <dd class="text-xs text-stone-500 m-0">Due <%= @security_deposit.due_on.strftime("%b %-d, %Y") %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Currently held</dt>
      <dd class="mt-0.5 text-lg font-semibold tabular-nums m-0"><%= format_money_cents(@held_cents) %></dd>
      <dd class="text-xs text-stone-500 m-0">Ledger liability</dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Remaining due</dt>
      <dd class="mt-0.5 text-lg font-semibold tabular-nums m-0"><%= format_money_cents(@remaining_required_cents) %></dd>
      <dd class="text-xs text-stone-500 m-0">To fulfill requirement</dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Funding status</dt>
      <dd class="mt-1 m-0">
        <% if @funding_status == "funded" %>
          <%= render "shared/status", text: "Funded", tone: :ok, size: :sm %>
        <% elsif @funding_status == "partially_funded" %>
          <%= render "shared/status", text: "Partially Funded", tone: :warn, size: :sm %>
        <% elsif @funding_status == "overfunded" %>
          <%= render "shared/status", text: "Overfunded", size: :sm %>
        <% else %>
          <%= render "shared/status", text: "Not Funded", tone: :danger, size: :sm %>
        <% end %>
      </dd>
    </div>
  </dl>

  <!-- Action Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Receive Deposit Card -->
    <div class="yn-surface p-6">
      <h2 class="text-sm font-semibold text-stone-900 mb-1">Record Deposit Payment</h2>
      <p class="text-xs text-stone-500 mb-4">Record money received toward this security deposit liability.</p>
      <% if failed == :receive %>
        <div class="yn-alert yn-alert-danger text-sm mb-3" role="alert" id="receive_error"><%= @failed_error %></div>
      <% end %>

      <%= form_with url: receive_tenancy_security_deposit_path(@tenancy), method: :post, class: "space-y-3" do |f| %>
        <div>
          <label class="yn-label text-xs font-semibold" for="receive_party_id">Contributor (Payer)</label>
          <%= select_tag :party_id, options_from_collection_for_select(@parties, :id, :display_name, (failed == :receive ? params[:party_id] : nil)), class: "yn-select text-sm py-1.5", id: "receive_party_id", required: true %>
        </div>

        <div>
          <label class="yn-label text-xs font-semibold" for="receive_amount">Amount ($)</label>
          <%= number_field_tag :amount, (failed == :receive ? params[:amount] : sprintf("%.2f", (@remaining_required_cents > 0 ? @remaining_required_cents : 10_000) / 100.0)), step: "0.01", min: "0.01", class: "yn-input text-sm py-1.5 tabular-nums", id: "receive_amount", required: true, "aria-invalid": (failed == :receive ? "true" : nil), "aria-describedby": (failed == :receive ? "receive_error" : nil) %>
        </div>

        <div>
          <label class="yn-label text-xs font-semibold" for="receive_occurred_on">Received On</label>
          <%= date_field_tag :occurred_on, (failed == :receive ? params[:occurred_on] : Date.current), class: "yn-input text-sm py-1.5", id: "receive_occurred_on", required: true %>
        </div>

        <div>
          <label class="yn-label text-xs font-semibold" for="receive_external_reference">Reference (Optional)</label>
          <%= text_field_tag :external_reference, (failed == :receive ? params[:external_reference] : nil), placeholder: "Check #, wire ref", class: "yn-input text-sm py-1.5", id: "receive_external_reference" %>
        </div>

        <div>
          <label class="yn-label text-xs font-semibold" for="receive_memo">Memo (Optional)</label>
          <%= text_field_tag :memo, (failed == :receive ? params[:memo] : nil), placeholder: "Security deposit receipt", class: "yn-input text-sm py-1.5", id: "receive_memo" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Record Deposit", class: "yn-btn yn-btn-primary yn-btn-sm w-full" %>
        </div>
      <% end %>
    </div>

    <!-- Refund Deposit Card -->
    <div class="yn-surface p-6">
      <h2 class="text-sm font-semibold text-stone-900 mb-1">Refund Deposit</h2>
      <p class="text-xs text-stone-500 mb-4">Return held deposit funds to a tenant or contributor.</p>
      <% if failed == :refund %>
        <div class="yn-alert yn-alert-danger text-sm mb-3" role="alert" id="refund_error"><%= @failed_error %></div>
      <% end %>

      <% if @held_cents > 0 %>
        <%= form_with url: refund_tenancy_security_deposit_path(@tenancy), method: :post, class: "space-y-3" do |f| %>
          <div>
            <label class="yn-label text-xs font-semibold" for="refund_party_id">Recipient</label>
            <%= select_tag :party_id, options_from_collection_for_select(@parties, :id, :display_name, (failed == :refund ? params[:party_id] : nil)), class: "yn-select text-sm py-1.5", id: "refund_party_id", required: true %>
          </div>

          <div>
            <label class="yn-label text-xs font-semibold" for="refund_amount">Amount ($), up to <%= format_money_cents(@held_cents) %></label>
            <%= number_field_tag :amount, (failed == :refund ? params[:amount] : sprintf("%.2f", @held_cents / 100.0)), step: "0.01", min: "0.01", max: sprintf("%.2f", @held_cents / 100.0), class: "yn-input text-sm py-1.5 tabular-nums", id: "refund_amount", required: true, "aria-invalid": (failed == :refund ? "true" : nil), "aria-describedby": (failed == :refund ? "refund_error" : nil) %>
          </div>

          <div>
            <label class="yn-label text-xs font-semibold" for="refund_occurred_on">Refunded On</label>
            <%= date_field_tag :occurred_on, (failed == :refund ? params[:occurred_on] : Date.current), class: "yn-input text-sm py-1.5", id: "refund_occurred_on", required: true %>
          </div>

          <div>
            <label class="yn-label text-xs font-semibold" for="refund_external_reference">Reference (Optional)</label>
            <%= text_field_tag :external_reference, (failed == :refund ? params[:external_reference] : nil), placeholder: "Check #, wire ref", class: "yn-input text-sm py-1.5", id: "refund_external_reference" %>
          </div>

          <div>
            <label class="yn-label text-xs font-semibold" for="refund_memo">Memo (Optional)</label>
            <%= text_field_tag :memo, (failed == :refund ? params[:memo] : nil), placeholder: "Deposit refund at move-out", class: "yn-input text-sm py-1.5", id: "refund_memo" %>
          </div>

          <div class="pt-2">
            <%= f.submit "Record Refund", class: "yn-btn yn-btn-secondary yn-btn-sm w-full" %>
          </div>
        <% end %>
      <% else %>
        <div class="yn-alert text-xs" role="status">
          No deposit funds are currently held to refund.
        </div>
      <% end %>
    </div>

    <!-- Apply Deposit Card -->
    <div class="yn-surface p-6">
      <h2 class="text-sm font-semibold text-stone-900 mb-1">Apply Deposit to Charge</h2>
      <p class="text-xs text-stone-500 mb-4">Apply held deposit toward an active charge (damages, rent, late fee).</p>
      <% if failed == :apply %>
        <div class="yn-alert yn-alert-danger text-sm mb-3" role="alert" id="apply_error"><%= @failed_error %></div>
      <% end %>

      <% if @held_cents > 0 && @balance_cents > 0 && @active_charges.any? %>
        <%= form_with url: apply_tenancy_security_deposit_path(@tenancy), method: :post, class: "space-y-3" do |f| %>
          <div>
            <label class="yn-label text-xs font-semibold" for="apply_charge_id">Select Active Charge</label>
            <select name="charge_id" id="apply_charge_id" class="yn-select text-sm py-1.5" required>
              <% @active_charges.each do |c| %>
                <% cap_cents = [c.remaining_deposit_application_cents, @held_cents, @balance_cents].min %>
                <option value="<%= c.id %>"<%= " selected" if failed == :apply && params[:charge_id].to_s == c.id.to_s %>>
                  <%= c.charge_date.strftime("%b %d, %Y") %> — <%= c.description || c.charge_kind.titleize %> (<%= format_money_cents(c.amount_cents) %>, up to <%= format_money_cents(cap_cents) %>)
                </option>
              <% end %>
            </select>
          </div>

          <div>
            <label class="yn-label text-xs font-semibold" for="apply_amount">Amount to Apply ($)</label>
            <%= number_field_tag :amount, (failed == :apply ? params[:amount] : sprintf("%.2f", [@held_cents, @balance_cents].min / 100.0)), step: "0.01", min: "0.01", class: "yn-input text-sm py-1.5 tabular-nums", id: "apply_amount", required: true, "aria-invalid": (failed == :apply ? "true" : nil), "aria-describedby": (failed == :apply ? "apply_error" : nil) %>
          </div>

          <div>
            <label class="yn-label text-xs font-semibold" for="apply_occurred_on">Application Date</label>
            <%= date_field_tag :occurred_on, (failed == :apply ? params[:occurred_on] : Date.current), class: "yn-input text-sm py-1.5", id: "apply_occurred_on", required: true %>
          </div>

          <div>
            <label class="yn-label text-xs font-semibold" for="apply_memo">Memo (Optional)</label>
            <%= text_field_tag :memo, (failed == :apply ? params[:memo] : nil), placeholder: "Deposit deduction for repairs", class: "yn-input text-sm py-1.5", id: "apply_memo" %>
          </div>

          <div class="pt-2">
            <%= f.submit "Apply Deposit", class: "yn-btn yn-btn-primary yn-btn-sm w-full" %>
          </div>
        <% end %>
      <% else %>
        <div class="yn-alert text-xs" role="status">
          <% if @held_cents <= 0 %>
            No deposit funds are currently held.
          <% elsif @balance_cents <= 0 %>
            Tenancy has no outstanding balance ($0.00).
          <% else %>
            No active posted charges to apply against.
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Transaction History Table -->
  <div class="yn-surface p-6">
    <h2 class="text-sm font-semibold text-stone-900 mb-4">Deposit Transaction History</h2>

    <div class="overflow-x-auto">
      <table class="yn-table">
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Kind</th>
            <th scope="col">Party / Charge</th>
            <th scope="col">Reference / Memo</th>
            <th scope="col" class="text-right">Amount</th>
            <th scope="col">Status</th>
            <th scope="col" class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @transactions.any? %>
            <% @transactions.each do |txn| %>
              <tr class="<%= 'opacity-60 bg-stone-50' if txn.voided? %>">
                <td class="text-sm font-medium whitespace-nowrap"><%= txn.occurred_on.strftime("%b %d, %Y") %></td>
                <td>
                  <span class="text-xs uppercase tracking-wider text-stone-600">
                    <%= txn.transaction_kind.titleize %>
                  </span>
                </td>
                <td class="text-sm">
                  <% if txn.received? || txn.refunded? %>
                    <%= txn.party&.display_name %>
                  <% elsif txn.applied? %>
                    <%= link_to "Charge ##{txn.charge_id}: #{txn.charge&.description || txn.charge&.charge_kind&.titleize}", charge_path(txn.charge_id), class: "yn-link" if txn.charge_id %>
                  <% end %>
                </td>
                <td class="text-xs text-stone-500">
                  <%= txn.external_reference.present? ? "[#{txn.external_reference}] " : "" %>
                  <%= txn.memo || "—" %>
                </td>
                <td class="text-right tabular-nums font-medium <%= txn.voided? ? 'line-through text-stone-400' : 'text-stone-900' %>">
                  <%= signed_money_cents(txn.received? ? txn.amount_cents : -txn.amount_cents, plus: true) %>
                </td>
                <td>
                  <% if txn.superseded? %>
                    <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-warn"></span>Corrected</span>
                  <% elsif txn.voided? %>
                    <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-danger"></span>Voided</span>
                  <% elsif txn.superseded_transaction.present? %>
                    <span class="yn-status yn-status-sm"><span class="yn-dot"></span>Replacement</span>
                  <% else %>
                    <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-ok"></span>Active</span>
                  <% end %>
                </td>
                <td class="text-right whitespace-nowrap">
                  <%= link_to "View", security_deposit_transaction_path(txn), class: "yn-link text-[13px]" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="text-center py-6 text-stone-500">
                No deposit transactions recorded yet.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
