<% content_for :title, "Security Deposit — Tenancy ##{@tenancy.id}" %>

<div class="max-w-5xl mx-auto py-6">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-stone-900">Security Deposit</h1>
      <p class="text-sm text-stone-500"><%= @tenancy.property.address %> — <%= @tenancy.rentable_unit.display_name %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Back to Tenancy", tenancy_path(@tenancy), class: "yn-btn yn-btn-secondary yn-btn-sm" %>
      <% if @transactions.none? %>
        <%= link_to "Edit Requirement", edit_tenancy_security_deposit_path(@tenancy), class: "yn-btn yn-btn-secondary yn-btn-sm" %>
      <% end %>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white border border-stone-200 rounded-lg p-4">
      <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Required</div>
      <div class="text-2xl font-bold font-mono tabular-nums text-stone-900"><%= number_to_currency(@security_deposit.required_amount) %></div>
      <div class="text-xs text-stone-400 mt-1">Due: <%= @security_deposit.due_on.strftime("%b %d, %Y") %></div>
    </div>

    <div class="bg-white border border-stone-200 rounded-lg p-4">
      <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Currently Held</div>
      <div class="text-2xl font-bold font-mono tabular-nums text-indigo-600"><%= number_to_currency(@security_deposit.held_amount) %></div>
      <div class="text-xs text-stone-400 mt-1">Ledger liability</div>
    </div>

    <div class="bg-white border border-stone-200 rounded-lg p-4">
      <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Remaining Due</div>
      <div class="text-2xl font-bold font-mono tabular-nums <%= @security_deposit.remaining_required_amount > 0 ? 'text-amber-600' : 'text-emerald-600' %>">
        <%= number_to_currency(@security_deposit.remaining_required_amount) %>
      </div>
      <div class="text-xs text-stone-400 mt-1">To fulfill requirement</div>
    </div>

    <div class="bg-white border border-stone-200 rounded-lg p-4">
      <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Funding Status</div>
      <div class="mt-1">
        <% case @security_deposit.funding_status %>
        <% when "funded" %>
          <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-ok"></span>Funded</span>
        <% when "partially_funded" %>
          <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-warn"></span>Partially Funded</span>
        <% when "overfunded" %>
          <span class="yn-status yn-status-sm"><span class="yn-dot"></span>Overfunded</span>
        <% else %>
          <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-danger"></span>Not Funded</span>
        <% end %>
      </div>
      <div class="text-xs text-stone-400 mt-1">Contractual state</div>
    </div>
  </div>

  <!-- Action Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Receive Deposit Card -->
    <div class="bg-white border border-stone-200 rounded-lg p-6">
      <h2 class="text-base font-bold text-stone-900 mb-1">Record Deposit Payment</h2>
      <p class="text-xs text-stone-500 mb-4">Record money received toward this security deposit liability.</p>

      <%= form_with url: receive_tenancy_security_deposit_path(@tenancy), method: :post, local: true, class: "space-y-3" do |f| %>
        <div>
          <label class="yn-label text-xs font-semibold" for="receive_party_id">Contributor (Payer)</label>
          <%= select_tag :party_id, options_from_collection_for_select(@parties, :id, :display_name), class: "yn-select text-sm py-1.5", id: "receive_party_id", required: true %>
        </div>

        <div>
          <label class="yn-label text-xs font-semibold" for="receive_amount">Amount ($)</label>
          <%= number_field_tag :amount, sprintf("%.2f", @security_deposit.remaining_required_amount > 0 ? @security_deposit.remaining_required_amount : 100.0), step: "0.01", min: "0.01", class: "yn-input text-sm py-1.5 font-mono tabular-nums", id: "receive_amount", required: true %>
        </div>

        <div>
          <label class="yn-label text-xs font-semibold" for="receive_occurred_on">Received On</label>
          <%= date_field_tag :occurred_on, Date.current, class: "yn-input text-sm py-1.5", id: "receive_occurred_on", required: true %>
        </div>

        <div>
          <label class="yn-label text-xs font-semibold" for="receive_external_reference">Reference (Optional)</label>
          <%= text_field_tag :external_reference, nil, placeholder: "Check #, wire ref", class: "yn-input text-sm py-1.5", id: "receive_external_reference" %>
        </div>

        <div>
          <label class="yn-label text-xs font-semibold" for="receive_memo">Memo (Optional)</label>
          <%= text_field_tag :memo, nil, placeholder: "Security deposit receipt", class: "yn-input text-sm py-1.5", id: "receive_memo" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Record Deposit", class: "yn-btn yn-btn-primary yn-btn-sm w-full" %>
        </div>
      <% end %>
    </div>

    <!-- Refund Deposit Card -->
    <div class="bg-white border border-stone-200 rounded-lg p-6">
      <h2 class="text-base font-bold text-stone-900 mb-1">Refund Deposit</h2>
      <p class="text-xs text-stone-500 mb-4">Return held deposit funds to a tenant or contributor.</p>

      <% if @security_deposit.held_cents > 0 %>
        <%= form_with url: refund_tenancy_security_deposit_path(@tenancy), method: :post, local: true, class: "space-y-3" do |f| %>
          <div>
            <label class="yn-label text-xs font-semibold" for="refund_party_id">Recipient</label>
            <%= select_tag :party_id, options_from_collection_for_select(@parties, :id, :display_name), class: "yn-select text-sm py-1.5", id: "refund_party_id", required: true %>
          </div>

          <div>
            <label class="yn-label text-xs font-semibold" for="refund_amount">Amount ($) — Max: <%= number_to_currency(@security_deposit.held_amount) %></label>
            <%= number_field_tag :amount, sprintf("%.2f", @security_deposit.held_amount), step: "0.01", min: "0.01", max: sprintf("%.2f", @security_deposit.held_amount), class: "yn-input text-sm py-1.5 font-mono tabular-nums", id: "refund_amount", required: true %>
          </div>

          <div>
            <label class="yn-label text-xs font-semibold" for="refund_occurred_on">Refunded On</label>
            <%= date_field_tag :occurred_on, Date.current, class: "yn-input text-sm py-1.5", id: "refund_occurred_on", required: true %>
          </div>

          <div>
            <label class="yn-label text-xs font-semibold" for="refund_external_reference">Reference (Optional)</label>
            <%= text_field_tag :external_reference, nil, placeholder: "Check #, wire ref", class: "yn-input text-sm py-1.5", id: "refund_external_reference" %>
          </div>

          <div>
            <label class="yn-label text-xs font-semibold" for="refund_memo">Memo (Optional)</label>
            <%= text_field_tag :memo, nil, placeholder: "Deposit refund at move-out", class: "yn-input text-sm py-1.5", id: "refund_memo" %>
          </div>

          <div class="pt-2">
            <%= f.submit "Record Refund", class: "yn-btn yn-btn-secondary yn-btn-sm w-full" %>
          </div>
        <% end %>
      <% else %>
        <div class="yn-alert text-xs" role="status">
          No deposit funds are currently held to refund.
        </div>
      <% end %>
    </div>

    <!-- Apply Deposit Card -->
    <div class="bg-white border border-stone-200 rounded-lg p-6">
      <h2 class="text-base font-bold text-stone-900 mb-1">Apply Deposit to Charge</h2>
      <p class="text-xs text-stone-500 mb-4">Apply held deposit toward an active charge (damages, rent, late fee).</p>

      <% if @security_deposit.held_cents > 0 && @tenancy.current_balance > 0 && @active_charges.any? %>
        <%= form_with url: apply_tenancy_security_deposit_path(@tenancy), method: :post, local: true, class: "space-y-3" do |f| %>
          <div>
            <label class="yn-label text-xs font-semibold" for="apply_charge_id">Select Active Charge</label>
            <select name="charge_id" id="apply_charge_id" class="yn-select text-sm py-1.5" required>
              <% @active_charges.each do |c| %>
                <% cap = [c.remaining_deposit_application_cents, @security_deposit.held_cents, @tenancy.current_balance_cents].min / 100.0 %>
                <option value="<%= c.id %>">
                  <%= c.charge_date.strftime("%b %d, %Y") %> — <%= c.description || c.charge_kind.titleize %> (<%= number_to_currency(c.amount) %>, Max: <%= number_to_currency(cap) %>)
                </option>
              <% end %>
            </select>
          </div>

          <div>
            <label class="yn-label text-xs font-semibold" for="apply_amount">Amount to Apply ($)</label>
            <%= number_field_tag :amount, sprintf("%.2f", [@security_deposit.held_amount, @tenancy.current_balance].min), step: "0.01", min: "0.01", class: "yn-input text-sm py-1.5 font-mono tabular-nums", id: "apply_amount", required: true %>
          </div>

          <div>
            <label class="yn-label text-xs font-semibold" for="apply_occurred_on">Application Date</label>
            <%= date_field_tag :occurred_on, Date.current, class: "yn-input text-sm py-1.5", id: "apply_occurred_on", required: true %>
          </div>

          <div>
            <label class="yn-label text-xs font-semibold" for="apply_memo">Memo (Optional)</label>
            <%= text_field_tag :memo, nil, placeholder: "Deposit deduction for repairs", class: "yn-input text-sm py-1.5", id: "apply_memo" %>
          </div>

          <div class="pt-2">
            <%= f.submit "Apply Deposit", class: "yn-btn yn-btn-primary yn-btn-sm w-full" %>
          </div>
        <% end %>
      <% else %>
        <div class="yn-alert text-xs" role="status">
          <% if @security_deposit.held_cents <= 0 %>
            No deposit funds are currently held.
          <% elsif @tenancy.current_balance <= 0 %>
            Tenancy has no outstanding balance ($0.00).
          <% else %>
            No active posted charges to apply against.
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Transaction History Table -->
  <div class="bg-white border border-stone-200 rounded-lg p-6">
    <h2 class="text-base font-bold text-stone-900 mb-4">Deposit Transaction History</h2>

    <div class="overflow-x-auto">
      <table class="yn-table">
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Kind</th>
            <th scope="col">Party / Charge</th>
            <th scope="col">Reference / Memo</th>
            <th scope="col" class="text-right">Amount</th>
            <th scope="col">Status</th>
            <th scope="col" class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @transactions.any? %>
            <% @transactions.each do |txn| %>
              <tr class="<%= 'opacity-60 bg-stone-50' if txn.voided? %>">
                <td class="text-sm font-medium whitespace-nowrap"><%= txn.occurred_on.strftime("%b %d, %Y") %></td>
                <td>
                  <span class="text-xs font-mono uppercase text-stone-600">
                    <%= txn.transaction_kind.titleize %>
                  </span>
                </td>
                <td class="text-sm">
                  <% if txn.received? || txn.refunded? %>
                    <%= txn.party&.display_name %>
                  <% elsif txn.applied? %>
                    <%= link_to "Charge ##{txn.charge_id}: #{txn.charge&.description || txn.charge&.charge_kind&.titleize}", charge_path(txn.charge_id), class: "yn-link" if txn.charge_id %>
                  <% end %>
                </td>
                <td class="text-xs text-stone-500">
                  <%= txn.external_reference.present? ? "[#{txn.external_reference}] " : "" %>
                  <%= txn.memo || "—" %>
                </td>
                <td class="font-mono font-bold text-right tabular-nums <%= txn.voided? ? 'line-through text-stone-400' : 'text-stone-900' %>">
                  <%= txn.received? ? '+' : '-' %><%= number_to_currency(txn.amount) %>
                </td>
                <td>
                  <% if txn.superseded? %>
                    <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-warn"></span>Corrected</span>
                  <% elsif txn.voided? %>
                    <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-danger"></span>Voided</span>
                  <% elsif txn.superseded_transaction.present? %>
                    <span class="yn-status yn-status-sm"><span class="yn-dot"></span>Replacement</span>
                  <% else %>
                    <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-ok"></span>Active</span>
                  <% end %>
                </td>
                <td class="text-right whitespace-nowrap">
                  <%= link_to "View", security_deposit_transaction_path(txn), class: "yn-link text-[13px]" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="text-center py-6 text-stone-500">
                No deposit transactions recorded yet.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
