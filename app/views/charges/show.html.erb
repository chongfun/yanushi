<% content_for :title, "Charge ##{@charge.id}" %>

<% content_for :breadcrumbs do %>
  <li><%= link_to "Tenancies", tenancies_path %></li>
  <li><%= link_to "Tenancy ##{@tenancy.id}", @tenancy %></li>
  <li class="font-bold">Charge ##{@charge.id}</li>
<% end %>

<div class="max-w-3xl mx-auto py-8">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold">Charge Details</h1>
      <p class="text-base-content/60">Charge ID: #<%= @charge.id %> • Tenancy #<%= @tenancy.id %></p>
    </div>
    <div class="flex gap-2 items-center">
      <%= link_to "Back to Tenancy", @tenancy, class: "btn btn-ghost" %>
      <% if @charge.active? %>
        <%= button_to "Void Charge", void_charge_path(@charge), method: :post,
            class: "btn btn-error btn-outline",
            form: { data: { turbo_confirm: "Are you sure you want to void this charge? This will post a reversing journal entry to the ledger." } } %>
      <% end %>
    </div>
  </div>

  <% if @charge.superseded? %>
    <div class="alert alert-warning mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      <div>
        <div class="font-bold">Charge Corrected</div>
        <div class="text-xs">
          This charge was corrected on <%= @charge.voided_at&.strftime("%B %d, %Y") %>.
          <% if @charge.superseded_by %>
            Replaced by <%= link_to "Charge ##{@charge.superseded_by_id}", charge_path(@charge.superseded_by), class: "underline font-semibold" %>.
          <% end %>
        </div>
      </div>
    </div>
  <% elsif @charge.voided? %>
    <div class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <div class="font-bold">Charge Voided</div>
        <div class="text-xs">This charge was voided on <%= @charge.voided_at&.strftime("%B %d, %Y at %I:%M %p") %> and its accounting entries have been reversed.</div>
      </div>
    </div>
  <% end %>

  <% if @charge.superseded_charge.present? %>
    <div class="alert alert-info mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <div class="font-bold">Replacement Charge</div>
        <div class="text-xs">
          This charge is a correction replacement for <%= link_to "Charge ##{@charge.superseded_charge.id}", charge_path(@charge.superseded_charge), class: "underline font-semibold" %>.
        </div>
      </div>
    </div>
  <% end %>

  <div class="card bg-base-100 shadow-xl border border-base-200">
    <div class="card-body">
      <div class="flex flex-col md:flex-row justify-between gap-8">
        <div class="space-y-6 flex-1">
          <div>
            <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Amount</div>
            <div class="text-4xl font-bold font-mono <%= @charge.voided? ? 'line-through text-base-content/40' : 'text-error' %>">
              <%= number_to_currency(@charge.amount) %>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Charge Type</div>
              <div><span class="badge badge-outline font-medium uppercase"><%= @charge.charge_kind.titleize %></span></div>
            </div>
            <div>
              <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Status</div>
              <div>
                <% if @charge.superseded? %>
                  <span class="badge badge-warning">Corrected (Superseded)</span>
                <% elsif @charge.voided? %>
                  <span class="badge badge-error">Voided & Reversed</span>
                <% elsif @charge.posted? %>
                  <span class="badge badge-success">Posted</span>
                <% else %>
                  <span class="badge badge-ghost">Draft</span>
                <% end %>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Charge Date</div>
              <div class="text-lg font-medium"><%= @charge.charge_date.strftime("%B %d, %Y") %></div>
            </div>
            <div>
              <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Due Date</div>
              <div class="text-lg font-medium"><%= @charge.due_on.strftime("%B %d, %Y") %></div>
            </div>
          </div>

          <% if @charge.service_period_start && @charge.service_period_end %>
            <div>
              <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Service Period</div>
              <div class="text-base font-medium">
                <%= @charge.service_period_start.strftime("%B %d, %Y") %> – <%= @charge.service_period_end.strftime("%B %d, %Y") %>
              </div>
            </div>
          <% end %>

          <% if @charge.description.present? %>
            <div>
              <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Description</div>
              <div class="text-base"><%= @charge.description %></div>
            </div>
          <% end %>
        </div>

        <div class="divider md:divider-horizontal"></div>

        <div class="space-y-6 flex-1">
          <div>
            <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Property</div>
            <div class="text-lg font-bold"><%= @tenancy.property&.address %></div>
            <div class="text-sm text-base-content/60"><%= @tenancy.rentable_unit&.display_name %></div>
          </div>

          <div>
            <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Tenants</div>
            <div class="flex flex-wrap gap-1">
              <% @tenancy.parties.each do |party| %>
                <span class="badge badge-neutral badge-sm"><%= party.display_name %></span>
              <% end %>
            </div>
          </div>

          <% if @charge.posted_at %>
            <div>
              <div class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-1">Posted At</div>
              <div class="text-sm font-mono text-base-content/70"><%= @charge.posted_at.strftime("%Y-%m-%d %H:%M:%S UTC") %></div>
            </div>
          <% end %>

          <% if @charge.superseded? %>
            <div class="alert alert-warning py-3">
              <div>
                <div class="font-bold text-sm">Corrected on <%= @charge.voided_at&.strftime("%B %d, %Y") %></div>
                <div class="text-xs">
                  Replaced by <%= link_to "Charge ##{@charge.superseded_by_id}", charge_path(@charge.superseded_by), class: "underline font-semibold" %>.
                </div>
              </div>
            </div>
          <% elsif @charge.voided_at %>
            <div class="alert alert-error py-3">
              <div>
                <div class="font-bold text-sm">Voided on <%= @charge.voided_at.strftime("%B %d, %Y") %></div>
                <div class="text-xs">Reversed via journal entry in double-entry ledger.</div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
