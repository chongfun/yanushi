<% content_for :title, "Charge ##{@charge.id}" %>

<div class="max-w-3xl mx-auto py-6">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-stone-900">Charge Details</h1>
      <p class="text-sm text-stone-500">Charge ID: #<%= @charge.id %> • Tenancy #<%= @tenancy.id %></p>
    </div>
    <div class="flex gap-2 items-center">
      <%= link_to "Back to Tenancy", @tenancy, class: "yn-btn yn-btn-secondary yn-btn-sm" %>
      <% if @charge.active? %>
        <%= button_to "Void Charge", void_charge_path(@charge), method: :post,
            class: "yn-btn yn-btn-danger yn-btn-sm",
            form: { data: { turbo_confirm: "Are you sure you want to void this charge? This will post a reversing journal entry to the ledger." } } %>
      <% end %>
    </div>
  </div>

  <% if @charge.superseded? %>
    <div class="yn-alert yn-alert-warn mb-6" role="status">
      <div>
        <div class="font-bold text-sm">Charge Corrected</div>
        <div class="text-xs">
          This charge was corrected on <%= @charge.voided_at&.strftime("%B %d, %Y") %>.
          <% if @charge.superseded_by %>
            Replaced by <%= link_to "Charge ##{@charge.superseded_by_id}", charge_path(@charge.superseded_by), class: "yn-link font-semibold" %>.
          <% end %>
        </div>
      </div>
    </div>
  <% elsif @charge.voided? %>
    <div class="yn-alert yn-alert-danger mb-6" role="status">
      <div>
        <div class="font-bold text-sm">Charge Voided</div>
        <div class="text-xs">This charge was voided on <%= @charge.voided_at&.strftime("%B %d, %Y at %I:%M %p") %> and its accounting entries have been reversed.</div>
      </div>
    </div>
  <% end %>

  <% if @charge.superseded_charge.present? %>
    <div class="yn-alert mb-6" role="status">
      <div>
        <div class="font-bold text-sm">Replacement Charge</div>
        <div class="text-xs">
          This charge is a correction replacement for <%= link_to "Charge ##{@charge.superseded_charge.id}", charge_path(@charge.superseded_charge), class: "yn-link font-semibold" %>.
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white border border-stone-200 rounded-lg p-6">
    <div class="flex flex-col md:flex-row justify-between gap-8">
      <div class="space-y-6 flex-1">
        <div>
          <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Amount</div>
          <div class="text-3xl font-bold font-mono tabular-nums <%= @charge.voided? ? 'line-through text-stone-400' : 'text-stone-900' %>">
            <%= number_to_currency(@charge.amount) %>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Charge Type</div>
            <div class="text-sm font-medium uppercase font-mono"><%= @charge.charge_kind.titleize %></div>
          </div>
          <div>
            <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Status</div>
            <div>
              <% if @charge.superseded? %>
                <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-warn"></span>Corrected (Superseded)</span>
              <% elsif @charge.voided? %>
                <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-danger"></span>Voided & Reversed</span>
              <% elsif @charge.posted? %>
                <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-ok"></span>Posted</span>
              <% else %>
                <span class="yn-status yn-status-sm"><span class="yn-dot"></span>Draft</span>
              <% end %>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Charge Date</div>
            <div class="text-sm font-medium text-stone-900"><%= @charge.charge_date.strftime("%B %d, %Y") %></div>
          </div>
          <div>
            <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Due Date</div>
            <div class="text-sm font-medium text-stone-900"><%= @charge.due_on.strftime("%B %d, %Y") %></div>
          </div>
        </div>

        <% if @charge.service_period_start && @charge.service_period_end %>
          <div>
            <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Service Period</div>
            <div class="text-sm font-medium text-stone-900">
              <%= @charge.service_period_start.strftime("%B %d, %Y") %> – <%= @charge.service_period_end.strftime("%B %d, %Y") %>
            </div>
          </div>
        <% end %>

        <% if @charge.description.present? %>
          <div>
            <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Description</div>
            <div class="text-sm text-stone-700"><%= @charge.description %></div>
          </div>
        <% end %>
      </div>

      <div class="border-t md:border-t-0 md:border-l border-stone-200 pt-6 md:pt-0 md:pl-8 space-y-6 flex-1">
        <div>
          <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Property</div>
          <div class="text-base font-bold text-stone-900"><%= @tenancy.property&.address %></div>
          <div class="text-xs text-stone-500"><%= @tenancy.rentable_unit&.display_name %></div>
        </div>

        <div>
          <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Tenants</div>
          <div class="flex flex-wrap gap-1.5">
            <% @tenancy.parties.each do |party| %>
              <span class="text-xs text-stone-700 bg-stone-100 px-2 py-0.5 rounded border border-stone-200"><%= party.display_name %></span>
            <% end %>
          </div>
        </div>

        <% if @charge.posted_at %>
          <div>
            <div class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Posted At</div>
            <div class="text-xs font-mono text-stone-500"><%= @charge.posted_at.strftime("%Y-%m-%d %H:%M:%S UTC") %></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
