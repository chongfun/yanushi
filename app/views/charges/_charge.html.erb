<tr id="<%= dom_id charge %>" class="<%= 'opacity-60 bg-stone-50' if charge.voided? %>">
  <td>
    <div class="font-medium text-sm text-stone-900"><%= charge.charge_date.strftime("%b %d, %Y") %></div>
    <div class="text-xs text-stone-500">Due: <%= charge.due_on.strftime("%b %d, %Y") %></div>
  </td>
  <td>
    <span class="text-xs font-mono uppercase text-stone-600">
      <%= charge.charge_kind.titleize %>
    </span>
  </td>
  <td>
    <% if charge.service_period_start && charge.service_period_end %>
      <div class="text-xs font-mono text-stone-500">
        <%= charge.service_period_start.strftime("%b %d") %> – <%= charge.service_period_end.strftime("%b %d, %Y") %>
      </div>
    <% end %>
    <div class="text-xs text-stone-600 truncate max-w-xs"><%= charge.description %></div>
    <% if charge.superseded? && charge.superseded_by %>
      <div class="text-xs text-amber-700 mt-0.5">Replaced by <%= link_to "Charge ##{charge.superseded_by_id}", charge_path(charge.superseded_by), class: "yn-link" %></div>
    <% elsif charge.superseded_charge.present? %>
      <div class="text-xs text-indigo-700 mt-0.5">Replaces <%= link_to "Charge ##{charge.superseded_charge.id}", charge_path(charge.superseded_charge), class: "yn-link" %></div>
    <% end %>
  </td>
  <td class="font-mono text-right tabular-nums font-medium <%= charge.voided? ? 'line-through text-stone-400' : 'text-stone-900' %>">
    <%= number_to_currency(charge.amount) %>
  </td>
  <td>
    <% if charge.superseded? %>
      <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-warn"></span>Corrected</span>
    <% elsif charge.voided? %>
      <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-danger"></span>Voided</span>
    <% else %>
      <span class="yn-status yn-status-sm"><span class="yn-dot yn-dot-ok"></span>Active</span>
    <% end %>
  </td>
  <td class="text-right whitespace-nowrap">
    <div class="flex justify-end gap-1 items-center">
      <%= link_to "View", charge_path(charge), class: "yn-link text-[13px]" %>
      <% if charge.active? %>
        <%= button_to "Void", void_charge_path(charge), method: :post,
            class: "yn-btn yn-btn-danger yn-btn-sm",
            form: { data: { turbo_confirm: "Are you sure you want to void this charge?" } } %>
      <% end %>
    </div>
  </td>
</tr>
