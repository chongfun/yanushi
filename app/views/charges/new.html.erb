<% content_for :title, "Add charge" %>

<% if turbo_frame_request? %>
  <%# Dialog over the tenancy page %>
  <turbo-frame id="modal-frame">
    <%# Turbo swaps the frame's children, not its attributes, so the dialog title rides on this wrapper %>
    <div data-modal-title="Add charge">
      <%= render "charges/form", charge: @charge, tenancy: @tenancy, form_context: :dialog %>
    </div>
  </turbo-frame>
<% else %>
  <%# Standalone page for one tenancy %>
  <div class="max-w-xl">
    <%= render "tenancies/page_header", tenancy: @tenancy, title: "Add charge" %>
    <div class="yn-surface p-6">
      <%= render "charges/form", charge: @charge, tenancy: @tenancy, form_context: :standalone %>
    </div>
  </div>
<% end %>
