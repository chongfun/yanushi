# Prawn and prawn-table have no upstream RBS signatures.
# Covers the Document methods used by Receipts::ReceiptPdfService and
# Tenancies::StatementPdfService.
module Prawn
  class Document
    def self.new: (?Hash[Symbol, untyped] options) -> Document

    def text: (String text, **untyped options) -> untyped

    def move_down: (Integer | Float amount) -> untyped

    def render: () -> String

    def bounds: () -> untyped

    def stroke_color: (String color) -> untyped

    def stroke_horizontal_rule: () -> untyped

    def number_pages: (String string, ?Hash[Symbol, untyped] options) -> untyped

    # Added to Document by prawn-table.
    def table: (Array[Array[untyped]] data, ?Hash[Symbol, untyped] options) ?{ (untyped) -> void } -> untyped
  end
end
