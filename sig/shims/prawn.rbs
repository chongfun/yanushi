# prawn-table has no upstream RBS signatures (Prawn::Document core methods are
# provided by gem_rbs_collection's prawn 2.5 signatures).
# Covers the Document#table method used by Receipts::ReceiptPdfService and
# Tenancies::StatementPdfService.
module Prawn
  class Document
    # Added to Document by prawn-table.
    def table: (Array[Array[untyped]] data, ?Hash[Symbol, untyped] options) ?{ (untyped) -> void } -> untyped
  end
end
