module Accounting
  class PostingBuilder
    def self.call: (user: User, postings: Array[PostingSpec] | untyped) -> (Dry::Monads::Result::Success | Dry::Monads::Result::Failure)
    def initialize: (user: User, postings: Array[PostingSpec] | untyped) -> void
    def call: () -> (Dry::Monads::Result::Success | Dry::Monads::Result::Failure)

    private

    attr_reader user: User
    attr_reader postings: Array[PostingSpec]
  end
end
