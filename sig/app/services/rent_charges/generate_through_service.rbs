module RentCharges
  class GenerateThroughService
    def self.call: (tenancy: Tenancy, ?through: Date | String | untyped) -> (Dry::Monads::Result::Success | Dry::Monads::Result::Failure)
    def initialize: (tenancy: Tenancy, ?through: Date | String | untyped) -> void
    def call: () -> (Dry::Monads::Result::Success | Dry::Monads::Result::Failure)

    private

    attr_reader tenancy: Tenancy
    attr_reader through: Date
    def parse_date: (untyped val) -> Date?
  end
end
