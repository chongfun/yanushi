module SecurityDepositTransactions
  class VoidService
    def self.call: (transaction: SecurityDepositTransaction, ?reason: String?) -> (Dry::Monads::Result::Success | Dry::Monads::Result::Failure)
    def initialize: (transaction: SecurityDepositTransaction, ?reason: String?) -> void
    def call: () -> (Dry::Monads::Result::Success | Dry::Monads::Result::Failure)

    private
    attr_reader transaction: SecurityDepositTransaction
    attr_reader reason: String?
  end
end
