module Receipts
  class VoidService
    def self.call: (receipt: Receipt, ?reason: String?) -> (Dry::Monads::Result::Success | Dry::Monads::Result::Failure)

    def initialize: (receipt: Receipt, ?reason: String?) -> void

    def call: () -> (Dry::Monads::Result::Success | Dry::Monads::Result::Failure)

    private

    attr_reader receipt: Receipt
    attr_reader reason: String?
  end
end
