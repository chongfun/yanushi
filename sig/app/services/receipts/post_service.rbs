module Receipts
  class PostService
    def self.call: (receipt: Receipt) -> (Dry::Monads::Result::Success | Dry::Monads::Result::Failure)

    def initialize: (receipt: Receipt) -> void

    def call: () -> (Dry::Monads::Result::Success | Dry::Monads::Result::Failure)

    private

    attr_reader receipt: Receipt
    def default_description: () -> String
  end
end
