module Expenses
  class VoidService
    def self.call: (expense: Expense, ?user: User?) -> (Dry::Monads::Result::Success | Dry::Monads::Result::Failure)

    def initialize: (expense: Expense, ?user: User?) -> void
    def call: () -> (Dry::Monads::Result::Success | Dry::Monads::Result::Failure)

    private

    attr_reader expense: Expense
    attr_reader user: User?

    def success: (untyped data) -> Dry::Monads::Result::Success
    def failure: (String error, Symbol code) -> Dry::Monads::Result::Failure
  end
end
