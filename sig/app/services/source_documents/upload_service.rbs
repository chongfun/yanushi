module SourceDocuments
  class UploadService
    MAX_FILE_SIZE: Integer
    @user: User
    @pdf_param: untyped

    def self.call: (user: User, pdf_param: untyped) -> (Dry::Monads::Result::Success | Dry::Monads::Result::Failure)
    def initialize: (user: User, pdf_param: untyped) -> void
    def call: () -> (Dry::Monads::Result::Success | Dry::Monads::Result::Failure)

    private
    attr_reader user: User
    attr_reader pdf_param: untyped
    def existing_result: (SourceDocument existing) -> Dry::Monads::Result::Success
    def pdf?: () -> bool
    def success: (source_document: SourceDocument, upload_status: Symbol) -> Dry::Monads::Result::Success
    def failure: (String error, Symbol code) -> Dry::Monads::Result::Failure
  end
end
