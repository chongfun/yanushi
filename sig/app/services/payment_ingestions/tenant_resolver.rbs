module PaymentIngestions
  class TenantResolver
    class ResolveResult < Dry::Struct
      def self.matched: (party: Party, ?parties: Array[Party]) -> Dry::Monads::Result::Success

      def self.ambiguous: (?parties: Array[Party]) -> Dry::Monads::Result::Failure

      def self.unmatched: () -> Dry::Monads::Result::Failure

      def self.Success: (untyped value) -> Dry::Monads::Result::Success

      def self.Failure: (untyped value) -> Dry::Monads::Result::Failure

      def party: () -> Party?

      def parties: () -> Array[Party]

      def status: () -> Symbol
    end

    def resolve: (User user, String? display_name, String? username) -> Dry::Monads::Result

    private

    def find_candidates: (User user, String? display_name, String? username) -> Array[Party]
  end
end
