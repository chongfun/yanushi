class TenantPayment < ApplicationRecord
  def amount: () -> BigDecimal
  def amount=: (BigDecimal | Numeric | String | nil) -> untyped
  def accounting_user: () -> User?

  private

  def prevent_mutation_after_creation: () -> void
  def prevent_destroy: () -> void
  def assign_user_from_tenancy: () -> void
  def user_matches_tenancy_owner: () -> void
end
