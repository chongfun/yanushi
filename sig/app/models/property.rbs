class Property < ApplicationRecord
  ASSET_TYPES: Array[String]

  def postings: () -> Posting::ActiveRecord_Associations_CollectionProxy
  def financial_items: (*untyped, ?year: Integer?) -> Array[Accounting::ActivityRow]
  def active_years: (?Array[untyped]) -> Array[Integer]
  def accounting_activity: (?from: untyped, ?through: untyped, ?year: untyped) -> Array[Accounting::ActivityRow]
  def accounting_summary: (?from: untyped, ?through: untyped, ?year: untyped) -> Accounting::PropertySummaryQuery::SummaryResult
  def schedule_e_summary: (*untyped, ?year: Integer?) -> TaxReporting::ScheduleEResult
  def accounting_user: () -> User?
  def tax_profiles: () -> untyped
  def tax_review_resolutions: () -> untyped
  def tax_profile_for: (Integer | String) -> PropertyTaxProfile?
end
