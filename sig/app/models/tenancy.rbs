class Tenancy < ApplicationRecord
  AGREEMENT_TYPES: Array[String]

  def active?: (?Date date, ?as_of: untyped) -> bool
  def continuous_tenant_coverage?: (?untyped candidate_parties) -> bool
  def current_rent_term: (?Date date, ?as_of: untyped) -> RentTerm?
  def most_recent_rent_term: () -> RentTerm?
  def financial_history?: () -> bool
  def balance_cents: (?as_of: Date) -> Integer
  def current_balance_cents: () -> Integer
  def balance_as_of: (?Date date) -> BigDecimal
  def current_balance: () -> BigDecimal
  def accounting_user: () -> User?

  private

  def balance_query: () -> Tenancies::BalanceQuery
  def rentable_unit_is_active: () -> void
  def termination_date_after_commencement_date: () -> void
  def fixed_term_requires_termination_date: () -> void
  def no_overlapping_tenancies_on_same_unit: () -> void
end
