class Expense < ApplicationRecord
  EXPENSE_KINDS: Array[String]
  IMMUTABLE_POSTED_ATTRIBUTES: Array[String]

  attr_accessor raw_amount: String?
  def amount: () -> BigDecimal?
  def amount=: (untyped val) -> void
  def formatted_amount: () -> String?
  def amount_cents=: (Integer?) -> Integer?

  def reimbursed?: () -> bool
  def total_active_reimbursement_cents: () -> Integer
  def remaining_reimbursable_cents: () -> Integer
  def remaining_reimbursable_amount: () -> BigDecimal
  def fully_reimbursed?: () -> bool

  def posted?: () -> bool
  def active?: () -> bool
  def voided?: () -> bool
  def superseded?: () -> bool
  def lifecycle_status: () -> Symbol

  def accounting_user: () -> User?

  private

  def validate_rentable_unit_property_consistency: () -> void
  def validate_superseded_by_same_user: () -> void
  def prevent_mutation_after_posting: () -> void
  def prevent_destroy_if_posted: () -> void
end
