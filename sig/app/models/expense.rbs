class Expense < ApplicationRecord
  def reimbursed?: () -> bool
  def reimbursement_charge: () -> Charge?
  def total_active_reimbursement_cents: () -> Integer
  def remaining_reimbursable_cents: () -> Integer
  def remaining_reimbursable_amount: () -> BigDecimal
  def fully_reimbursed?: () -> bool

  def raw_reimburse_amount: () -> (String | BigDecimal | nil)

  def tenant_reimbursable: () -> bool?

  def reimburse_tenancy_id: () -> (Integer | String)?
  def reimburse_tenancy_id=: (untyped val) -> void
  def reimburse_lease_id: () -> (Integer | String)?
  def reimburse_lease_id=: (untyped val) -> void

  def reimburse_amount: () -> (BigDecimal | String)
  def accounting_user: () -> User?

  private

  def prevent_property_change_with_charges: () -> void
  def prevent_amount_reduction_below_reimbursements: () -> void
end
