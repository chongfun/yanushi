class SecurityDepositsController < ApplicationController
  @tenancy: Tenancy
  @security_deposit: SecurityDeposit
  @transactions: untyped
  @parties: untyped
  @active_charges: untyped
  @held_cents: Integer
  @remaining_required_cents: Integer
  @funding_status: String
  @balance_cents: Integer
  @failed_action: Symbol?
  @failed_error: String?

  def show: () -> void
  def new: () -> void
  def create: () -> void
  def edit: () -> void
  def update: () -> void
  def receive: () -> void
  def refund: () -> void
  def apply: () -> void

  private
  def load_show_data: () -> void
  def render_deposit_action_failure: (Symbol action, String error) -> void
  def set_tenancy: () -> void
  def set_security_deposit: () -> void
  def security_deposit_params: () -> ActionController::Parameters
end
