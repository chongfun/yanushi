  @tenancy_parties_map: Hash[Integer, Array[Integer]]

  def index: () -> untyped

  def new: () -> untyped

  def create: () -> untyped

  def show: () -> untyped

  def update: () -> untyped

  def confirm: () -> untyped

  def download: () -> untyped

  def destroy: () -> untyped

