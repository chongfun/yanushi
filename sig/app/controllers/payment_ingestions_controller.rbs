  @failed_documents: Array[PaymentDocument] | PaymentDocument::ActiveRecord_Relation | untyped
  @ingestion: PaymentIngestion
  @parties: Array[Party] | Party::ActiveRecord_Relation | untyped
  @tenancies: Array[Tenancy] | Tenancy::ActiveRecord_Relation | untyped
