module TaxReporting
  class ScheduleEQuery
    def self.call: (property: Property?, ?tax_year: Integer | String | nil) -> ScheduleEResult
    def initialize: (property: Property?, ?tax_year: Integer | String | nil) -> void
    def call: () -> ScheduleEResult

    private

    attr_reader property: Property?
    attr_reader tax_year: Integer

    def load_resolutions: () -> Hash[Integer, PropertyTaxReviewResolution]
    def start_date: () -> Date
    def end_date: () -> Date
    def load_period_postings: () -> Posting::ActiveRecord_Relation
    def calculate_rents_received: (untyped, ?Hash[Integer, PropertyTaxReviewResolution]) -> [Integer, Array[ScheduleEResult::IncomeDrilldownItem]]
    def extract_review_item_amount: (JournalEntry, untyped) -> Integer
    def calculate_expenses: (untyped, ?Hash[Integer, PropertyTaxReviewResolution]) -> [Hash[Symbol, Integer], Integer, Array[ScheduleEResult::OtherExpenseDetail], Hash[Symbol, Array[ScheduleEResult::ExpenseDrilldownItem]], Array[ScheduleEResult::TaxReviewItem]]
    def collect_review_items: (untyped, ?Array[ScheduleEResult::TaxReviewItem], ?Hash[Integer, PropertyTaxReviewResolution]) -> Array[ScheduleEResult::TaxReviewItem]
    def empty_result: () -> ScheduleEResult
  end
end
