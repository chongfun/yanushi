module Dashboards
  class AttentionQuery

    class AttentionItem
      attr_reader kind: Symbol
      attr_reader title: String
      attr_reader description: String
      attr_reader path: String
      attr_reader severity: Symbol

      def initialize: (
        kind: Symbol,
        title: String,
        description: String,
        path: String,
        severity: Symbol
      ) -> void
    end

    @user: User?
    @tenancies: untyped
    @balances: untyped

    def self.call: (user: User?, ?tenancies: untyped, ?balances: untyped) -> Array[AttentionItem]
    def initialize: (user: User?, ?tenancies: untyped, ?balances: untyped) -> void
    def call: () -> Array[AttentionItem]

    private

    def user: () -> User?
    def tenancies: () -> untyped
    def balances: () -> untyped
    def inbox_review_items: () -> Array[AttentionItem]
    def import_failed_items: () -> Array[AttentionItem]
    def overdue_balance_items: () -> Array[AttentionItem]
    def schedule_e_items: () -> Array[AttentionItem]
    def schedule_e_summary: (User u, Integer year) -> Hash[Symbol, Integer]
  def schedule_e_cache_key: (User u, Integer year) -> Array[untyped]
  def stamp: (untyped time) -> String?
  def filing_tax_year: (User u) -> Integer?
  end
end
